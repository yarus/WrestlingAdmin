<UserControl x:Class="Wrestling.UI.Material.Tournament.Standing.Draw.DrawView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Material.Utils.Converters"
             xmlns:converters1="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:BracketCellLineHeightConverter x:Key="BracketCellHeight" />
        <converters:BracketCellLeftLineVisConverter x:Key="LeftLineVis" />
        <converters:BracketColumnTopMarginConverter x:Key="BracketColTopMargin"  />
        <converters:BracketRoundVertLineVisibilityConverter x:Key="VertVis"  />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters1:IndexItemsConverter x:Key="ItemsIndexConverter" />

        <converters1:ValueConverterGroup x:Key="InvBoolToVis">
            <converters1:BoolInverterConverter />
            <converters1:GroupedBoolToVisConverter />
        </converters1:ValueConverterGroup>
    </UserControl.Resources>

    <Grid x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="1" Margin="20,0,20,0" FontSize="16" VerticalAlignment="Center">
                <Run Text="Групп:" />
                <Run Text="{Binding GroupsCount, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Grid.Row="0" Grid.Column="2" Margin="20,0,20,0" FontSize="16" VerticalAlignment="Center">
                <Run Text="Допущено Участников:" />
                <Run Text="{Binding WrestlersCount, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Grid.Row="0" Grid.Column="3" Margin="20,0,20,0" FontSize="16" VerticalAlignment="Center">
                <Run Text="Схваток:" />
                <Run Text="{Binding MatchesCount, Mode=OneWay}" />
            </TextBlock>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Margin="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander x:Name="GroupControl" Background="LightGray" Margin="0" Padding="0">
                            <Expander.Header>
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" TextWrapping="NoWrap" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource ItemsIndexConverter}" ConverterParameter="1">
                                                <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}" />
                                                <Binding Path="."/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1" TextWrapping="NoWrap" FontSize="16" VerticalAlignment="Center" Margin="20,0,0,0" Text="{Binding Name}" />

                                    <TextBlock Grid.Column="2" TextWrapping="Wrap" FontSize="16" VerticalAlignment="Center" Margin="20,0,0,0" Text="{Binding Path=Bracket.BracketTypeLabel}" />

                                    <StackPanel Grid.Row="0" Grid.Column="3" Visibility="{Binding Path=IsBracketGenerated, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Удалить сетку"
                                                HorizontalAlignment="Right" Margin="5,0,5,0"
                                                Command="{Binding Path=DataContext.RemoveBracketCommand, ElementName=RootControl}"
                                                CommandParameter="{Binding }" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="3" Visibility="{Binding Path=IsBracketGenerated, Converter={StaticResource InvBoolToVis}}">
                                        <Button Content="Создать сетку"
                                                HorizontalAlignment="Right" Margin="5,0,5,0"
                                                Command="{Binding Path=DataContext.GenerateBracketCommand, ElementName=RootControl}"
                                                CommandParameter="{Binding }" />
                                    </StackPanel>

                                    <Grid Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,20,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="1" Foreground="Green" Width="32" Height="32" Margin="0" Padding="0" 
                                                                 ToolTip="Жеребьевка проведена успешно." Kind="CheckboxMarkedOutline" 
                                                                 Visibility="{Binding Path=IsBracketGenerated, Converter={StaticResource BoolToVis}}" />
                                        <materialDesign:PackIcon Grid.Column="1" Foreground="DarkRed" Width="32" Height="32" Margin="0" Padding="0" 
                                                                 ToolTip="Жеребьевка не проведена." Kind="CloseBoxOutline" Visibility="{Binding Path=IsBracketGenerated, Converter={StaticResource InvBoolToVis}}" />
                                    </Grid>
                                </Grid>
                            </Expander.Header>
                            <Expander.Content>
                                <Grid Background="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Width="5" VerticalAlignment="Stretch" HorizontalAlignment="Center"></GridSplitter>
                                    
                                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}"></Border>
                                    <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource MaterialDesignDivider}"></Border>
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="NoWrap" Text="Посев"
                                               FontSize="18" TextAlignment="Center" FontWeight="Normal" Margin="10" />

                                    <TextBlock Grid.Row="0" Grid.Column="2" TextWrapping="NoWrap" Text="Результаты Жеребьевки"
                                               FontSize="18" TextAlignment="Center" FontWeight="Normal" Margin="10" />
                                    
                                    <ListView Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Path=Wrestlers}">
                                        <ListView.View>
                                            <GridView AllowsColumnReorder="true">
                                                <GridViewColumn Width="Auto" Header="Фикс.">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSeedFixed}" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Width="Auto" Header="Посев">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding SeedNumber}" Margin="0" MinWidth="20" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="ФИО" Width="Auto">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding FullNameShort}" Margin="0,5,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="Команда" Width="Auto">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding TeamName}" Margin="0,5,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="Г.р." Width="Auto">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding BirthDate, StringFormat={}{0:d}}" Margin="0,5,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                            </GridView>

                                        </ListView.View>
                                    </ListView>

                                    <Viewbox Grid.Row="1" Grid.Column="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <Grid Margin="0,0,10,0">
                                            <ItemsControl ItemsSource="{Binding Path=Bracket.Rounds}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0">
                                                        <TextBlock x:Name="RoundLabel" Text="{Binding RoundName}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Margin>
                                                                <MultiBinding Converter="{StaticResource BracketColTopMargin}">
                                                                    <Binding Path="." />
                                                                    <Binding Path="DataContext" ElementName="GroupControl" />
                                                                </MultiBinding>
                                                            </TextBlock.Margin>
                                                        </TextBlock>

                                                        <ItemsControl ItemsSource="{Binding RoundMatches}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Vertical" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="40" />
                                                                            <RowDefinition>
                                                                                <RowDefinition.Height>
                                                                                    <MultiBinding Converter="{StaticResource BracketCellHeight}">
                                                                                        <Binding Path="." />
                                                                                        <Binding Path="DataContext" ElementName="GroupControl" />
                                                                                    </MultiBinding>
                                                                                </RowDefinition.Height>
                                                                            </RowDefinition>
                                                                        </Grid.RowDefinitions>

                                                                        <Grid Grid.Row="0">

                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition />
                                                                                <RowDefinition />
                                                                            </Grid.RowDefinitions>

                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="20" />
                                                                                <ColumnDefinition Width="30" />
                                                                                <ColumnDefinition Width="1*" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,1">

                                                                                <Border.Visibility>
                                                                                    <MultiBinding Converter="{StaticResource LeftLineVis}">
                                                                                        <Binding Path="." />
                                                                                        <Binding Path="DataContext" ElementName="GroupControl" />
                                                                                    </MultiBinding>
                                                                                </Border.Visibility>

                                                                            </Border>

                                                                            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" BorderBrush="Black" BorderThickness="1" />
                                                                            <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,0,1" />
                                                                            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BorderBrush="Black" BorderThickness="0,0,1,0" />

                                                                            <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" FontSize="14" Text="{Binding BracketFullNumber, Mode=OneWay}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                                            <TextBlock Grid.Row="0" Grid.Column="2" FontSize="14" Text="{Binding WrestlerInRed.LastFirstName, Mode=OneWay}"
                                                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                       MinWidth="60" Margin="5,0,5,0" />

                                                                            <TextBlock Grid.Row="1" Grid.Column="2" FontSize="14" Text="{Binding WrestlerInBlue.LastFirstName, Mode=OneWay}"
                                                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                       MinWidth="60" Margin="5,0,5,0" />
                                                                        </Grid>

                                                                        <Grid Row="1">

                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="1*" />
                                                                                <RowDefinition Height="1*" />
                                                                            </Grid.RowDefinitions>

                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="2*" />
                                                                                <ColumnDefinition Width="1*" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                                                                                <Border.Visibility>
                                                                                    <MultiBinding Converter="{StaticResource VertVis}">
                                                                                        <Binding Path="." />
                                                                                        <Binding Path="DataContext" ElementName="RoundLabel" />
                                                                                        <Binding Path="DataContext" ElementName="GroupControl" />
                                                                                    </MultiBinding>
                                                                                </Border.Visibility>
                                                                            </Border>
                                                                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1">
                                                                                <Border.Visibility>
                                                                                    <MultiBinding Converter="{StaticResource VertVis}">
                                                                                        <Binding Path="." />
                                                                                        <Binding Path="DataContext" ElementName="RoundLabel" />
                                                                                        <Binding Path="DataContext" ElementName="GroupControl" />
                                                                                    </MultiBinding>
                                                                                </Border.Visibility>
                                                                            </Border>

                                                                        </Grid>
                                                                    </Grid>

                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                            </Expander.Content>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>