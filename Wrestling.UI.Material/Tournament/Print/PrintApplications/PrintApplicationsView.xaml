<UserControl x:Class="Wrestling.UI.Material.Tournament.Print.PrintApplications.PrintApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Wrestling.UI.Material.Utils.Converters"
             xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
             mc:Ignorable="d" Foreground="Black" Background="LightGray"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:OptionalImagePathConverter x:Key="OptionalImage" />
        <converters:FullNameToShortConverter x:Key="ShortName" />

        <!-- Tight column-header style: collapse Material Design's default padding
             so a 6-char "Разряд" actually fits inside a 60-DIP column. The default
             style added ~12 DIP padding on each side which clipped narrow headers
             into invisible width. Mirrors the pattern used in PrintPersonalResultsView. -->
        <Style x:Key="CompactColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Padding" Value="2,0,2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel Background="White">
        <TextBlock Text="{Binding Tournament.Name}"
                   TextWrapping="Wrap" Foreground="Black"
                   FontSize="32" TextAlignment="Center" FontWeight="Normal" />

        <Grid Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" TextWrapping="NoWrap" Foreground="Black"
                       Text="{Binding Tournament.StartDate, StringFormat={}{0:d}}" FontSize="16" TextAlignment="Left"
                       FontWeight="Normal" />

            <TextBlock Grid.Row="0" Grid.Column="1"
                       TextWrapping="NoWrap" Foreground="Black" Text="{Binding Path=Tournament.City}"
                       FontSize="16" TextAlignment="Right" FontWeight="Normal" />

        </Grid>

        <TextBlock
            TextWrapping="NoWrap" Foreground="Black" Text="{loc:Loc PrintApplications_Title}"
            FontSize="36" TextAlignment="Center" FontWeight="Normal" Margin="10,10,10,0" />

        <TextBlock
                   TextWrapping="NoWrap" Foreground="Black" Text="{Binding SelectedGroup.Name}"
                   FontSize="36" TextAlignment="Center" FontWeight="Normal" Margin="10,5,10,0" />

        <Border BorderBrush="Black" BorderThickness="0,1,0,0" />

        <Grid Margin="0">
            <ListView ItemsSource="{Binding Path=GroupWrestlers}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="False">
                <ListView.View>
                    <GridView AllowsColumnReorder="false" ColumnHeaderContainerStyle="{StaticResource CompactColumnHeader}">
                        <GridViewColumn Header="№" Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SeedNumber}" Margin="0,8,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Personal_Column_LastFirstName}" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AthleteName}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Applications_Column_BirthYear}" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BirthYear}" Margin="0,8,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Draw_Column_Team}" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TeamName}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Draw_Column_City}" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TeamCity}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Applications_Column_Level}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Level}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Applications_Column_Weight}" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Weight}" Margin="0,8,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <Grid Margin="0,30,0,10">
            <!-- Inner Grid sizes by text rows only — image is a sibling and
                 doesn't expand row heights. VerticalAlignment="Center" centers
                 the text rows within the outer Grid's height (determined by
                 the taller stamp image), so the stamp midline lands between
                 the judge and secretary rows instead of below them. Mirrors
                 the pattern in PrintBracketView. -->
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0"
                           TextWrapping="NoWrap" Foreground="Black" Text="{loc:Loc Details_Judge_Header}"
                           FontSize="16" TextAlignment="Left" FontWeight="Normal" Margin="10,10,10,0" />

                <TextBlock Grid.Column="2" Grid.Row="0"
                           TextWrapping="NoWrap" Foreground="Black"
                           Text="{Binding Path=Tournament.MainJudge, Converter={StaticResource ShortName}}"
                           FontSize="16" TextAlignment="Right" FontWeight="Normal" Margin="10,10,10,0" MinWidth="100" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           TextWrapping="NoWrap" Foreground="Black" Text="{loc:Loc Details_Secretary_Header}"
                           FontSize="16" TextAlignment="Left" FontWeight="Normal" Margin="10,30,10,0" />

                <TextBlock Grid.Row="1" Grid.Column="2"
                           TextWrapping="NoWrap" Foreground="Black"
                           Text="{Binding Path=Tournament.MainSecretary, Converter={StaticResource ShortName}}"
                           FontSize="16" TextAlignment="Right" FontWeight="Normal" Margin="10,30,10,0" MinWidth="100" />
            </Grid>

            <!-- Signature/stamp image overlays the inner Grid as a sibling; if
                 SignatureFooterImagePath is empty, OptionalImage converter
                 returns null and nothing is drawn. -->
            <Image Source="{Binding Path=Tournament.Settings.SignatureFooterImagePath, Converter={StaticResource OptionalImage}}"
                   Stretch="Uniform"
                   Height="150"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,30,0,0"
                   IsHitTestVisible="False" />
        </Grid>

    </StackPanel>
</UserControl>
