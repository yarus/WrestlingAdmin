<UserControl x:Class="Wrestling.UI.Material.Match.MatchActivityDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             Width="440">
    <StackPanel Margin="24" KeyboardNavigation.TabNavigation="Cycle">
        <TextBlock Text="{loc:Loc MatchActivity_ConfirmTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{loc:Loc MatchActivity_Cancel}" IsCancel="True" IsDefault="True" Margin="0,0,12,0"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                <Button.CommandParameter><system:Boolean>False</system:Boolean></Button.CommandParameter>
            </Button>
            <Button Content="{loc:Loc MatchActivity_Open}" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                <Button.CommandParameter><system:Boolean>True</system:Boolean></Button.CommandParameter>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
