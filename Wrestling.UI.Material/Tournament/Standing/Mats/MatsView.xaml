<UserControl x:Class="Wrestling.UI.Material.Tournament.Standing.Mats.MatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Wrestling.UI.Material.Tournament.Standing.Mats"
             xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <local:GroupBlockedByCompletedBoolConverter x:Key="GroupBlockedBool" />

        <!-- Stretch row content to full width (so the * name column expands)
             and keep rows compact. Used by the Mats/Parts tables, which use
             a Grid ItemTemplate instead of GridView so the action buttons
             never get clipped in the narrow left column. -->
        <Style x:Key="RowItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,4,4,4" />
            <!-- Rows aren't actionable as a whole (only the per-row buttons
                 are), so strip selection/hover chrome and focusability — a
                 selected highlight would just be visual noise. -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Per-(Part, Mat) panel — shared by the multi-part TabControl
             content and the single-part inline rendering. DataContext at
             this scope = MatsPartMatPanelVm. -->
        <DataTemplate x:Key="MatPanelDataTemplate">
            <materialDesign:Card Margin="0,4,0,4" UniformCornerRadius="4"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <Expander Background="Transparent" BorderThickness="0" Padding="0"
                          IsExpanded="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Mat.Name}"
                                       FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Margin="12,0,12,0" VerticalAlignment="Center"
                                        ToolTip="{loc:Loc Mats_WrestlersCount_Tooltip}">
                                <materialDesign:PackIcon Kind="AccountMultiple" Width="18" Height="18"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                <TextBlock Text="{Binding WrestlersCount, Mode=OneWay}"
                                           FontSize="14" VerticalAlignment="Center"
                                           Width="30" Margin="6,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        Margin="0,0,12,0" VerticalAlignment="Center"
                                        ToolTip="{loc:Loc Mats_MatchesCount_Tooltip}">
                                <materialDesign:PackIcon Kind="Wrestling" Width="18" Height="18"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                <TextBlock Text="{Binding MatchesCount, Mode=OneWay}"
                                           FontSize="14" VerticalAlignment="Center"
                                           Width="30" Margin="6,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                        Margin="0,0,12,0" VerticalAlignment="Center"
                                        ToolTip="{loc:Loc Mats_ExpectedDuration_Tooltip}">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                <TextBlock Text="{Binding ExpectedDurationLabel, Mode=OneWay}"
                                           FontSize="14" VerticalAlignment="Center"
                                           Width="56" Margin="6,0,0,0" />
                            </StackPanel>

                            <Button Grid.Column="4" Content="{loc:Loc Mats_AddGroup}"
                                    ToolTip="{loc:Loc Mats_AddGroup_Tooltip}"
                                    Margin="8,0,16,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Click="OnAddGroupForPartMatClick" />
                        </Grid>
                    </Expander.Header>

                    <!-- Groups table — Grid rows (not GridView) so the action
                         buttons never clip in a narrow column. Name column sizes
                         to content (SharedSizeGroup keeps header + rows aligned);
                         a trailing * spacer absorbs extra width on wide screens
                         so the stats + buttons hug the name instead of drifting
                         to the right edge. -->
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <!-- Column headers -->
                        <Grid Margin="8,4,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GroupName" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc Details_Groups_Column_Name}"
                                       FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <TextBlock Grid.Column="1" Text="{loc:Loc Mats_Column_Wrestlers}"
                                       FontSize="13" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <TextBlock Grid.Column="2" Text="{loc:Loc Mats_Column_Matches}"
                                       FontSize="13" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                        <Grid Margin="8,3,8,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="GroupName" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Path=Wrestlers.Count, Mode=OneWay}"
                                                       FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Path=PendingMatchesCount, Mode=OneWay}"
                                                       FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Button ToolTip="{loc:Loc Mats_MoveUp_Tooltip}"
                                                        Margin="0" Padding="0" Width="28" Height="28"
                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                        Command="{Binding ElementName=RootControl, Path=DataContext.UpGroupCommand}"
                                                        CommandParameter="{Binding }">
                                                    <materialDesign:PackIcon Kind="ArrowUp" Width="16" Height="16" Margin="0" Padding="0" />
                                                </Button>
                                                <Button ToolTip="{loc:Loc Mats_MoveDown_Tooltip}"
                                                        Margin="4,0,0,0" Padding="0" Width="28" Height="28"
                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                        Command="{Binding ElementName=RootControl, Path=DataContext.DownGroupCommand}"
                                                        CommandParameter="{Binding }">
                                                    <materialDesign:PackIcon Kind="ArrowDown" Width="16" Height="16" Margin="0" Padding="0" />
                                                </Button>

                                                <Button Margin="4,0,0,0" Padding="0" Width="28" Height="28"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Visibility="{Binding ElementName=RootControl, Path=DataContext.HasMultipleParts, Converter={StaticResource BoolToVis}}"
                                                        Click="OnMoveToPartTriggerClick">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource MaterialDesignFloatingActionMiniButton}">
                                                            <Setter Property="ToolTip" Value="{loc:Loc Mats_MoveToPart_Tooltip}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Converter={StaticResource GroupBlockedBool}}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                    <Setter Property="ToolTip" Value="{loc:Loc Mats_MoveToPart_BlockedByCompleted_Notice}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <materialDesign:PackIcon Kind="SwapHorizontal" Width="16" Height="16" Margin="0" Padding="0" />
                                                </Button>

                                                <Button ToolTip="{loc:Loc Mats_UnbindGroup_Tooltip}"
                                                        Margin="4,0,0,0" Padding="0" Width="28" Height="28"
                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                        Command="{Binding ElementName=RootControl, Path=DataContext.UnbindGroupCommand}"
                                                        CommandParameter="{Binding }">
                                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0" Padding="0" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </materialDesign:Card>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Two-column master/detail: left third = structure (Mats over Parts),
         right two-thirds = group distribution. Each side scrolls on its own;
         the distribution scrollbar lands at the window's right edge. -->
    <Grid x:Name="RootControl" Margin="16,12,16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT — structure tables stacked: Mats on top, Parts below. -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Mats table -->
            <materialDesign:Card Grid.Row="0" Padding="12" UniformCornerRadius="4"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left"
                            Content="{loc:Loc Mats_Add}" ToolTip="{loc:Loc Mats_Add_Tooltip}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,0,8"
                            Command="{Binding AddMatCommand}" />
                    <ListView ItemsSource="{Binding Items}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False"
                              HorizontalContentAlignment="Stretch"
                              ItemContainerStyle="{StaticResource RowItemStyle}"
                              TextElement.FontSize="15">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,4,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button ToolTip="{loc:Loc Mats_Edit_Tooltip}"
                                                Margin="0" Padding="0" Width="28" Height="28"
                                                Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                Command="{Binding ElementName=RootControl, Path=DataContext.EditMatCommand}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="BorderColor" Width="16" Height="16" Margin="0" Padding="0" />
                                        </Button>
                                        <Button ToolTip="{loc:Loc Mats_Delete_Tooltip}"
                                                Margin="4,0,0,0" Padding="0" Width="28" Height="28"
                                                Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                Command="{Binding ElementName=RootControl, Path=DataContext.DeleteMatCommand}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0" Padding="0" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </materialDesign:Card>

            <!-- Parts table -->
            <materialDesign:Card Grid.Row="2" Padding="12" UniformCornerRadius="4"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left"
                            Content="{loc:Loc Mats_AddPart}" ToolTip="{loc:Loc Mats_AddPart_Tooltip}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,0,8"
                            Command="{Binding AddPartCommand}" />
                    <ListView ItemsSource="{Binding Parts}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False"
                              HorizontalContentAlignment="Stretch"
                              ItemContainerStyle="{StaticResource RowItemStyle}"
                              TextElement.FontSize="15">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,4,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button ToolTip="{loc:Loc Mats_Part_Rename_Tooltip}"
                                                Margin="0" Padding="0" Width="28" Height="28"
                                                Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                Command="{Binding ElementName=RootControl, Path=DataContext.RenamePartCommand}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0" Padding="0" />
                                        </Button>
                                        <Button ToolTip="{loc:Loc Mats_Part_Delete_Tooltip}"
                                                Margin="4,0,0,0" Padding="0" Width="28" Height="28"
                                                Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                Command="{Binding ElementName=RootControl, Path=DataContext.DeletePartCommand}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0" Padding="0" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
        </ScrollViewer>

        <!-- RIGHT — group distribution. Tab strip (hidden when ≤1 part) flips
             SelectedPart; below it is the list of mat panels for the
             currently selected part. Each mat panel = stats header + groups
             grid with ↑/↓/⇆/✕ on each row. The panels live in an inner
             ScrollViewer so this column scrolls independently of the left. -->
        <materialDesign:Card Grid.Column="2" Padding="12" UniformCornerRadius="4"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <DockPanel LastChildFill="True">
                <!-- Section header: title left, orphan-groups counter right. -->
                <Grid DockPanel.Dock="Top" Margin="4,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center"
                               Text="{loc:Loc Mats_Distribution_Header}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center"
                                ToolTip="{loc:Loc Mats_UnboundGroups_Tooltip}">
                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        <TextBlock Text="{Binding UnbindedGroups, Mode=OneWay}"
                                   FontSize="14" VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                <!-- Multi-part: native TabControl with underline indicator
                     per MD3. Each tab's content rebinds to the same VM-side
                     CurrentPartMatPanels list (which the VM rebuilds on
                     SelectedPart change). -->
                <!-- Selector-only tab strip (empty content). The panels are
                     rendered by the single always-present ItemsControl below
                     — NOT inside TabControl.ContentTemplate. Rebuilding the
                     panel tree inside ContentTemplate on the single→multi
                     transition left FAB PackIcons unrendered until a later
                     layout pass; a single, always-alive ItemsControl avoids
                     that. Hidden when only one part exists. -->
                <TabControl ItemsSource="{Binding Parts}"
                            SelectedItem="{Binding SelectedPart, Mode=TwoWay}"
                            Visibility="{Binding HasMultipleParts, Converter={StaticResource BoolToVis}}"
                            BorderThickness="0" Background="Transparent" Padding="0">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate />
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- Mat panels for the selected part — single instance used in
                     both single- and multi-part modes. -->
                <ItemsControl Margin="0,8,0,0"
                              ItemsSource="{Binding CurrentPartMatPanels}"
                              ItemTemplate="{StaticResource MatPanelDataTemplate}" />

                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </materialDesign:Card>
    </Grid>

</UserControl>
