<UserControl x:Class="Wrestling.UI.Material.Tournament.Results.CompletedMatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:converters1="clr-namespace:Wrestling.UI.Material.Utils.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="400" d:DesignWidth="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:IndexItemsConverter x:Key="ItemsIndexConverter" />
        <converters1:WinTypeToStringConverter x:Key="WinTypeToStringConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" materialDesign:RippleAssist.IsCentered="True">
                <Grid Margin="20,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <Border BorderThickness="1" Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="DarkGray"></Border>

                    <Button Grid.Column="0" Style="{DynamicResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="Magnify" Opacity=".56" />
                    </Button>
                    
                    <TextBox Grid.Column="1" Margin="8 0 0 0" materialDesign:HintAssist.Hint="Поиск по фамилии"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden" BorderThickness="0"
                             MinWidth="200" VerticalAlignment="Center" Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged, Delay=1000}" />
                </Grid>
                <Button Style="{DynamicResource MaterialDesignToolForegroundButton}" Margin="8 0 0 0" Panel.ZIndex="0">
                    <materialDesign:PackIcon Kind="Send" />
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="2" Margin="20,0,20,0" FontSize="16" VerticalAlignment="Center">
                <Run Text="Ковров:" />
                <Run Text="{Binding CarpetsCount, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Grid.Row="0" Grid.Column="3" Margin="20,0,20,0" FontSize="16" VerticalAlignment="Center">
                <Run Text="Поединков:" />
                <Run Text="{Binding MatchesCount, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Grid.Row="0" Grid.Column="4" Margin="20,0,20,0" FontSize="16" VerticalAlignment="Center">
                <Run Text="Завершено:" />
                <Run Text="{Binding CompletedMatchesCount, Mode=OneWay}" />
            </TextBlock>
        </Grid>
    
        <ScrollViewer Grid.Row="1" Margin="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl ItemsSource="{Binding Stats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Margin="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Background="{DynamicResource MaterialDesignToolBarBackground}" Margin="0" Padding="0" IsExpanded="{Binding IsExpanded}">
                                <Expander.Header>
                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" TextWrapping="NoWrap" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource ItemsIndexConverter}" ConverterParameter="1">
                                                    <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}" />
                                                    <Binding Path="."/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1" TextWrapping="NoWrap" FontSize="16" Margin="20,0,20,0" VerticalAlignment="Center">
                                            <Run Text="{Binding CarpetLabel}"></Run>
                                        </TextBlock>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="20,0,20,0" FontSize="16" VerticalAlignment="Center">
                                            <Run Text="Участников:" />
                                            <Run Text="{Binding WrestlersCount, Mode=OneWay}" />
                                        </TextBlock>

                                        <TextBlock Grid.Row="0" Grid.Column="3" Margin="20,0,20,0" FontSize="16" VerticalAlignment="Center">
                                            <Run Text="Завершено:" />
                                            <Run Text="{Binding CompletedMatchesCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </Expander.Header>
                                <Expander.Content>
                                    <StackPanel Background="{DynamicResource MaterialDesignPaper}" Margin="0">
                                        <ListView ItemsSource="{Binding Matches}" Margin="40,0,0,0" x:Name="MatchesSource">
                                            <ListView.View>
                                                <GridView AllowsColumnReorder="true">
                                                    <GridViewColumn Header="#" Width="Auto">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding MatchNumber}" Margin="0,20,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>

                                                    <GridViewColumn Header="Группа/Стадия" Width="Auto">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding GroupName}" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                                                                    <TextBlock Text="{Binding RoundName}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>

                                                    <GridViewColumn Header="Спортсмены" Width="Auto">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                                        <materialDesign:PackIcon Foreground="DarkRed" Width="20" Height="20" Margin="0" Padding="0" ToolTip="Спортсмен в красном трико" Kind="CheckboxBlank" />
                                                                        <TextBlock Text="{Binding WrestlerInRed.LastFirstName}" Margin="0" TextWrapping="Wrap" FontSize="14" HorizontalAlignment="Left" />
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                                        <materialDesign:PackIcon Foreground="Blue" Width="20" Height="20" Margin="0" Padding="0" ToolTip="Спортсмен в синем трико." Kind="CheckboxBlank" />
                                                                        <TextBlock Text="{Binding WrestlerInBlue.LastFirstName}" Margin="0" TextWrapping="Wrap" FontSize="14" HorizontalAlignment="Left" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>

                                                    <GridViewColumn Header="Команды" Width="Auto">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding WrestlerInRed.TeamName}" Margin="0,5,0,0" TextWrapping="NoWrap" FontSize="14" HorizontalAlignment="Left" />
                                                                    <TextBlock Text="{Binding WrestlerInBlue.TeamName}" Margin="0,8,0,0" TextWrapping="NoWrap" FontSize="14" HorizontalAlignment="Left" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>

                                                    <GridViewColumn Header="Счет" Width="Auto">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding MatchResult}" Margin="0,20,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>

                                                    <GridViewColumn Header="Победил" Width="Auto">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <StackPanel Margin="0,20,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                                                Visibility="{Binding IsRedWon, Converter={StaticResource BoolToVis}}">
                                                                        <materialDesign:PackIcon Kind="CheckboxBlank" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                 Margin="0" Padding="0" Foreground="DarkRed" Height="16" Width="16"/>
                                                                    </StackPanel>
                                                                    <StackPanel Margin="0,20,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                                Visibility="{Binding IsBlueWon, Converter={StaticResource BoolToVis}}">
                                                                        <materialDesign:PackIcon Kind="CheckboxBlank" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                 Margin="0" Padding="0" Foreground="Blue" Height="16" Width="16"/>
                                                                    </StackPanel>
                                                                    <StackPanel Margin="0,20,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                                Visibility="{Binding IsMutualDisqualify, Converter={StaticResource BoolToVis}}"
                                                                                ToolTip="Обоюдная дисквалификация">
                                                                        <materialDesign:PackIcon Kind="CloseOctagon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                 Margin="0" Padding="0" Foreground="Red" Height="20" Width="20"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>

                                                    <GridViewColumn Header="Тип победы" Width="Auto">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding WinType, Converter={StaticResource WinTypeToStringConverter}}" Margin="0,20,0,0" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>

                                                    <GridViewColumn Width="Auto">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                                                    <Button CommandParameter="{Binding }" Margin="5,10,5,5"
                                                                            Command="{Binding ElementName=RootControl, Path=DataContext.OpenMatchCommand}"
                                                                            ToolTip="Открыть результаты поединка" Background="DarkGray"
                                                                            BorderBrush="DarkGray">
                                                                        <materialDesign:PackIcon Kind="InformationVariant" Foreground="White" Width="22" Height="22" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>

                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseDoubleClick">
                                                    <i:InvokeCommandAction
                                                        Command="{Binding ElementName=RootControl, Path=DataContext.OpenMatchCommand}"
                                                        CommandParameter="{Binding Path=SelectedItem, ElementName=MatchesSource}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </ListView>
                                    </StackPanel>
                                </Expander.Content>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

    </Grid>
        
</UserControl>