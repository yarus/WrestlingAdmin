<UserControl x:Class="Wrestling.UI.Material.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="400" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0 0 0 32">
            <Grid>
                <StackPanel Orientation="Horizontal">

                    <materialDesign:Card Width="840" Margin="8 2 4 16" Height="280">
                        <Grid VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left column: Recent tournaments -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Margin="16 16 16 8" Text="{loc:Loc Recent_Title}" />

                                <Grid Grid.Row="1" Margin="8 0 8 8">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               Text="{loc:Loc Recent_Empty}"
                                               Visibility="{Binding IsRecentEmpty, Converter={StaticResource BoolToVis}}" />

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding RecentTournaments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                            HorizontalContentAlignment="Left"
                                                            HorizontalAlignment="Stretch"
                                                            Padding="12 6 12 6" Margin="0 1 0 1"
                                                            ToolTip="{Binding}"
                                                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <!-- Vertical divider between halves -->
                            <Border Grid.Column="1" BorderThickness="1 0 0 0"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}" />

                            <!-- Right column: original Open / New layout -->
                            <Grid Grid.Column="1" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="TrophyOutline"
                                                         Width="120" Height="120"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                               Margin="16 16 16 8" Text="{loc:Loc Home_Tournaments}" />

                                    <TextBlock TextWrapping="Wrap" Margin="16 0 16 8"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               VerticalAlignment="Top"
                                               Text="{loc:Loc Home_Description}" />
                                </StackPanel>

                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        BorderThickness="0 1 0 0"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}" Padding="8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" HorizontalAlignment="Left" Margin="8 4 8 8"
                                                Command="{Binding Path=OpenTournamentCommand}" Content="{loc:Loc Home_Open}" />

                                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="8 4 8 8"
                                                Command="{Binding Path=NewTournamentCommand}" Content="{loc:Loc Home_New}" />
                                    </DockPanel>
                                </Border>
                            </Grid>

                        </Grid>
                    </materialDesign:Card>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
