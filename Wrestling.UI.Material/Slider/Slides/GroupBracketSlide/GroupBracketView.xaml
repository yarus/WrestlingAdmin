<UserControl x:Class="Wrestling.UI.Material.Slider.Slides.GroupBracketSlide.GroupBracketView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters1="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Wrestling.UI.Material.Utils.Converters" Foreground="White">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters1:UpperCaseConverter x:Key="converter" />
        <converters:BracketCellLineHeightConverter x:Key="BracketCellHeight" />
        <converters:BracketCellLeftLineVisConverter x:Key="LeftLineVis" />
        <converters:BracketColumnTopMarginConverter x:Key="BracketColTopMargin"  />
        <converters:BracketRoundVertLineVisibilityConverter x:Key="VertVis"  />
        <converters:PathToImageConverter x:Key="PathToImage" />
    </UserControl.Resources>

    <UserControl.Background>
        <ImageBrush ImageSource="{Binding SliderBackgroundImagePath, Converter={StaticResource PathToImage}, ConverterParameter=SliderLogo.jpg}" Stretch="Uniform" Opacity="{Binding SliderOpacity}"/>
    </UserControl.Background>

    <Grid x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BorderThickness="0,0,1,0" BorderBrush="White" />
            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BorderThickness="0,0,1,0" BorderBrush="White" />
            <Border Grid.Row="0" Grid.Column="1" BorderThickness="0,0,0,1" BorderBrush="White" />

            <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH':'mm}}" Margin="10,0,10,0" />
            </Viewbox>            
            
            <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="ТУРНИРНАЯ СЕТКА" Margin="10,0,10,0"/>
            </Viewbox>

            <Viewbox Stretch="Uniform" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedGroup.Name, Converter={StaticResource converter}}" Margin="10,0,10,0"/>
            </Viewbox>

            <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedGroup.CarpetLabel, Converter={StaticResource converter}}" Margin="10,0,10,0"/>
            </Viewbox>
        </Grid>
        
        <Border Grid.Row="0" Grid.Column="0" BorderThickness="0 0 0 2" BorderBrush="White" />

        <Viewbox Stretch="Uniform" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <ItemsControl Grid.Row="0" Grid.Column="0" ItemsSource="{Binding GroupRounds}" Margin="40,0,40,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0">
                                <TextBlock x:Name="RoundLabel" Text="{Binding RoundName, Converter={StaticResource converter}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Margin>
                                        <MultiBinding Converter="{StaticResource BracketColTopMargin}">
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource Mode=Self}" />
                                            <Binding Path="DataContext.SelectedGroup" ElementName="RootControl" />
                                        </MultiBinding>
                                    </TextBlock.Margin>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding RoundMatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" Margin="0,0,0,10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="40" />
                                                    <RowDefinition>
                                                        <RowDefinition.Height>
                                                            <MultiBinding Converter="{StaticResource BracketCellHeight}">
                                                                <Binding Path="DataContext" RelativeSource="{RelativeSource Mode=Self}" />
                                                                <Binding Path="DataContext.SelectedGroup" ElementName="RootControl" />
                                                            </MultiBinding>
                                                        </RowDefinition.Height>
                                                    </RowDefinition>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="16" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="White" BorderThickness="0,0,0,1">

                                                        <Border.Visibility>
                                                            <MultiBinding Converter="{StaticResource LeftLineVis}">
                                                                <Binding Path="DataContext" RelativeSource="{RelativeSource Mode=Self}" />
                                                                <Binding Path="DataContext.SelectedGroup" ElementName="RootControl" />
                                                            </MultiBinding>
                                                        </Border.Visibility>

                                                    </Border>

                                                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Grid.RowSpan="2" BorderBrush="White" BorderThickness="1" />

                                                    <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BorderBrush="White" BorderThickness="0,0,1,0" />
                                                    <Border Grid.Row="0" Grid.Column="2" BorderBrush="White" BorderThickness="0,0,0,1" />

                                                    <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" BorderBrush="White" BorderThickness="1,0,0,0" />
                                                    <Border Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" BorderBrush="White" BorderThickness="1,0,0,0" />

                                                    <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding MatchNumber}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Path=WrestlerInRed.FullNameShort, Converter={StaticResource converter}}" Margin="5,0,5,0" MinWidth="60" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Path=WrestlerInBlue.FullNameShort, Converter={StaticResource converter}}" Margin="5,0,5,0" MinWidth="60" />

                                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PointsRed}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PointsBlue}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                    <Grid Grid.Row="0" Grid.Column="4" Visibility="{Binding IsMatchCompleted, Converter={StaticResource BoolToVis}}" 
                                                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">

                                                        <materialDesign:PackIcon Kind="CheckboxMarkedOutline" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                    Margin="0" Padding="0" Foreground="White"
                                                                                    Visibility="{Binding IsRedWon, Converter={StaticResource BoolToVis}}" Height="16" Width="16"/>
                                                    </Grid>

                                                    <Grid Grid.Row="1" Grid.Column="4" Visibility="{Binding IsMatchCompleted, Converter={StaticResource BoolToVis}}" 
                                                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                                                        <materialDesign:PackIcon Kind="CheckboxMarkedOutline" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                    Margin="0" Padding="0" Foreground="White"
                                                                                    Visibility="{Binding IsBlueWon, Converter={StaticResource BoolToVis}}" Height="16" Width="16"/>
                                                    </Grid>

                                                </Grid>

                                                <Grid Row="1">

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="1*" />
                                                        <RowDefinition Height="1*" />
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BorderBrush="White" BorderThickness="0,0,1,0">
                                                        <Border.Visibility>
                                                            <MultiBinding Converter="{StaticResource VertVis}">
                                                                <Binding Path="DataContext" RelativeSource="{RelativeSource Mode=Self}" />
                                                                <Binding Path="DataContext" ElementName="RoundLabel" />
                                                                <Binding Path="DataContext.SelectedGroup" ElementName="RootControl" />
                                                            </MultiBinding>
                                                        </Border.Visibility>
                                                    </Border>
                                                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="White" BorderThickness="0,0,0,1">
                                                        <Border.Visibility>
                                                            <MultiBinding Converter="{StaticResource VertVis}">
                                                                <Binding Path="DataContext" RelativeSource="{RelativeSource Mode=Self}" />
                                                                <Binding Path="DataContext" ElementName="RoundLabel" />
                                                                <Binding Path="DataContext.SelectedGroup" ElementName="RootControl" />
                                                            </MultiBinding>
                                                        </Border.Visibility>
                                                    </Border>

                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>