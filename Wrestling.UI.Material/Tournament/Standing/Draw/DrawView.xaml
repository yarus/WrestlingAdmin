<UserControl x:Class="Wrestling.UI.Material.Tournament.Standing.Draw.DrawView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Material.Utils.Converters"
             xmlns:converters1="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:BracketCellLineHeightConverter x:Key="BracketCellHeight" />
        <converters:BracketCellLeftLineVisConverter x:Key="LeftLineVis" />
        <converters:BracketColumnTopMarginConverter x:Key="BracketColTopMargin"  />
        <converters:BracketRoundVertLineVisibilityConverter x:Key="VertVis"  />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters1:IndexItemsConverter x:Key="ItemsIndexConverter" />

        <converters1:ValueConverterGroup x:Key="InvBoolToVis">
            <converters1:BoolInverterConverter />
            <converters1:GroupedBoolToVisConverter />
        </converters1:ValueConverterGroup>
    </UserControl.Resources>

    <Grid x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="20,0,20,0" FontSize="16" VerticalAlignment="Center">
                <Button Content="{loc:Loc Draw_RegenerateAll}"
                        HorizontalAlignment="Left" Margin="5,0,5,0"
                        Command="{Binding Path=DataContext.RegenerateAllBrackets, ElementName=RootControl}"
                        CommandParameter="{Binding }" />
                <Button Content="{loc:Loc Draw_UnfixAllSeeds}"
                        HorizontalAlignment="Left" Margin="5,0,5,0"
                        ToolTip="{loc:Loc Draw_UnfixAllSeeds_Tooltip}"
                        Command="{Binding Path=DataContext.UnfixAllSeedsCommand, ElementName=RootControl}" />
            </TextBlock>
            
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                        Margin="12,0,12,0" VerticalAlignment="Center"
                        ToolTip="{loc:Loc Draw_GroupsCount_Tooltip}">
                <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Text="{Binding GroupsCount, Mode=OneWay}"
                           FontSize="16" VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                        Margin="12,0,12,0" VerticalAlignment="Center"
                        ToolTip="{loc:Loc Draw_WrestlersCount_Tooltip}">
                <materialDesign:PackIcon Kind="AccountMultiple" Width="20" Height="20"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Text="{Binding WrestlersCount, Mode=OneWay}"
                           FontSize="16" VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal"
                        Margin="12,0,20,0" VerticalAlignment="Center"
                        ToolTip="{loc:Loc Draw_MatchesCount_Tooltip}">
                <materialDesign:PackIcon Kind="Wrestling" Width="20" Height="20"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Text="{Binding MatchesCount, Mode=OneWay}"
                           FontSize="16" VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </StackPanel>
        </Grid>
        
        <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Groups}">            
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer CanContentScroll="False" 
                                      Padding="{TemplateBinding Padding}"
                                      Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ItemsControl.Template>
            
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Expander x:Name="GroupControl" Background="{DynamicResource MaterialDesignToolBarBackground}" Margin="0" Padding="0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" TextWrapping="NoWrap" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ItemsIndexConverter}" ConverterParameter="1">
                                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}" />
                                            <Binding Path="."/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Column="1" TextWrapping="NoWrap" FontSize="16" VerticalAlignment="Center" Margin="20,0,0,0" Text="{Binding Name}" />

                                <TextBlock Grid.Column="2" TextWrapping="Wrap" FontSize="16" VerticalAlignment="Center" Margin="20,0,0,0" Text="{Binding Path=Bracket.BracketTypeDisplay}" />

                                <StackPanel Grid.Row="0" Grid.Column="3">
                                    <Button Content="{loc:Loc Draw_GenerateBracket}"
                                            HorizontalAlignment="Right" Margin="5,0,5,0"
                                            Command="{Binding Path=DataContext.GenerateBracketCommand, ElementName=RootControl}"
                                            CommandParameter="{Binding }" />
                                </StackPanel>

                                <Grid Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,20,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="1" Foreground="Green" Width="32" Height="32" Margin="0" Padding="0"
                                                             ToolTip="{loc:Loc Draw_BracketGenerated_Tooltip}" Kind="CheckboxMarkedOutline"
                                                             Visibility="{Binding Path=IsBracketGenerated, Converter={StaticResource BoolToVis}}" />
                                    <materialDesign:PackIcon Grid.Column="1" Foreground="DarkRed" Width="32" Height="32" Margin="0" Padding="0"
                                                             ToolTip="{loc:Loc Draw_BracketMissing_Tooltip}" Kind="CloseBoxOutline" Visibility="{Binding Path=IsBracketGenerated, Converter={StaticResource InvBoolToVis}}" />
                                </Grid>
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <Grid Visibility="{Binding ElementName=GroupControl, Path=IsExpanded, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" TextWrapping="NoWrap" Text="{loc:Loc Draw_Seeding}"
                                           FontSize="16" TextAlignment="Center" FontWeight="SemiBold" Margin="10,8,10,8" />

                                <materialDesign:Card Grid.Row="1" Margin="10,10,10,10"
                                                     UniformCornerRadius="4"
                                                     materialDesign:ElevationAssist.Elevation="Dp4">
                                <ListView ItemsSource="{Binding Path=Wrestlers}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          HorizontalContentAlignment="Stretch"
                                          TextElement.FontSize="15">
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="false">
                                            <GridView.ColumnHeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                                    <Setter Property="Padding" Value="4,8,4,8" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="FontSize" Value="14" />
                                                </Style>
                                            </GridView.ColumnHeaderContainerStyle>

                                            <GridViewColumn Width="50" Header="{loc:Loc Draw_Column_Fixed}">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSeedFixed}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="60" Header="{loc:Loc Draw_Column_Seed}">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding SeedNumber}" MinWidth="36" TextWrapping="NoWrap" FontSize="15"
                                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                 HorizontalContentAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="{loc:Loc Applications_Column_FullName}" Width="220">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding FullNameShort}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="{loc:Loc Draw_Column_Team}" Width="160">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding TeamName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="{loc:Loc Draw_Column_City}" Width="200">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding TeamCity}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="{loc:Loc Applications_Column_Level}" Width="80">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding LevelDisplay}" TextWrapping="NoWrap" FontSize="15"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="{loc:Loc Applications_Column_BirthYear}" Width="90">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding BirthDate, StringFormat={}{0:d}}" TextWrapping="NoWrap"
                                                                   FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                        </GridView>

                                    </ListView.View>
                                </ListView>
                                </materialDesign:Card>

                                <TextBlock Grid.Row="2" TextWrapping="NoWrap" Text="{loc:Loc Draw_Results}"
                                           FontSize="16" TextAlignment="Center" FontWeight="SemiBold" Margin="10,12,10,8"
                                           Visibility="{Binding Path=IsBracketGenerated, Converter={StaticResource BoolToVis}}" />

                                <materialDesign:Card Grid.Row="3" Margin="10,10,10,10"
                                                     UniformCornerRadius="4"
                                                     materialDesign:ElevationAssist.Elevation="Dp4"
                                                     Visibility="{Binding Path=IsBracketGenerated, Converter={StaticResource BoolToVis}}">
                                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"
                                         Margin="10,10,10,10">
                                    <Grid Margin="0,0,10,0">
                                        <ItemsControl ItemsSource="{Binding Path=Bracket.Rounds}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0">
                                                    <TextBlock x:Name="RoundLabel" Text="{loc:LocRound RoundName}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Margin>
                                                            <MultiBinding Converter="{StaticResource BracketColTopMargin}">
                                                                <Binding Path="." />
                                                                <Binding Path="DataContext" ElementName="GroupControl" />
                                                            </MultiBinding>
                                                        </TextBlock.Margin>
                                                    </TextBlock>

                                                    <ItemsControl ItemsSource="{Binding RoundMatches}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Vertical" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="40" />
                                                                        <RowDefinition>
                                                                            <RowDefinition.Height>
                                                                                <MultiBinding Converter="{StaticResource BracketCellHeight}">
                                                                                    <Binding Path="." />
                                                                                    <Binding Path="DataContext" ElementName="GroupControl" />
                                                                                </MultiBinding>
                                                                            </RowDefinition.Height>
                                                                        </RowDefinition>
                                                                    </Grid.RowDefinitions>

                                                                    <Grid Grid.Row="0">

                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition />
                                                                            <RowDefinition />
                                                                        </Grid.RowDefinitions>

                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="20" />
                                                                            <ColumnDefinition Width="30" />
                                                                            <ColumnDefinition Width="1*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,1">

                                                                            <Border.Visibility>
                                                                                <MultiBinding Converter="{StaticResource LeftLineVis}">
                                                                                    <Binding Path="." />
                                                                                    <Binding Path="DataContext" ElementName="GroupControl" />
                                                                                </MultiBinding>
                                                                            </Border.Visibility>

                                                                        </Border>

                                                                        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" BorderBrush="Black" BorderThickness="1" />
                                                                        <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,0,1" />
                                                                        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BorderBrush="Black" BorderThickness="0,0,1,0" />

                                                                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" FontSize="14" Text="{Binding BracketFullNumber, Mode=OneWay}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                                        <TextBlock Grid.Row="0" Grid.Column="2" FontSize="14" Text="{Binding WrestlerInRed.LastFirstName, Mode=OneWay}"
                                                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                   MinWidth="60" Margin="5,0,5,0" />

                                                                        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="14" Text="{Binding WrestlerInBlue.LastFirstName, Mode=OneWay}"
                                                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                   MinWidth="60" Margin="5,0,5,0" />
                                                                    </Grid>

                                                                    <Grid Row="1">

                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="1*" />
                                                                            <RowDefinition Height="1*" />
                                                                        </Grid.RowDefinitions>

                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2*" />
                                                                            <ColumnDefinition Width="1*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                                                                            <Border.Visibility>
                                                                                <MultiBinding Converter="{StaticResource VertVis}">
                                                                                    <Binding Path="." />
                                                                                    <Binding Path="DataContext" ElementName="RoundLabel" />
                                                                                    <Binding Path="DataContext" ElementName="GroupControl" />
                                                                                </MultiBinding>
                                                                            </Border.Visibility>
                                                                        </Border>
                                                                        <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1">
                                                                            <Border.Visibility>
                                                                                <MultiBinding Converter="{StaticResource VertVis}">
                                                                                    <Binding Path="." />
                                                                                    <Binding Path="DataContext" ElementName="RoundLabel" />
                                                                                    <Binding Path="DataContext" ElementName="GroupControl" />
                                                                                </MultiBinding>
                                                                            </Border.Visibility>
                                                                        </Border>

                                                                    </Grid>
                                                                </Grid>

                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </Grid>
                                </Viewbox>
                                </materialDesign:Card>
                            </Grid>
                        </Expander.Content>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>
</UserControl>