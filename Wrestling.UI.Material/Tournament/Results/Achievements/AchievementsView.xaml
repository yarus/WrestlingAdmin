<UserControl x:Class="Wrestling.UI.Material.Tournament.Results.Achievements.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
             xmlns:utils="clr-namespace:Wrestling.UI.Utils;assembly=Wrestling.UI.Utils"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:IndexConverter x:Key="IndexConverter" />
        <converters:IndexItemsConverter x:Key="ItemsIndexConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Per-part selector — visible only when 2+ parts exist. Local to
             this screen; doesn't affect any mat's ActivePartID. Anchored to
             the right edge, no label. -->
        <ComboBox Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="20,10,20,10" MinWidth="160"
                  ItemsSource="{Binding AvailableParts}"
                  SelectedItem="{Binding SelectedPart, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  Visibility="{Binding HasMultipleParts, Converter={StaticResource BoolToVis}}" />

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer CanContentScroll="False"
                                      Padding="{TemplateBinding Padding}"
                                      Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Expander Background="{DynamicResource MaterialDesignToolBarBackground}" Margin="0" Padding="0" x:Name="Expander" IsExpanded="False"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" MinWidth="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" TextWrapping="NoWrap" FontSize="16"
                                           VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ItemsIndexConverter}"
                                                      ConverterParameter="1">
                                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}" />
                                            <Binding Path="." />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Column="1" TextWrapping="NoWrap" FontSize="16" FontWeight="Medium"
                                           Margin="20,0,20,0" VerticalAlignment="Center"
                                           Text="{Binding Title, Mode=OneWay}" />

                                <TextBlock Grid.Column="2" TextWrapping="Wrap" FontSize="13"
                                           Margin="0,0,20,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Text="{Binding Definition, Mode=OneWay}" />

                                <TextBlock Grid.Column="3" Margin="20,0,20,0" FontSize="14" VerticalAlignment="Center">
                                    <Run Text="{loc:Loc Achievements_NomineesLabel}" />
                                    <Run Text="{Binding WinnersCount, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <StackPanel Margin="0"
                                        Visibility="{Binding ElementName=Expander, Path=IsExpanded, Converter={StaticResource BoolToVis}}">
                                <materialDesign:Card Margin="10,10,10,10"
                                                     UniformCornerRadius="4"
                                                     materialDesign:ElevationAssist.Elevation="Dp4">
                                <ListView ItemsSource="{Binding Winners}"
                                          utils:GridViewSort.AutoSort="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          HorizontalContentAlignment="Stretch"
                                          TextElement.FontSize="15">
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="True">
                                            <GridViewColumn Header="#" Width="48"
                                                            DisplayMemberBinding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Converter={StaticResource IndexConverter}, ConverterParameter=1}" />

                                            <GridViewColumn Header="{loc:Loc Applications_Column_FullName}" Width="240"
                                                            DisplayMemberBinding="{Binding Wrestler.FullName}"
                                                            utils:GridViewSort.PropertyName="Wrestler.FullName" />

                                            <GridViewColumn Header="{loc:Loc Draw_Column_Team}" Width="200"
                                                            DisplayMemberBinding="{Binding Wrestler.TeamName}"
                                                            utils:GridViewSort.PropertyName="Wrestler.TeamName" />

                                            <GridViewColumn Header="{loc:Loc Results_Column_Category}" Width="180"
                                                            DisplayMemberBinding="{Binding Wrestler.GroupName}"
                                                            utils:GridViewSort.PropertyName="Wrestler.GroupName" />

                                            <GridViewColumn Header="{loc:Loc Achievements_Column_Achievement}" Width="160"
                                                            DisplayMemberBinding="{Binding AchievementValue}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                </materialDesign:Card>
                            </StackPanel>
                        </Expander.Content>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty-state placeholder — shown when no nomination has a winner yet
             (e.g. before any decisive match). Overlaps the list area; hidden as
             soon as achievements appear. -->
        <TextBlock Grid.Row="1" Text="{loc:Loc Achievements_NoData}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="16" FontStyle="Italic"
                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                   Visibility="{Binding HasAchievements, Converter={StaticResource InvBoolToVis}}" />
    </Grid>
</UserControl>
