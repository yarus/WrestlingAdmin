<UserControl x:Class="Wrestling.UI.Material.Match.MatchControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:converters1="clr-namespace:Wrestling.UI.Material.Utils.Converters"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             mc:Ignorable="d" Background="Black" Foreground="White"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="580" d:DesignWidth="1024">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolInverterConverter x:Key="BoolInverterConverter" />
        <converters:UpperCaseConverter x:Key="UpperCaseConverter" />
        <converters1:WarningNumberToRectVisibilityConverter x:Key="WarningVisConverter" />
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Expander Grid.Row="0" Grid.Column="0" Header="Настройки" Foreground="Black" Visibility="{Binding IsTournamentEmpty, Converter={StaticResource BoolToVis}}">
            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="ЗАГОЛОВОК" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding Path=ScoreScreenVm.TournamentTitle, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="Black" TextWrapping="NoWrap" Margin="3" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="КОВЕР" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" />
                <TextBox Grid.Row="0" Grid.Column="3"
                         Text="{Binding Path=ScoreScreenVm.CarpetLabel, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="Black" TextWrapping="NoWrap" Margin="3" />

                <TextBlock Grid.Row="0" Grid.Column="4" Text="ГРУППА" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" />
                <TextBox Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="3"
                         Text="{Binding Path=ScoreScreenVm.GroupLabel, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="Black" TextWrapping="NoWrap" Margin="3" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="СТАДИЯ" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Path=ScoreScreenVm.RoundName, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="Black" TextWrapping="NoWrap" Margin="3" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="РАУНД" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" />
                <TextBox Grid.Row="1" Grid.Column="3"
                         Text="{Binding Path=ScoreScreenVm.MaxRoundSecond, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="Black" TextWrapping="NoWrap" Margin="3" />

                <TextBlock Grid.Row="1" Grid.Column="4" Text="ТАЙМАУТ" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" />
                <TextBox Grid.Row="1" Grid.Column="5"
                         Text="{Binding Path=ScoreScreenVm.MaxTimeoutSecond, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="Black" TextWrapping="NoWrap" Margin="3" />

                <TextBlock Grid.Row="1" Grid.Column="6" Text="ДЕЙСТВИЕ" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" />
                <TextBox Grid.Row="1" Grid.Column="7"
                         Text="{Binding Path=ScoreScreenVm.MaxActionSecond, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="Black" TextWrapping="NoWrap" Margin="3" />
            </Grid>
        </Expander>

        <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,0,2" BorderBrush="White" />

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Background="Red" BorderThickness="0 0 1 0" BorderBrush="White" />
            <Border Grid.Column="0" Grid.Row="1" Background="Red" BorderThickness="0 0 1 0" BorderBrush="White" />

            <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="5">
                <TextBlock Text="БОРЕЦ В КРАСНОМ" Foreground="White" />
            </Viewbox>

            <Viewbox Grid.Row="1" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox Text="{Binding Path=ScoreScreenVm.Wrestler1, Converter={StaticResource UpperCaseConverter}}" FontStretch="Medium" Foreground="Black" TextWrapping="NoWrap" TabIndex="1" Background="White" MinWidth="140"
                         IsReadOnly="{Binding IsTournamentEmpty, Converter={StaticResource BoolInverterConverter}}"/>
            </Viewbox>

            <Viewbox Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Stretch="Uniform" HorizontalAlignment="Center"
                     VerticalAlignment="Bottom">
                <TextBlock Foreground="White">
                    <Run Text="РАУНД " />
                    <Run Text="{Binding Path=ScoreScreenVm.Round}" />
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=ScoreScreenVm.IsTimeout}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Viewbox>

            <Viewbox Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Stretch="Uniform" HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <TextBlock Text="ПЕРЕРЫВ" Foreground="Yellow">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=ScoreScreenVm.IsTimeout}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Viewbox>

            <Border Grid.Column="2" Grid.Row="0" Background="Blue" BorderThickness="1 0 0 0" BorderBrush="White" />
            <Border Grid.Column="2" Grid.Row="1" Background="Blue" BorderThickness="1 0 0 0" BorderBrush="White" />

            <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Margin="5">
                <TextBlock Text="БОРЕЦ В СИНЕМ" Foreground="White" />
            </Viewbox>

            <Viewbox Grid.Row="1" Grid.Column="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox FontStretch="Medium" Background="White" Text="{Binding Path=ScoreScreenVm.Wrestler2, Converter={StaticResource UpperCaseConverter}}" Foreground="Black" TextWrapping="NoWrap" TabIndex="2" MinWidth="140" 
                         IsReadOnly="{Binding IsTournamentEmpty, Converter={StaticResource BoolInverterConverter}}"/>
            </Viewbox>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" BorderThickness="0,0,0,2" BorderBrush="White" />

        <Grid Grid.Row="2" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Grid.Row="0" Background="Red">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" BorderThickness="0 2 2 2" BorderBrush="White" />

                <Border Grid.Column="0" Grid.Row="0" BorderThickness="0 0 2 0" BorderBrush="White" />

                <Viewbox Grid.Column="0" Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <Button Background="LightGray" MinHeight="30"
                        Command="{Binding Path=ActionStartStopCommand}"
                        CommandParameter="Red"
                        Visibility="{Binding Action1Visibility}">
                        <Image Source="{Binding Action1Image}" />
                    </Button>
                </Viewbox>

                <Viewbox Grid.Row="0" Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Path=ScoreScreenVm.TickCounterAction1, StringFormat={}{0:ss}}" 
                               Visibility="{Binding Action1Visibility}"
                               Foreground="White" Margin="5" />
                </Viewbox>

            </Grid>

            <Grid Grid.Column="0" Grid.Row="1" Background="Red">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="2" BorderThickness="0 0 2 2"
                        BorderBrush="White" />

                <Viewbox Grid.Column="0" Grid.Row="0" 
                         Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="10">
                    <Button Content="+1" Foreground="Black" Tag="Red" FontStretch="Medium" Background="LightGray"
                            Command="{Binding AdjustPointsCommand}"
                            CommandParameter="+1,Red" />
                </Viewbox>

                <Viewbox Grid.Column="1" Grid.Row="0" 
                         Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="10">
                    <Button Content="+2" Foreground="Black" Tag="Red" Background="LightGray"
                        Command="{Binding AdjustPointsCommand}" FontStretch="Medium"
                        CommandParameter="+2,Red" />
                </Viewbox>

                <Viewbox Grid.Column="0" Grid.Row="1" 
                         Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="10">
                    <Button Content="+4" Foreground="Black" Background="LightGray"
                        Tag="Red" FontStretch="Medium"
                        Command="{Binding AdjustPointsCommand}"
                        CommandParameter="+4,Red" />
                </Viewbox>

                <Viewbox Grid.Column="1" Grid.Row="1" 
                         Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="10">
                    <Button Content=" -1" Foreground="Black" Tag="Red" Background="LightGray"
                        FontStretch="Medium"
                        Command="{Binding AdjustPointsCommand}"
                        CommandParameter="-1,Red" />
                </Viewbox>

            </Grid>

            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Grid.Row="0" BorderThickness="0 2 2 0" BorderBrush="White" />
                <Border Grid.Column="1" Grid.Row="0" BorderThickness="0 2 0 0" BorderBrush="White" />
                <Border Grid.Column="2" Grid.Row="0" BorderThickness="2 2 0 0" BorderBrush="White" />

                <Viewbox Stretch="Uniform" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10">
                    <Button Content="{Binding StartStopButtonCaption}" Background="LightGray" TabIndex="3" Foreground="Black" FontStretch="Medium"
                            Command="{Binding StartStopCommand}" 
                            Visibility="{Binding IsMatchNotCompleted, Converter={StaticResource BoolToVis}}"/>
                </Viewbox>

                <Viewbox Grid.Row="0" Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Path=ScoreScreenVm.TickCounter, StringFormat={}{0:mm':'ss}}" Foreground="White" />
                </Viewbox>

                <Viewbox Stretch="Uniform" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10">
                    <Button Content="Сброс" Foreground="Black" Background="LightGray" Command="{Binding ResetCommand}" FontStretch="Medium" 
                            Visibility="{Binding IsTournamentEmpty, Converter={StaticResource BoolToVis}}"/>
                </Viewbox>

                <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" BorderThickness="0 0 0 2" BorderBrush="White" />

            </Grid>

            <Grid Grid.Column="1" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Background="Red" />
                <Border Grid.Column="1" Grid.Row="0" Background="Blue" />

                <Border Grid.Column="0" Grid.Row="0" BorderThickness="0 0 2 2" BorderBrush="White" />
                <Border Grid.Column="1" Grid.Row="0" BorderThickness="0 0 0 2" BorderBrush="White" />

                <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <TextBlock Foreground="White" Text="{Binding Path=ScoreScreenVm.Points1}" />
                </Viewbox>

                <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <TextBlock Foreground="White" Text="{Binding Path=ScoreScreenVm.Points2}" />
                </Viewbox>

            </Grid>

            <Grid Grid.Column="2" Grid.Row="0" Background="Blue">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" BorderThickness="2 2 0 2" BorderBrush="White" />
                <Border Grid.Column="1" Grid.Row="0" BorderThickness="2 0 0 0" BorderBrush="White" />

                <Viewbox Grid.Row="0" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <TextBlock Visibility="{Binding Action2Visibility}"
                        Text="{Binding Path=ScoreScreenVm.TickCounterAction2, StringFormat={}{0:ss}}" Margin="5"
                               Foreground="White" />
                </Viewbox>

                <Viewbox Grid.Column="1" Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="10">
                    <Button Background="LightGray" MinHeight="30"
                        Command="{Binding Path=ActionStartStopCommand}"
                        CommandParameter="Blue" FontStretch="Medium"
                        Visibility="{Binding Action2Visibility}">
                        <Image Source="{Binding Action2Image}" />
                    </Button>
                </Viewbox>

            </Grid>

            <Grid Grid.Column="2" Grid.Row="1" Background="Blue">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="2" BorderThickness="2 0 0 2"
                        BorderBrush="White" />

                <Viewbox Grid.Column="0" Grid.Row="0" 
                         Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="10">
                    <Button Foreground="Black" Content="+1" FontStretch="Medium" Background="LightGray"
                        Command="{Binding AdjustPointsCommand}"
                        CommandParameter="+1,Blue" />
                </Viewbox>

                <Viewbox Grid.Column="1" Grid.Row="0" 
                         Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="10">
                    <Button Foreground="Black" Content="+2" FontStretch="Medium" Background="LightGray"
                        Command="{Binding AdjustPointsCommand}"
                        CommandParameter="+2,Blue" />
                </Viewbox>

                <Viewbox Grid.Column="0" Grid.Row="1" 
                         Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="10">
                    <Button Foreground="Black" Content="+4" FontStretch="Medium" Background="LightGray"
                        Command="{Binding AdjustPointsCommand}"
                        CommandParameter="+4,Blue" />
                </Viewbox>

                <Viewbox Grid.Column="1" Grid.Row="1" 
                         Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="10">
                    <Button Foreground="Black" Content=" -1" FontStretch="Medium" Background="LightGray"
                        Command="{Binding AdjustPointsCommand}"
                        CommandParameter="-1,Blue" />
                </Viewbox>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Grid.Row="0" Background="Red">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Grid.Row="0" BorderThickness="0 0 2 0" BorderBrush="White" />

                <Viewbox Grid.Column="0" Grid.Row="0"  Margin="5"
                         Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Button Content="+" Foreground="Black" Tag="Red" FontStretch="Medium" Background="LightGray"
                            Command="{Binding ChangeWarningsCommand}" MinWidth="25"
                            CommandParameter="+1,Red" />
                </Viewbox>

                <Viewbox Grid.Column="1" Grid.Row="0"  Margin="5"
                         Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Button Content="-" Foreground="Black" Tag="Red" FontStretch="Medium" Background="LightGray"
                            Command="{Binding ChangeWarningsCommand}" MinWidth="25"
                            CommandParameter="-1,Red" />
                </Viewbox>

            </Grid>

            <Grid Grid.Column="1" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Background="Red" />
                <Border Grid.Column="1" Grid.Row="0" Background="Blue" />

                <Border Grid.Column="0" Grid.Row="0" BorderThickness="0 0 2 0" BorderBrush="White" />

                <Grid Grid.Column="0" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="Yellow" Margin="10,10,10,10" Visibility="{Binding Path=ScoreScreenVm.Wrestler1WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=1}" />
                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="Yellow" Margin="10,10,10,10" Visibility="{Binding Path=ScoreScreenVm.Wrestler1WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=2}" />
                    <Rectangle Grid.Row="0" Grid.Column="2" Fill="Yellow" Margin="10,10,10,10" Visibility="{Binding Path=ScoreScreenVm.Wrestler1WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=3}" />
                </Grid>

                <Grid Grid.Column="1" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="Yellow" Margin="10,10,10,10" Visibility="{Binding Path=ScoreScreenVm.Wrestler2WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=1}" />
                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="Yellow" Margin="10,10,10,10" Visibility="{Binding Path=ScoreScreenVm.Wrestler2WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=2}" />
                    <Rectangle Grid.Row="0" Grid.Column="2" Fill="Yellow" Margin="10,10,10,10" Visibility="{Binding Path=ScoreScreenVm.Wrestler2WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=3}" />

                </Grid>
            </Grid>

            <Grid Grid.Column="2" Grid.Row="0" Background="Blue">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Grid.Row="0" BorderThickness="2 0 0 0" BorderBrush="White" />

                <Viewbox Grid.Column="0" Grid.Row="0"  Margin="5"
                         Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Button Content="+" Foreground="Black" Tag="Red" FontStretch="Medium" Background="LightGray"
                            Command="{Binding ChangeWarningsCommand}" MinWidth="25"
                            CommandParameter="+1,Blue" />
                </Viewbox>

                <Viewbox Grid.Column="1" Grid.Row="0"  Margin="5"
                         Stretch="Uniform" HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Button Content="-" Foreground="Black" Tag="Red" FontStretch="Medium" Background="LightGray"
                            Command="{Binding ChangeWarningsCommand}" MinWidth="25"
                            CommandParameter="-1,RBlueed" />
                </Viewbox>
            </Grid>
        </Grid>

    </Grid>
</UserControl>