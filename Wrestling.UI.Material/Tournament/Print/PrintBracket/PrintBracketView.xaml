<UserControl x:Class="Wrestling.UI.Material.Tournament.Print.PrintBracket.PrintBracketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Material.Utils.Converters"
             mc:Ignorable="d" Foreground="Black" Background="LightGray"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BracketCellLineHeightConverter x:Key="BracketCellHeight" />
        <converters:BracketCellLeftLineVisConverter x:Key="LeftLineVis" />
        <converters:BracketColumnTopMarginConverter x:Key="BracketColTopMargin" />
        <converters:BracketRoundVertLineVisibilityConverter x:Key="VertVis" />
    </UserControl.Resources>

    <StackPanel Background="White" x:Name="RootControl">
        <TextBlock Text="{Binding Tournament.Name}"
                   TextWrapping="Wrap" Foreground="Black"
                   FontSize="32" TextAlignment="Center" FontWeight="Normal" />

        <Grid Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" TextWrapping="NoWrap" Foreground="Black"
                       Text="{Binding Tournament.StartDate, StringFormat={}{0:d}}" FontSize="16" TextAlignment="Left"
                       FontWeight="Normal" />

            <TextBlock Grid.Row="0" Grid.Column="1"
                       TextWrapping="NoWrap" Foreground="Black" Text="Весовая категория"
                       FontSize="16" TextAlignment="Right" FontWeight="Normal" />

        </Grid>

        <Grid Margin="10,5,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       TextWrapping="NoWrap" Foreground="Black" Text="{Binding Path=SelectedGroup.CarpetLabel}"
                       FontSize="16" TextAlignment="Left" FontWeight="Normal" />

            <TextBlock Grid.Row="0" Grid.Column="1"
                       TextWrapping="NoWrap" Foreground="Black" Text="{Binding Path=SelectedGroup.Name}"
                       FontSize="16" TextAlignment="Right" FontWeight="Normal" />
        </Grid>

        <TextBlock
            TextWrapping="NoWrap" Foreground="Black" Text="Протокол"
            FontSize="36" TextAlignment="Center" FontWeight="Normal" Margin="10,5,10,0" />

        <Border BorderBrush="Black" BorderThickness="0,1,0,0" />

        <Grid Margin="0">
            <ItemsControl ItemsSource="{Binding GroupMainRounds}" Margin="0,10,10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0">
                            <TextBlock x:Name="RoundLabel" Text="{Binding RoundName}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Margin>
                                    <MultiBinding Converter="{StaticResource BracketColTopMargin}">
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource Mode=Self}" />
                                        <Binding Path="DataContext.SelectedGroup" ElementName="RootControl" />
                                    </MultiBinding>
                                </TextBlock.Margin>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding RoundMatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40" />
                                                <RowDefinition>
                                                    <RowDefinition.Height>
                                                        <MultiBinding Converter="{StaticResource BracketCellHeight}">
                                                            <Binding Path="DataContext"
                                                                     RelativeSource="{RelativeSource Mode=Self}" />
                                                            <Binding Path="DataContext.SelectedGroup"
                                                                     ElementName="RootControl" />
                                                        </MultiBinding>
                                                    </RowDefinition.Height>
                                                </RowDefinition>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="16" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black"
                                                        BorderThickness="0,0,0,1">

                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource LeftLineVis}">
                                                            <Binding Path="DataContext"
                                                                     RelativeSource="{RelativeSource Mode=Self}" />
                                                            <Binding Path="DataContext.SelectedGroup"
                                                                     ElementName="RootControl" />
                                                        </MultiBinding>
                                                    </Border.Visibility>

                                                </Border>

                                                <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                                                        Grid.RowSpan="2" BorderBrush="Black" BorderThickness="1" />

                                                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                                        BorderBrush="Black" BorderThickness="0,0,1,0" />
                                                <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black"
                                                        BorderThickness="0,0,0,1" />

                                                <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="2"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding MatchNumber}" Foreground="Black" />

                                                <TextBlock Grid.Row="0" Grid.Column="2"
                                                           Text="{Binding Path=WrestlerInRed.LastFirstNameShort}"
                                                           Foreground="Black" VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           MinWidth="60" />
                                                <TextBlock Grid.Row="1" Grid.Column="2"
                                                           Text="{Binding Path=WrestlerInBlue.LastFirstNameShort}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                                           Foreground="Black"
                                                           MinWidth="60" />

                                                <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"
                                                        BorderBrush="Black" BorderThickness="1,0,0,0" />
                                                <Border Grid.Row="0" Grid.Column="4" Grid.RowSpan="2"
                                                        BorderBrush="Black" BorderThickness="1,0,0,0" />

                                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PointsRed}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Foreground="Black" />
                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PointsBlue}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Foreground="Black" />

                                                <Grid Grid.Row="0" Grid.Column="4"
                                                      Visibility="{Binding IsMatchCompleted, Converter={StaticResource BoolToVis}}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Margin="0">

                                                    <materialDesign:PackIcon Kind="CheckboxMarked"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0" Padding="0"
                                                                             Visibility="{Binding IsRedWon, Converter={StaticResource BoolToVis}}"
                                                                             Height="16" Width="16" />
                                                </Grid>

                                                <Grid Grid.Row="1" Grid.Column="4"
                                                      Visibility="{Binding IsMatchCompleted, Converter={StaticResource BoolToVis}}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Margin="0">
                                                    <materialDesign:PackIcon Kind="CheckboxMarked"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0" Padding="0"
                                                                             Visibility="{Binding IsBlueWon, Converter={StaticResource BoolToVis}}"
                                                                             Height="16" Width="16" />
                                                </Grid>
                                            </Grid>

                                            <Grid Row="1">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*" />
                                                    <RowDefinition Height="1*" />
                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                                        BorderBrush="Black" BorderThickness="0,0,1,0">
                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource VertVis}">
                                                            <Binding Path="DataContext"
                                                                     RelativeSource="{RelativeSource Mode=Self}" />
                                                            <Binding Path="DataContext" ElementName="RoundLabel" />
                                                            <Binding Path="DataContext.SelectedGroup"
                                                                     ElementName="RootControl" />
                                                        </MultiBinding>
                                                    </Border.Visibility>
                                                </Border>
                                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black"
                                                        BorderThickness="0,0,0,1">
                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource VertVis}">
                                                            <Binding Path="DataContext"
                                                                     RelativeSource="{RelativeSource Mode=Self}" />
                                                            <Binding Path="DataContext" ElementName="RoundLabel" />
                                                            <Binding Path="DataContext.SelectedGroup"
                                                                     ElementName="RootControl" />
                                                        </MultiBinding>
                                                    </Border.Visibility>
                                                </Border>

                                            </Grid>

                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid Margin="0,0,40,0">
            <ItemsControl ItemsSource="{Binding GroupAdditoinalRounds}" HorizontalAlignment="Right"
                          VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0">
                            <TextBlock x:Name="RoundLabel" Text="{Binding RoundName}"
                                       HorizontalAlignment="Center" Foreground="Black" />

                            <ItemsControl ItemsSource="{Binding RoundMatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Grid Height="40">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="16" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black"
                                                    BorderThickness="0,0,0,1">

                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource LeftLineVis}">
                                                        <Binding Path="DataContext"
                                                                 RelativeSource="{RelativeSource Mode=Self}" />
                                                        <Binding Path="DataContext.SelectedGroup"
                                                                 ElementName="RootControl" />
                                                    </MultiBinding>
                                                </Border.Visibility>

                                            </Border>

                                            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Grid.RowSpan="2"
                                                    BorderBrush="Black" BorderThickness="1" />

                                            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BorderBrush="Black"
                                                    BorderThickness="0,0,1,0" />
                                            <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black"
                                                    BorderThickness="0,0,0,1" />

                                            <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                                       Foreground="Black"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Text="{Binding MatchNumber}" />

                                            <TextBlock Grid.Row="0" Grid.Column="2" Foreground="Black"
                                                       Text="{Binding Path=WrestlerInRed.LastFirstNameShort}"
                                                       Margin="5,0,5,0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       MinWidth="60" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Foreground="Black"
                                                       Text="{Binding Path=WrestlerInBlue.LastFirstNameShort}"
                                                       Margin="5,0,5,0" 
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       MinWidth="60" />

                                            <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" BorderBrush="Black"
                                                    BorderThickness="1,0,0,0" />
                                            <Border Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" BorderBrush="Black"
                                                    BorderThickness="1,0,0,0" />

                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PointsRed}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Foreground="Black" />
                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PointsBlue}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Foreground="Black" />

                                            <Grid Grid.Row="0" Grid.Column="4"
                                                  Visibility="{Binding IsMatchCompleted, Converter={StaticResource BoolToVis}}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">

                                                <materialDesign:PackIcon Kind="CheckboxMarked"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0" Padding="0"
                                                                         Visibility="{Binding IsRedWon, Converter={StaticResource BoolToVis}}"
                                                                         Height="16" Width="16" />
                                            </Grid>

                                            <Grid Grid.Row="1" Grid.Column="4"
                                                  Visibility="{Binding IsMatchCompleted, Converter={StaticResource BoolToVis}}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                                                <materialDesign:PackIcon Kind="CheckboxMarked"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0" Padding="0"
                                                                         Visibility="{Binding IsBlueWon, Converter={StaticResource BoolToVis}}"
                                                                         Height="16" Width="16" />
                                            </Grid>
                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid Margin="0, 20, 0, 0">
            <ListView ItemsSource="{Binding Path=GroupWrestlers}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.CanContentScroll="True" HorizontalContentAlignment="Stretch">
                <ListView.View>
                    <GridView AllowsColumnReorder="true">
                        <GridViewColumn Width="60">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Место" HorizontalContentAlignment="Center" Padding="0"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Order}" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,0,0"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="250">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="ФИО" HorizontalContentAlignment="Center" Padding="0"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AthleteName}" 
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Bottom"
                                      Margin="8,8,0,0"
                                      TextWrapping="Wrap"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="120">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Команда" HorizontalContentAlignment="Center" Padding="0"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TeamName}" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,0,0"
                                      TextWrapping="Wrap"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="60">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Г.р." HorizontalContentAlignment="Center" Padding="0"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BirthYear}" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,0,0"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="60">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Разряд" HorizontalContentAlignment="Center" Padding="0"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Level}" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,0,0"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="60">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Вес" HorizontalContentAlignment="Center" Padding="0"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Weight}" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,8,0"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="60">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="Жребий" HorizontalContentAlignment="Center" Padding="0"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SeedNumber}" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,0,0"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <Grid Margin="0,30,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0"
                        TextWrapping="NoWrap" Foreground="Black" Text="Главный судья соревнований"
                        FontSize="16" TextAlignment="Left" FontWeight="Normal" Margin="10,30,10,0" />

            <TextBlock Grid.Column="3" Grid.Row="0"
                        TextWrapping="NoWrap" Foreground="Black" Text="{Binding Path=Tournament.MainJudge}"
                        FontSize="16" TextAlignment="Right" FontWeight="Normal" Margin="10,30,10,0" MinWidth="100"/>

            <Border Grid.Row="0" Grid.Column="2" BorderThickness="0,0,0,1" BorderBrush="Black" Width="180" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                        TextWrapping="NoWrap" Foreground="Black" Text="Главный секретарь соревнований"
                        FontSize="16" TextAlignment="Left" FontWeight="Normal" Margin="10,30,10,0" />

            <TextBlock Grid.Row="1" Grid.Column="3"
                        TextWrapping="NoWrap" Foreground="Black" Text="{Binding Path=Tournament.MainSecretary}"
                        FontSize="16" TextAlignment="Right" FontWeight="Normal" Margin="10,30,10,0" MinWidth="100" />

            <Border Grid.Row="1" Grid.Column="2" BorderThickness="0,0,0,1" BorderBrush="Black" Width="180" />
        </Grid>

    </StackPanel>

</UserControl>