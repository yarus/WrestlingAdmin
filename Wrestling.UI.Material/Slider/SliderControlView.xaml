<UserControl x:Class="Wrestling.UI.Material.Slider.SliderControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:IndexConverter x:Key="IndexConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:ValueConverterGroup x:Key="InvBoolToVis">
            <converters:BoolInverterConverter />
            <converters:GroupedBoolToVisConverter />
        </converters:ValueConverterGroup>
    </UserControl.Resources>

    <Grid Margin="0" x:Name="RootControl">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="340" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="5*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <!-- MASTER: channel list -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Каналы" FontSize="18" FontWeight="SemiBold" Margin="6,8,0,8" />

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Channels}"
                     SelectedItem="{Binding SelectedChannel}"
                     HorizontalContentAlignment="Stretch"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="6,8,6,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock FontSize="12" Opacity="0.7">
                                        <Run Text="Слайдов:" />
                                        <Run Text="{Binding Path=Slides.Count, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Margin="2,0,0,0" Padding="0" Width="28" Height="28"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                            Command="{Binding ElementName=RootControl, Path=DataContext.ToggleChannelCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.ToolTip>
                                            <TextBlock>
                                                <TextBlock Text="Закрыть окно канала" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="Открыть на мониторе" Visibility="{Binding IsOpen, Converter={StaticResource InvBoolToVis}}" />
                                            </TextBlock>
                                        </Button.ToolTip>
                                        <Grid>
                                            <materialDesign:PackIcon Kind="Monitor" Width="16" Height="16" Visibility="{Binding IsOpen, Converter={StaticResource InvBoolToVis}}" />
                                            <materialDesign:PackIcon Kind="MonitorOff" Width="16" Height="16" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Button>
                                    <Button ToolTip="Переименовать" Margin="2,0,0,0" Padding="0" Width="28" Height="28"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                            Command="{Binding ElementName=RootControl, Path=DataContext.RenameChannelCommand}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" />
                                    </Button>
                                    <Button ToolTip="Удалить канал" Margin="2,0,0,0" Padding="0" Width="28" Height="28"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                            Command="{Binding ElementName=RootControl, Path=DataContext.DeleteChannelCommand}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="TrashCan" Width="16" Height="16" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{DynamicResource MaterialDesignDivider}" ShowsPreview="True" />

        <!-- DETAIL: slide editor for the selected channel -->
        <Grid Grid.Column="2" Margin="10" IsEnabled="{Binding HasSelectedChannel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Button Content="Новый слайд"
                            ToolTip="Добавить новый слайд"
                            Width="160"
                            HorizontalAlignment="Left" Margin="10,10,0,10"
                            Command="{Binding AddSlideCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Button Content="Удалить Все"
                            ToolTip="Удалить все слайды"
                            Width="160"
                            HorizontalAlignment="Left" Margin="10,10,0,10"
                            Command="{Binding DeleteAllSlidesCommand}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Margin="20,0,30,0" FontSize="16" VerticalAlignment="Center" Text="{Binding SelectedChannel.Name, StringFormat={}Канал: {0}}" />

                <TextBlock Grid.Column="3" Margin="10,0,20,0" FontSize="14" VerticalAlignment="Center">
                    <Run Text="Слайдов:" />
                    <Run Text="{Binding Path=Slides.Count, Mode=OneWay}" />
                </TextBlock>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,20,0">
                    <ToggleButton Style="{DynamicResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" ToolTip="Вкл/выкл переключение слайдов в превью" IsChecked="{Binding Path=Host.IsTimerEnabled}" IsEnabled="{Binding CanToggleTimer}" />
                    <TextBlock FontSize="14" VerticalAlignment="Center" Text="Превью:" Margin="10,0,10,0" />
                    <TextBlock FontSize="14" VerticalAlignment="Center" Text="{Binding Path=Host.CurrentSecond, Mode=OneWay}" MinWidth="20" />
                </StackPanel>
            </Grid>

            <ListView Grid.Row="1" ItemsSource="{Binding Slides}" SelectedItem="{Binding Path=Host.CurrentSlide}" x:Name="SlidesSource">
                <ListView.View>
                    <GridView AllowsColumnReorder="true">
                        <GridViewColumn Header="#">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,5,0,0" Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Converter={StaticResource IndexConverter}, ConverterParameter=1}" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Название" Width="Auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Margin="0,5,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Тип" Width="Auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SlideType}" Margin="0,5,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Длительность (с)" Width="Auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Duration}" Margin="0,5,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="Auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" Orientation="Horizontal">
                                        <Button ToolTip="Переместить слайд выше по списку" Margin="20,0,0,0" Padding="0" Width="22" Height="22"
                                                Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                Command="{Binding ElementName=RootControl, Path=DataContext.UpSlideCommand}"
                                                CommandParameter="{Binding }" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ArrowUp" Width="22" Height="22" Margin="0" Padding="0" />
                                        </Button>

                                        <Button ToolTip="Переместить слайд ниже по списку" Margin="20,0,0,0" Padding="0" Width="22" Height="22"
                                                Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                Command="{Binding ElementName=RootControl, Path=DataContext.DownSlideCommand}"
                                                CommandParameter="{Binding }" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ArrowDown" Width="22" Height="22" Margin="0" Padding="0" />
                                        </Button>

                                        <Button ToolTip="Редактировать слайд" Margin="20,0,0,0" Padding="0" Width="22" Height="22"
                                                Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                Command="{Binding ElementName=RootControl, Path=DataContext.EditSlideCommand}"
                                                CommandParameter="{Binding }" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="BorderColor" Width="22" Height="22" Margin="0" Padding="0" />
                                        </Button>

                                        <Button ToolTip="Удалить слайд" Margin="20,0,0,0" Padding="0" Width="22" Height="22"
                                                Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                Command="{Binding ElementName=RootControl, Path=DataContext.DeleteSlideCommand}"
                                                CommandParameter="{Binding }" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Close" Width="22" Height="22" Margin="0" Padding="0" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>

                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction
                            Command="{Binding ElementName=RootControl, Path=DataContext.EditSlideCommand}"
                            CommandParameter="{Binding Path=SelectedItem, ElementName=SlidesSource}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
