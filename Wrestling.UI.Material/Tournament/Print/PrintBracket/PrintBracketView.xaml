<UserControl x:Class="Wrestling.UI.Material.Tournament.Print.PrintBracket.PrintBracketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Material.Utils.Converters"
             xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
             mc:Ignorable="d" Foreground="Black" Background="LightGray"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters1:ValueConverterGroup x:Key="InvBoolToVis"
                                         xmlns:converters1="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils">
            <converters1:BoolInverterConverter />
            <converters1:GroupedBoolToVisConverter />
        </converters1:ValueConverterGroup>
        <converters2:MultiBoolAndToVisConverter x:Key="MultiBoolAndToVis"
                                                xmlns:converters2="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils" />
        <converters:BracketCellLineHeightConverter x:Key="BracketCellHeight" />
        <converters:BracketCellLeftLineVisConverter x:Key="LeftLineVis" />
        <converters:BracketColumnTopMarginConverter x:Key="BracketColTopMargin" />
        <converters:BracketRoundVertLineVisibilityConverter x:Key="VertVis" />
        <converters:OptionalImagePathConverter x:Key="OptionalImage" />
        <converters:FullNameToShortConverter x:Key="ShortName" />

        <!-- Tight column-header style: collapse Material Design's default padding
             so a 6-char "Разряд" actually fits inside a 60-DIP column. The default
             style added ~12 DIP padding on each side which clipped narrow headers
             into invisible width. Mirrors the pattern used in PrintPersonalResultsView
             and PrintApplicationsView. -->
        <Style x:Key="CompactColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Padding" Value="2,0,2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel Background="White" x:Name="RootControl">
        <TextBlock Text="{Binding Tournament.Name}"
                   TextWrapping="Wrap" Foreground="Black"
                   FontSize="32" TextAlignment="Center" FontWeight="Normal" />

        <Grid Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" TextWrapping="NoWrap" Foreground="Black"
                       Text="{Binding Tournament.StartDate, StringFormat={}{0:d}}" FontSize="16" TextAlignment="Left"
                       FontWeight="Normal" />

            <TextBlock Grid.Row="0" Grid.Column="1"
                       TextWrapping="NoWrap" Foreground="Black" Text="{loc:Loc AddGroup_Title}"
                       FontSize="16" TextAlignment="Right" FontWeight="Normal" />

        </Grid>

        <Grid Margin="10,5,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       TextWrapping="NoWrap" Foreground="Black" Text="{Binding Path=SelectedGroup.MatLabel}"
                       FontSize="16" TextAlignment="Left" FontWeight="Normal" />

            <TextBlock Grid.Row="0" Grid.Column="1"
                       TextWrapping="NoWrap" Foreground="Black" Text="{Binding Path=SelectedGroup.Name}"
                       FontSize="16" TextAlignment="Right" FontWeight="Normal" />
        </Grid>

        <TextBlock
            TextWrapping="NoWrap" Foreground="Black" Text="{Binding ProtocolTitle}"
            FontSize="36" TextAlignment="Center" FontWeight="Normal" Margin="10,5,10,0" />

        <Border BorderBrush="Black" BorderThickness="0,1,0,0" />

        <Grid Margin="0">
            <ItemsControl ItemsSource="{Binding GroupMainRounds}" Margin="0,10,10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0">
                            <TextBlock x:Name="RoundLabel" Text="{loc:LocRound RoundName}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Margin>
                                    <MultiBinding Converter="{StaticResource BracketColTopMargin}">
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource Mode=Self}" />
                                        <Binding Path="DataContext.SelectedGroup" ElementName="RootControl" />
                                    </MultiBinding>
                                </TextBlock.Margin>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding RoundMatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40" />
                                                <RowDefinition>
                                                    <RowDefinition.Height>
                                                        <MultiBinding Converter="{StaticResource BracketCellHeight}">
                                                            <Binding Path="DataContext"
                                                                     RelativeSource="{RelativeSource Mode=Self}" />
                                                            <Binding Path="DataContext.SelectedGroup"
                                                                     ElementName="RootControl" />
                                                        </MultiBinding>
                                                    </RowDefinition.Height>
                                                </RowDefinition>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="16" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black"
                                                        BorderThickness="0,0,0,1">

                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource LeftLineVis}">
                                                            <Binding Path="DataContext"
                                                                     RelativeSource="{RelativeSource Mode=Self}" />
                                                            <Binding Path="DataContext.SelectedGroup"
                                                                     ElementName="RootControl" />
                                                        </MultiBinding>
                                                    </Border.Visibility>

                                                </Border>

                                                <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                                                        Grid.RowSpan="2" BorderBrush="Black" BorderThickness="1" />

                                                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                                        BorderBrush="Black" BorderThickness="0,0,1,0" />
                                                <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black"
                                                        BorderThickness="0,0,0,1" />

                                                <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Margin="2"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding MatchNumber}" Foreground="Black" />

                                                <TextBlock Grid.Row="0" Grid.Column="2"
                                                           Text="{Binding Path=WrestlerInRed.LastFirstNameShort}"
                                                           Foreground="Black" VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"
                                                           MinWidth="60" />
                                                <TextBlock Grid.Row="1" Grid.Column="2"
                                                           Text="{Binding Path=WrestlerInBlue.LastFirstNameShort}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                                           Foreground="Black"
                                                           MinWidth="60" />

                                                <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"
                                                        BorderBrush="Black" BorderThickness="1,0,0,0" />
                                                <Border Grid.Row="0" Grid.Column="4" Grid.RowSpan="2"
                                                        BorderBrush="Black" BorderThickness="1,0,0,0" />

                                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PointsRed}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Foreground="Black" />
                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PointsBlue}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Foreground="Black" />

                                                <Grid Grid.Row="0" Grid.Column="4"
                                                      Visibility="{Binding IsMatchCompleted, Converter={StaticResource BoolToVis}}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Margin="0">

                                                    <materialDesign:PackIcon Kind="CheckboxMarked"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0" Padding="0"
                                                                             Height="16" Width="16">
                                                        <materialDesign:PackIcon.Visibility>
                                                            <MultiBinding Converter="{StaticResource MultiBoolAndToVis}" ConverterParameter="1">
                                                                <Binding Path="IsRedWon" />
                                                                <Binding Path="WrestlerInRed.IsDisqualified" />
                                                            </MultiBinding>
                                                        </materialDesign:PackIcon.Visibility>
                                                    </materialDesign:PackIcon>
                                                    <materialDesign:PackIcon Kind="CloseOctagon"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0" Padding="0"
                                                                             Foreground="Black"
                                                                             ToolTip="{loc:Loc Print_Dsq_Tooltip}"
                                                                             Height="20" Width="20">
                                                        <materialDesign:PackIcon.Visibility>
                                                            <MultiBinding Converter="{StaticResource MultiBoolAndToVis}">
                                                                <Binding Path="IsRedWon" />
                                                                <Binding Path="WrestlerInRed.IsDisqualified" />
                                                            </MultiBinding>
                                                        </materialDesign:PackIcon.Visibility>
                                                    </materialDesign:PackIcon>
                                                </Grid>

                                                <Grid Grid.Row="1" Grid.Column="4"
                                                      Visibility="{Binding IsMatchCompleted, Converter={StaticResource BoolToVis}}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Margin="0">
                                                    <materialDesign:PackIcon Kind="CheckboxMarked"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0" Padding="0"
                                                                             Height="16" Width="16">
                                                        <materialDesign:PackIcon.Visibility>
                                                            <MultiBinding Converter="{StaticResource MultiBoolAndToVis}" ConverterParameter="1">
                                                                <Binding Path="IsBlueWon" />
                                                                <Binding Path="WrestlerInBlue.IsDisqualified" />
                                                            </MultiBinding>
                                                        </materialDesign:PackIcon.Visibility>
                                                    </materialDesign:PackIcon>
                                                    <materialDesign:PackIcon Kind="CloseOctagon"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0" Padding="0"
                                                                             Foreground="Black"
                                                                             ToolTip="{loc:Loc Print_Dsq_Tooltip}"
                                                                             Height="20" Width="20">
                                                        <materialDesign:PackIcon.Visibility>
                                                            <MultiBinding Converter="{StaticResource MultiBoolAndToVis}">
                                                                <Binding Path="IsBlueWon" />
                                                                <Binding Path="WrestlerInBlue.IsDisqualified" />
                                                            </MultiBinding>
                                                        </materialDesign:PackIcon.Visibility>
                                                    </materialDesign:PackIcon>
                                                </Grid>

                                                <Grid Grid.Row="0" Grid.Column="4" Grid.RowSpan="2"
                                                      Visibility="{Binding IsMutualDisqualify, Converter={StaticResource BoolToVis}}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Margin="0">
                                                    <materialDesign:PackIcon Kind="CloseOctagon"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0" Padding="0"
                                                                             Foreground="Black"
                                                                             Height="20" Width="20" />
                                                </Grid>
                                            </Grid>

                                            <Grid Row="1">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*" />
                                                    <RowDefinition Height="1*" />
                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                                        BorderBrush="Black" BorderThickness="0,0,1,0">
                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource VertVis}">
                                                            <Binding Path="DataContext"
                                                                     RelativeSource="{RelativeSource Mode=Self}" />
                                                            <Binding Path="DataContext" ElementName="RoundLabel" />
                                                            <Binding Path="DataContext.SelectedGroup"
                                                                     ElementName="RootControl" />
                                                        </MultiBinding>
                                                    </Border.Visibility>
                                                </Border>
                                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black"
                                                        BorderThickness="0,0,0,1">
                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource VertVis}">
                                                            <Binding Path="DataContext"
                                                                     RelativeSource="{RelativeSource Mode=Self}" />
                                                            <Binding Path="DataContext" ElementName="RoundLabel" />
                                                            <Binding Path="DataContext.SelectedGroup"
                                                                     ElementName="RootControl" />
                                                        </MultiBinding>
                                                    </Border.Visibility>
                                                </Border>

                                            </Grid>

                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid Margin="0,0,40,0">
            <ItemsControl ItemsSource="{Binding GroupAdditoinalRounds}" HorizontalAlignment="Right"
                          VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0">
                            <TextBlock x:Name="RoundLabel" Text="{loc:LocRound RoundName}"
                                       HorizontalAlignment="Center" Foreground="Black" />

                            <ItemsControl ItemsSource="{Binding RoundMatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Grid Height="40">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="16" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black"
                                                    BorderThickness="0,0,0,1">

                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource LeftLineVis}">
                                                        <Binding Path="DataContext"
                                                                 RelativeSource="{RelativeSource Mode=Self}" />
                                                        <Binding Path="DataContext.SelectedGroup"
                                                                 ElementName="RootControl" />
                                                    </MultiBinding>
                                                </Border.Visibility>

                                            </Border>

                                            <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Grid.RowSpan="2"
                                                    BorderBrush="Black" BorderThickness="1" />

                                            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BorderBrush="Black"
                                                    BorderThickness="0,0,1,0" />
                                            <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black"
                                                    BorderThickness="0,0,0,1" />

                                            <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                                       Foreground="Black"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Text="{Binding MatchNumber}" />

                                            <TextBlock Grid.Row="0" Grid.Column="2" Foreground="Black"
                                                       Text="{Binding Path=WrestlerInRed.LastFirstNameShort}"
                                                       Margin="5,0,5,0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       MinWidth="60" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Foreground="Black"
                                                       Text="{Binding Path=WrestlerInBlue.LastFirstNameShort}"
                                                       Margin="5,0,5,0" 
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       MinWidth="60" />

                                            <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" BorderBrush="Black"
                                                    BorderThickness="1,0,0,0" />
                                            <Border Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" BorderBrush="Black"
                                                    BorderThickness="1,0,0,0" />

                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PointsRed}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Foreground="Black" />
                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PointsBlue}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Foreground="Black" />

                                            <Grid Grid.Row="0" Grid.Column="4"
                                                  Visibility="{Binding IsMatchCompleted, Converter={StaticResource BoolToVis}}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">

                                                <materialDesign:PackIcon Kind="CheckboxMarked"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0" Padding="0"
                                                                         Height="16" Width="16">
                                                    <materialDesign:PackIcon.Visibility>
                                                        <MultiBinding Converter="{StaticResource MultiBoolAndToVis}" ConverterParameter="1">
                                                            <Binding Path="IsRedWon" />
                                                            <Binding Path="WrestlerInRed.IsDisqualified" />
                                                        </MultiBinding>
                                                    </materialDesign:PackIcon.Visibility>
                                                </materialDesign:PackIcon>
                                                <materialDesign:PackIcon Kind="CloseOctagon"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0" Padding="0"
                                                                         Foreground="Black"
                                                                         ToolTip="{loc:Loc Print_Dsq_Tooltip}"
                                                                         Height="20" Width="20">
                                                    <materialDesign:PackIcon.Visibility>
                                                        <MultiBinding Converter="{StaticResource MultiBoolAndToVis}">
                                                            <Binding Path="IsRedWon" />
                                                            <Binding Path="WrestlerInRed.IsDisqualified" />
                                                        </MultiBinding>
                                                    </materialDesign:PackIcon.Visibility>
                                                </materialDesign:PackIcon>
                                            </Grid>

                                            <Grid Grid.Row="1" Grid.Column="4"
                                                  Visibility="{Binding IsMatchCompleted, Converter={StaticResource BoolToVis}}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                                                <materialDesign:PackIcon Kind="CheckboxMarked"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0" Padding="0"
                                                                         Height="16" Width="16">
                                                    <materialDesign:PackIcon.Visibility>
                                                        <MultiBinding Converter="{StaticResource MultiBoolAndToVis}" ConverterParameter="1">
                                                            <Binding Path="IsBlueWon" />
                                                            <Binding Path="WrestlerInBlue.IsDisqualified" />
                                                        </MultiBinding>
                                                    </materialDesign:PackIcon.Visibility>
                                                </materialDesign:PackIcon>
                                                <materialDesign:PackIcon Kind="CloseOctagon"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0" Padding="0"
                                                                         Foreground="Black"
                                                                         ToolTip="{loc:Loc Print_Dsq_Tooltip}"
                                                                         Height="20" Width="20">
                                                    <materialDesign:PackIcon.Visibility>
                                                        <MultiBinding Converter="{StaticResource MultiBoolAndToVis}">
                                                            <Binding Path="IsBlueWon" />
                                                            <Binding Path="WrestlerInBlue.IsDisqualified" />
                                                        </MultiBinding>
                                                    </materialDesign:PackIcon.Visibility>
                                                </materialDesign:PackIcon>
                                            </Grid>
                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid Margin="0, 10, 0, 0">
            <!-- Results variant: Место first, no Жребий column hidden but Жребий
                 still appears at the right for context. -->
            <ListView ItemsSource="{Binding Path=GroupWrestlers}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.CanContentScroll="False" HorizontalContentAlignment="Stretch"
              VirtualizingPanel.IsVirtualizing="False"
              Visibility="{Binding IsDrawProtocol, Converter={StaticResource InvBoolToVis}}">
                <ListView.View>
                    <GridView AllowsColumnReorder="false" ColumnHeaderContainerStyle="{StaticResource CompactColumnHeader}">
                        <GridViewColumn Header="{loc:Loc Personal_Column_Place}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding Order}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Bottom"
                                          Margin="0,8,0,0"
                                          FontSize="14"
                                          Visibility="{Binding IsDisqualified, Converter={StaticResource InvBoolToVis}}"/>
                                        <TextBlock Text="DSQ"
                                          Foreground="Black" FontWeight="Bold"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Bottom"
                                          Margin="0,8,0,0"
                                          FontSize="14"
                                          Visibility="{Binding IsDisqualified, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Applications_Column_FullName}" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AthleteName}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Bottom"
                                      Margin="8,8,0,0"
                                      TextWrapping="Wrap"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Draw_Column_Team}" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TeamName}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,0,0"
                                      TextWrapping="Wrap"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Applications_Column_BirthYear}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BirthYear}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,0,0"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Applications_Column_Level}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Level}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,0,0"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Applications_Column_Weight}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Weight}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,8,0"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc PrintBracket_Column_Lot}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SeedNumber}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,0,0"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Draw-protocol variant: Жребий first, Место column dropped. -->
            <ListView ItemsSource="{Binding Path=GroupWrestlers}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.CanContentScroll="False" HorizontalContentAlignment="Stretch"
              VirtualizingPanel.IsVirtualizing="False"
              Visibility="{Binding IsDrawProtocol, Converter={StaticResource BoolToVis}}">
                <ListView.View>
                    <GridView AllowsColumnReorder="false" ColumnHeaderContainerStyle="{StaticResource CompactColumnHeader}">
                        <GridViewColumn Header="{loc:Loc PrintBracket_Column_Lot}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SeedNumber}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,0,0"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Applications_Column_FullName}" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AthleteName}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Bottom"
                                      Margin="8,8,0,0"
                                      TextWrapping="Wrap"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Draw_Column_Team}" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TeamName}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,0,0"
                                      TextWrapping="Wrap"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Applications_Column_BirthYear}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BirthYear}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,0,0"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Applications_Column_Level}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Level}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,0,0"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="{loc:Loc Applications_Column_Weight}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Weight}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,8,8,0"
                                      FontSize="14"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <Grid Margin="0,5,0,5">
            <!-- Inner Grid sizes by text rows only — image is a sibling and
                 doesn't expand row heights. VerticalAlignment="Center" centers
                 the text rows within the outer Grid's height (determined by
                 the taller image), so the stamp midline lands between the
                 judge and secretary rows instead of below them. -->
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0"
                            TextWrapping="NoWrap" Foreground="Black" Text="{loc:Loc Details_Judge_Header}"
                            FontSize="16" TextAlignment="Left" FontWeight="Normal" Margin="10,30,10,0" />

                <TextBlock Grid.Column="2" Grid.Row="0"
                            TextWrapping="NoWrap" Foreground="Black"
                            Text="{Binding Path=Tournament.MainJudge, Converter={StaticResource ShortName}}"
                            FontSize="16" TextAlignment="Right" FontWeight="Normal" Margin="10,30,10,0" MinWidth="100"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                            TextWrapping="NoWrap" Foreground="Black" Text="{loc:Loc Details_Secretary_Header}"
                            FontSize="16" TextAlignment="Left" FontWeight="Normal" Margin="10,30,10,0" />

                <TextBlock Grid.Row="1" Grid.Column="2"
                            TextWrapping="NoWrap" Foreground="Black"
                            Text="{Binding Path=Tournament.MainSecretary, Converter={StaticResource ShortName}}"
                            FontSize="16" TextAlignment="Right" FontWeight="Normal" Margin="10,30,10,0" MinWidth="100" />
            </Grid>

            <!-- Stamp + signatures sibling of the inner Grid in this single-cell
                 outer Grid. Image position is independent of inner row sizing —
                 rows stay compact regardless of stamp height. Image rendered
                 last → on top in z-order (relevant only if the user's image has
                 transparent background; with opaque white bg it's irrelevant). -->
            <Image Source="{Binding Path=Tournament.Settings.SignatureFooterImagePath, Converter={StaticResource OptionalImage}}"
                   Stretch="Uniform"
                   Height="150"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,30,0,0"
                   IsHitTestVisible="False" />
        </Grid>

    </StackPanel>

</UserControl>