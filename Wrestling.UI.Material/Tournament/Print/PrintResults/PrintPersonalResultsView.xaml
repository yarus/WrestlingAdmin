<UserControl x:Class="Wrestling.UI.Material.Tournament.Print.PrintResults.PrintPersonalResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             mc:Ignorable="d" Foreground="Black" Background="LightGray"
             d:DesignHeight="800" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:IndexConverter x:Key="IndexConverter" />

        <CollectionViewSource x:Key="WrestlersGroup" Source="{Binding Path=Results}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <StackPanel Background="White">
        <TextBlock Text="{Binding Tournament.Name}"
                   TextWrapping="Wrap" Foreground="Black"
                   FontSize="36" TextAlignment="Center" FontWeight="Normal" />

        <Grid Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" TextWrapping="NoWrap" Foreground="Black"
                       Text="{Binding Tournament.StartDate, StringFormat={}{0:d}}" FontSize="16" TextAlignment="Left"
                       FontWeight="Normal" />

            <TextBlock Grid.Row="0" Grid.Column="1"
                       TextWrapping="NoWrap" Foreground="Black" Text="{Binding Path=Tournament.City}"
                       FontSize="16" TextAlignment="Right" FontWeight="Normal" />

        </Grid>

        <TextBlock
            TextWrapping="NoWrap" Foreground="Black" Text="Итоги Cоревнований"
            FontSize="36" TextAlignment="Center" FontWeight="Normal" Margin="10,10,10,0" />

        <Border BorderBrush="Black" BorderThickness="0,1,0,0" />

        <ListView Grid.Row="4" Grid.Column="0" Margin="10"
                      DataContext="{StaticResource WrestlersGroup}"
                      ItemsSource="{Binding IsAsync=True}">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Margin" Value="0,0,0,5" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Text="{Binding Path=Name}" />
                                            <ItemsPresenter />
                                        </StackPanel>                                        
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListView.GroupStyle>

            <ListView.View>
                <GridView AllowsColumnReorder="true">
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Wrestler.FinalPlace}" Header="#" Width="Auto" />
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Wrestler.FullName}" Header="ФИО" Width="Auto" />
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Wrestler.TeamName}" Header="Команда" Width="Auto" />
                    <GridViewColumn DisplayMemberBinding="{Binding Path=MatchesCount}" Header="Схваток" Width="Auto" />
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Wins}" Header="Побед" Width="Auto" />
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Loses}" Header="Поражений" Width="Auto" />
                </GridView>

            </ListView.View>
        </ListView>

        <Grid Margin="0,40,0,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0"
                       TextWrapping="NoWrap" Foreground="Black" Text="Главный судья соревнований"
                       FontSize="16" TextAlignment="Left" FontWeight="Normal" Margin="10,10,10,0" />

            <TextBlock Grid.Column="2" Grid.Row="0"
                       TextWrapping="NoWrap" Foreground="Black" Text="{Binding Path=Tournament.MainJudge}"
                       FontSize="16" TextAlignment="Right" FontWeight="Normal" Margin="10,10,10,0" />

            <Border Grid.Row="0" Grid.Column="1" BorderThickness="0,0,0,1" BorderBrush="Black" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       TextWrapping="NoWrap" Foreground="Black" Text="Главный секретарь соревнований"
                       FontSize="16" TextAlignment="Left" FontWeight="Normal" Margin="10,40,10,0" />

            <TextBlock Grid.Row="1" Grid.Column="2"
                       TextWrapping="NoWrap" Foreground="Black" Text="{Binding Path=Tournament.MainSecretary}"
                       FontSize="16" TextAlignment="Right" FontWeight="Normal" Margin="10,40,10,0" />

            <Border Grid.Row="1" Grid.Column="1" BorderThickness="0,0,0,1" BorderBrush="Black" />
        </Grid>

    </StackPanel>

</UserControl>