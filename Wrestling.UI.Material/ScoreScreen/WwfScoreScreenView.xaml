<model:PanelViewBase x:Class="Wrestling.UI.Material.ScoreScreen.WwfScoreScreenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters1="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
        xmlns:converters2="clr-namespace:Wrestling.UI.Material.Utils.Converters"
        xmlns:model="clr-namespace:Wrestling.UI.Material.Model"
        Icon="../Resources/scoreboard.ico"
        Title="Электронное табло" Height="600" Width="800" Foreground="White" Background="Black" WindowStartupLocation="Manual">

    <model:PanelViewBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters1:UpperCaseConverter x:Key="UpperCaseConverter" />
        <converters2:WarningNumberToRectVisibilityConverter x:Key="WarningVisConverter" />
        <converters2:PathToImageConverter x:Key="ClubToIconConverter" />
        <converters1:BoolToBrushConverter x:Key="BoolHighlight" />

        <converters1:ValueConverterGroup x:Key="InvBoolToVis">
            <converters1:BoolInverterConverter />
            <converters1:GroupedBoolToVisConverter />
        </converters1:ValueConverterGroup>

        <converters1:ValueConverterGroup x:Key="LastNameConverter">
            <!-- <converters2:FullNameToLastNameConverter /> -->
            <converters1:UpperCaseConverter />
        </converters1:ValueConverterGroup>

    </model:PanelViewBase.Resources>

    <Border BorderThickness="1" BorderBrush="White">
        <Grid>
            <Grid Visibility="{Binding IsWinnerDialogVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="1" Grid.Column="1" BorderBrush="White" BorderThickness="5" Background="{Binding WinnerColorBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                            
                        <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0">
                            <TextBlock>ПОБЕДИТЕЛЬ!</TextBlock>
                        </Viewbox>
                            
                        <Viewbox Stretch="Uniform" Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="{Binding Winner.LastFirstName, Converter={StaticResource UpperCaseConverter}}"/>
                        </Viewbox>
                            
                        <Viewbox Grid.Row="2" Grid.Column="0" Stretch="Uniform">
                            <Image Source="{Binding Path=WinnerTeamEmblem, Converter={StaticResource ClubToIconConverter}, ConverterParameter=DefaultLogo.png}" Stretch="UniformToFill" />
                        </Viewbox>

                        <Viewbox Grid.Row="3" Grid.Column="0" Stretch="Uniform">
                            <TextBlock Text="{Binding Winner.TeamName, Converter={StaticResource UpperCaseConverter}}"/>
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsMainScreenVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"></RowDefinition>
                    <RowDefinition Height="4*"></RowDefinition>
                    <RowDefinition Height="2*"></RowDefinition>
                    <RowDefinition Height="6*"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Margin="10,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GroupLabel, Converter={StaticResource UpperCaseConverter}}"/>
                    </Viewbox>

                    <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="Yellow"></Border>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Foreground="Black" FontWeight="Bold" Text="{Binding MatchFullNumber}" />
                    </Viewbox>

                    <Border Grid.Row="0" Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="2" Margin="10,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RoundName, Converter={StaticResource UpperCaseConverter}}"/>
                    </Viewbox>
                </Grid>

                <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="White"></Border>

                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Stretch="UniformToFill" Margin="10" Source="{Binding Wrestler1TeamEmblem, Converter={StaticResource ClubToIconConverter}, ConverterParameter=DefaultLogo.png}" />
                    </Viewbox>

                    <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Grid Grid.Row="0" Grid.Column="1" Margin="10,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Wrestler1TeamCity, Converter={StaticResource UpperCaseConverter}}"/>
                        </Viewbox>
                        <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Wrestler1TeamName, Converter={StaticResource UpperCaseConverter}}"/>
                        </Viewbox>
                    </Grid>

                    <Border Grid.Row="0" Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Grid Grid.Row="0" Grid.Column="2" Margin="10,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Wrestler2TeamCity, Converter={StaticResource UpperCaseConverter}}"/>
                        </Viewbox>
                        <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Wrestler2TeamName, Converter={StaticResource UpperCaseConverter}}"/>
                        </Viewbox>
                    </Grid>

                    <Border Grid.Row="0" Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="1" Background="White" VerticalAlignment="Center"/>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Stretch="UniformToFill" Margin="10" Source="{Binding Wrestler2TeamEmblem, Converter={StaticResource ClubToIconConverter}, ConverterParameter=DefaultLogo.png}" />
                    </Viewbox>
                </Grid>

                <Border Grid.Row="1" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="White"></Border>

                <Grid Grid.Row="2" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16*" />
                        <ColumnDefinition Width="16*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <Rectangle Grid.Row="0" Grid.Column="0" Margin="3" Fill="Yellow" Visibility="{Binding Wrestler1WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=1}" />

                        <!-- <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="Black"></Border> -->

                        <Rectangle Grid.Row="1" Grid.Column="0" Margin="3" Fill="Yellow" Visibility="{Binding Wrestler1WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=2}" />

                        <!-- <Border Grid.Row="1" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="Black"></Border> -->

                        <Rectangle Grid.Row="2" Grid.Column="0" Margin="3" Fill="Yellow" Visibility="{Binding Wrestler1WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=3}" />

                    </Grid>

                    <!-- <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="White"></Border> -->

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="1" Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center" 
                             Visibility="{Binding IsAction1TimerEnabled, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="{Binding Wrestler1, Converter={StaticResource LastNameConverter}}"/>
                    </Viewbox>

                    <Grid Grid.Row="0" Grid.Column="1" Visibility="{Binding IsAction1TimerEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="Yellow" BorderThickness="0,0,1,0"></Border>

                        <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TickCounterAction1, StringFormat={}{0:ss}}" Foreground="Black" FontWeight="Bold" />
                        </Viewbox>

                        <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="1" Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="ДЕЙСТВИЕ" Foreground="Yellow"/>
                        </Viewbox>
                    </Grid>

                    <Border Grid.Row="0" Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <!-- <Border Grid.Row="0" Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="White"></Border> -->

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="2" Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding IsAction2TimerEnabled, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="{Binding Wrestler2, Converter={StaticResource LastNameConverter}}"/>
                    </Viewbox>

                    <Grid Grid.Row="0" Grid.Column="2" Visibility="{Binding IsAction2TimerEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="1" Background="Yellow" BorderThickness="0,0,1,0"></Border>

                        <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="ДЕЙСТВИЕ" Foreground="Yellow"/>
                        </Viewbox>

                        <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TickCounterAction2, StringFormat={}{0:ss}}" Foreground="Black" FontWeight="Bold" />
                        </Viewbox>
                    </Grid>

                    <Grid Grid.Row="0" Grid.Column="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <Rectangle Grid.Row="0" Grid.Column="0" Margin="3" Fill="Yellow" Visibility="{Binding Wrestler2WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=1}" />

                        <!-- <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="Black"></Border> -->

                        <Rectangle Grid.Row="1" Grid.Column="0" Margin="3" Fill="Yellow" Visibility="{Binding Wrestler2WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=2}" />

                        <!-- <Border Grid.Row="1" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="Black"></Border> -->

                        <Rectangle Grid.Row="2" Grid.Column="0" Margin="3" Fill="Yellow" Visibility="{Binding Wrestler2WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=3}" />
                    </Grid>

                </Grid>

                <Border Grid.Row="2" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="White"></Border>

                <Grid Grid.Row="3" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="Red" BorderBrush="White" BorderThickness="0,0,1,0"></Border>

                    <Viewbox Grid.Row="0" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding Points1}"/>
                            <Border BorderBrush="{Binding IsPlayer1WithAdvantage, Converter={StaticResource BoolHighlight}, ConverterParameter=Yellow}" BorderThickness="0,0,0,1" Margin="1" />
                        </Grid>
                    </Viewbox>
                    
                    <Border Grid.Row="0" Grid.Column="1" Background="Black" BorderBrush="White" BorderThickness="0,0,1,0"></Border>

                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Column="0" Grid.Row="0" Background="Black" />

                        <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsTimeout, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Foreground="White">
                                <Run Text="РАУНД "/>
                                <Run Text="{Binding Round}"/>
                            </TextBlock>
                        </Viewbox>

                        <Viewbox Stretch="Uniform" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsTimeout, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ПЕРЕРЫВ" Foreground="White" />
                        </Viewbox>

                        <Border Grid.Row="0" Grid.Column="0" BorderBrush="White" BorderThickness="0,0,0,1"></Border>

                        <Viewbox Grid.Row="1" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TickCounter, StringFormat={}{0:mm':'ss}}" Foreground="White" />
                        </Viewbox>
                    </Grid>

                    <Border Grid.Row="0" Grid.Column="2" Background="#005BEC" BorderBrush="White" BorderThickness="1,0,0,0"></Border>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding Points2}"/>
                            <Border BorderBrush="{Binding IsPlayer2WithAdvantage, Converter={StaticResource BoolHighlight}, ConverterParameter=Yellow}" BorderThickness="0,0,0,1" Margin="1" />
                        </Grid>
                    </Viewbox>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</model:PanelViewBase>