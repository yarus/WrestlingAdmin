<UserControl x:Class="Wrestling.UI.Material.Tournament.Standing.Details.GenerateGroupsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:details="clr-namespace:Wrestling.UI.Material.Tournament.Standing.Details"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance details:GenerateGroupsDialogViewModel}"
             d:DesignHeight="500" d:DesignWidth="400">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="18" Margin="10 5 10 15">Генератор Категорий</TextBlock>
        
        <TextBlock Grid.Row="1" FontSize="12" TextWrapping="Wrap" Margin="10 5 10 0">
            Используйте следующий формат для генерации весовых категорий:
        </TextBlock>
        
        <TextBlock Grid.Row="2" FontSize="12" TextWrapping="Wrap" Margin="10 5 10 0" ToolTip="Данное выражение сгенерирует 5 весовых категорий для указанных возрастов">
            2010-2011:30,35,40,45,50:Ж
        </TextBlock>
        
        <TextBlock Grid.Row="3" FontSize="12" TextWrapping="Wrap" Margin="10 5 10 0">
            Для указания следующей возрастной группы перейдите на следующую строчку.
        </TextBlock>

        <Border Grid.Row="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="10,0,10,0"></Border>
        <Border Grid.Row="3" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="10,0,10,0"></Border>
        
        <TextBox Grid.Row="4" 
                 Height="100"
                 Margin="10,10,10,10"
                 VerticalAlignment="Top"
                 VerticalContentAlignment="Top"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Text="{Binding GenerateText}"
                 BorderThickness="1,1,1,1"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0 16 0 0">
            <Button IsDefault="True" Style="{DynamicResource MaterialDesignFlatButton}">
                <Button.Command>
                    <x:Static Member="materialDesign:DialogHost.CloseDialogCommand" />
                </Button.Command>
                <Button.CommandParameter>
                    <system:Boolean>True</system:Boolean>
                </Button.CommandParameter>
                СГЕНЕРИРОВАТЬ
            </Button>
            <Button IsCancel="True" Margin="8 0 0 0" Style="{DynamicResource MaterialDesignFlatButton}"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                <Button.CommandParameter>
                    <system:Boolean>False</system:Boolean>
                </Button.CommandParameter>
                ОТМЕНИТЬ
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
