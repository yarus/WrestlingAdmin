<UserControl x:Class="Wrestling.UI.Material.Tournament.Standing.Carpets.CarpetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="400" d:DesignWidth="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:IndexConverter x:Key="IndexConverter"/>
        <converters:IndexItemsConverter x:Key="ItemsIndexConverter" />

        <converters:ValueConverterGroup x:Key="InvBoolToVis">
            <converters:BoolInverterConverter />
            <converters:GroupedBoolToVisConverter />
        </converters:ValueConverterGroup>
    </UserControl.Resources>

    <Grid Margin="0" x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <Button Content="Добавить ковер"
                        ToolTip="Добавить ковер для проведения соревнований"
                        Width="160"
                        HorizontalAlignment="Left" Margin="20,10,0,10"
                        Command="{Binding AddCarpetCommand}" />
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="2" Margin="20,0,20,0" FontSize="16" VerticalAlignment="Center">
                <Run Text="Не распределенных групп:" />
                <Run Text="{Binding UnbindedGroups, Mode=OneWay}" />
            </TextBlock>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Margin="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Background="LightGray" Margin="0" Padding="0">
                            <Expander.Header>
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" TextWrapping="NoWrap" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource ItemsIndexConverter}" ConverterParameter="1">
                                                <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}" />
                                                <Binding Path="."/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1" TextWrapping="NoWrap" FontSize="16" Margin="20,0,20,0" VerticalAlignment="Center">
                                        <Run Text="{Binding Name}"></Run>
                                    </TextBlock>

                                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="20,0,20,0" FontSize="16" VerticalAlignment="Center">
                                        <Run Text="Участников:" />
                                        <Run Text="{Binding WrestlersCount, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="0" Grid.Column="3" Margin="20,0,20,0" FontSize="16" VerticalAlignment="Center">
                                        <Run Text="Поединков:" />
                                        <Run Text="{Binding MatchesCount, Mode=OneWay}" />
                                    </TextBlock>

                                    <Button Grid.Column="4" ToolTip="Редактировать информацию о ковре" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Command="{Binding Path=DataContext.EditCarpetCommand, ElementName=RootControl}" CommandParameter="{Binding }">
                                        <materialDesign:PackIcon Kind="BorderColor" Width="22" Height="22" Padding="0" />
                                    </Button>

                                    <Button Grid.Column="5" ToolTip="Удалить ковер" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Command="{Binding Path=DataContext.DeleteCarpetCommand, ElementName=RootControl}" CommandParameter="{Binding }" Margin="20,0,0,0">
                                        <materialDesign:PackIcon Kind="Close" Width="22" Height="22" Margin="0" Padding="0" />
                                    </Button>
                                </Grid>
                            </Expander.Header>
                            <Expander.Content>
                                <StackPanel Background="White" Margin="0">
                                    <Button  Content="Добавить группу" Width="160" HorizontalAlignment="Left" Margin="20,10,0,10" 
                                             ToolTip="Распределить схватки группы на данный ковер"
                                             Command="{Binding Path=DataContext.BindGroupCommand, ElementName=RootControl}" CommandParameter="{Binding }" />
                                    <ListView ItemsSource="{Binding Groups}" x:Name="GroupsSource" Margin="40,0,0,0">
                                        <ListView.View>
                                            <GridView AllowsColumnReorder="true">
                                                <GridViewColumn Header="#">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="0,5,0,0" Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Converter={StaticResource IndexConverter}, ConverterParameter=1}" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="Группа" Width="Auto">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" Margin="0,5,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="Участников" Width="Auto">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Path=Wrestlers.Count, Mode=OneWay}" Margin="0,5,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="Поединков" Width="Auto">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Path=PendingMatchesCount, Mode=OneWay}" Margin="0,5,0,0" TextWrapping="NoWrap" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>                                                
                                                
                                                <GridViewColumn Width="Auto">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" Orientation="Horizontal">
                                                                <Button ToolTip="Переместить группу выше по списку" Margin="20,0,0,0" Padding="0" Width="22" Height="22"
                                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                                        Command="{Binding ElementName=RootControl, Path=DataContext.UpGroupCommand}"
                                                                        CommandParameter="{Binding }" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <materialDesign:PackIcon Kind="ArrowUp" Width="22" Height="22" Margin="0" Padding="0" />
                                                                </Button>

                                                                <Button ToolTip="Переместить группу ниже по списку" Margin="20,0,0,0" Padding="0" Width="22" Height="22"
                                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                                        Command="{Binding ElementName=RootControl, Path=DataContext.DownGroupCommand}"
                                                                        CommandParameter="{Binding }" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <materialDesign:PackIcon Kind="ArrowDown" Width="22" Height="22" Margin="0" Padding="0" />
                                                                </Button>

                                                                <Button ToolTip="Удалить группу из распределения на данный ковер" Margin="20,0,0,0" Padding="0" Width="22" Height="22"
                                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                                        Command="{Binding ElementName=RootControl, Path=DataContext.UnbindGroupCommand}"
                                                                        CommandParameter="{Binding }" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <materialDesign:PackIcon Kind="Close" Width="22" Height="22" Margin="0" Padding="0" />
                                                                </Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>

                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <i:InvokeCommandAction
                                                    Command="{Binding ElementName=RootControl, Path=DataContext.UnbindGroupCommand}"
                                                    CommandParameter="{Binding Path=SelectedItem, ElementName=GroupsSource}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </ListView>
                                </StackPanel>
                            </Expander.Content>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</UserControl>