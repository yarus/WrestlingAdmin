<UserControl x:Class="Wrestling.UI.Material.Tournament.Print.PrintResults.PrintPointsTeamResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             mc:Ignorable="d" Foreground="Black" Background="LightGray"
             d:DesignHeight="800" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:IndexConverter x:Key="IndexConverter" />
    </UserControl.Resources>

    <StackPanel Background="White">
        <TextBlock Text="{Binding Tournament.Name}"
                   TextWrapping="Wrap" Foreground="Black"
                   FontSize="36" TextAlignment="Center" FontWeight="Normal" />

        <Grid Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" TextWrapping="NoWrap" Foreground="Black"
                       Text="{Binding Tournament.StartDate, StringFormat={}{0:d}}" FontSize="16" TextAlignment="Left"
                       FontWeight="Normal" />

            <TextBlock Grid.Row="0" Grid.Column="1"
                       TextWrapping="NoWrap" Foreground="Black" Text="{Binding Path=Tournament.City}"
                       FontSize="16" TextAlignment="Right" FontWeight="Normal" />

        </Grid>

        <TextBlock
            TextWrapping="NoWrap" Foreground="Black" Text="Командные результаты соревнований"
            FontSize="36" TextAlignment="Center" FontWeight="Normal" Margin="10,10,10,0" />

        <TextBlock
            TextWrapping="NoWrap" Foreground="Black" Text="По рейтингу Российского Борцовского Союза (РОСБОС)"
            FontSize="20" TextAlignment="Center" FontWeight="Normal" Margin="10,10,10,0" />

        <Border BorderBrush="Black" BorderThickness="0,1,0,0" />

        <ListView ItemsSource="{Binding TeamResults}">
            <ListView.View>
                <GridView AllowsColumnReorder="true">
                    <GridViewColumn Header="#" DisplayMemberBinding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Converter={StaticResource IndexConverter}, ConverterParameter=1}" />
                    <GridViewColumn DisplayMemberBinding="{Binding TeamName}" Header="Команда" Width="Auto" />
                    <GridViewColumn DisplayMemberBinding="{Binding TotalPoints}" Header="Очки" Width="Auto" />
                    <GridViewColumn DisplayMemberBinding="{Binding GoldMedals}" Header="1-е место" Width="Auto" />
                    <GridViewColumn DisplayMemberBinding="{Binding SilverMedals}" Header="2-е место" Width="Auto" />
                    <GridViewColumn DisplayMemberBinding="{Binding BronzeMedals}" Header="3-е место" Width="Auto" />
                    <GridViewColumn DisplayMemberBinding="{Binding Wrestlers}" Header="Борцов" Width="Auto" />
                    <GridViewColumn DisplayMemberBinding="{Binding GroupCount}" Header="Групп" Width="Auto" />
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Margin="0,40,0,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0"
                       TextWrapping="NoWrap" Foreground="Black" Text="Главный судья соревнований"
                       FontSize="16" TextAlignment="Left" FontWeight="Normal" Margin="10,10,10,0" />

            <TextBlock Grid.Column="2" Grid.Row="0"
                       TextWrapping="NoWrap" Foreground="Black" Text="{Binding Path=Tournament.MainJudge}"
                       FontSize="16" TextAlignment="Right" FontWeight="Normal" Margin="10,10,10,0" />

            <Border Grid.Row="0" Grid.Column="1" BorderThickness="0,0,0,1" BorderBrush="Black" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       TextWrapping="NoWrap" Foreground="Black" Text="Главный секретарь соревнований"
                       FontSize="16" TextAlignment="Left" FontWeight="Normal" Margin="10,40,10,0" />

            <TextBlock Grid.Row="1" Grid.Column="2"
                       TextWrapping="NoWrap" Foreground="Black" Text="{Binding Path=Tournament.MainSecretary}"
                       FontSize="16" TextAlignment="Right" FontWeight="Normal" Margin="10,40,10,0" />

            <Border Grid.Row="1" Grid.Column="1" BorderThickness="0,0,0,1" BorderBrush="Black" />
        </Grid>

    </StackPanel>

</UserControl>