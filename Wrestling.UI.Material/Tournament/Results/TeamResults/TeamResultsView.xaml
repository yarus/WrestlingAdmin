<UserControl x:Class="Wrestling.UI.Material.Tournament.Results.TeamResults.TeamResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:utils="clr-namespace:Wrestling.UI.Utils;assembly=Wrestling.UI.Utils"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:HighlightSelectedItemConverter x:Key="HighlightSelected" />
        <converters:IndexConverter x:Key="IndexConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,10,20,10">
            <ItemsControl ItemsSource="{Binding Systems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button ToolTip="Выбрать систему расчёта"
                                Content="{Binding Name}"
                                MinWidth="180"
                                Margin="0,0,20,0"
                                Command="{Binding Path=DataContext.ChangeSystemCommand, ElementName=RootControl}"
                                CommandParameter="{Binding}">
                            <Button.Background>
                                <MultiBinding Converter="{StaticResource HighlightSelected}">
                                    <Binding Path="DataContext.SelectedSystem" ElementName="RootControl" />
                                    <Binding Path="." />
                                </MultiBinding>
                            </Button.Background>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Row="0" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource MaterialDesignDivider}" />

        <materialDesign:Card Grid.Row="1" Margin="20,10,0,0"
                             UniformCornerRadius="4"
                             materialDesign:ElevationAssist.Elevation="Dp4">
        <ListView ItemsSource="{Binding Items}"
                  utils:GridViewSort.AutoSort="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  TextElement.FontSize="15"
                  VirtualizingPanel.IsVirtualizing="False">
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                            <Setter Property="Padding" Value="4,8,4,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="14" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>

                    <GridViewColumn Header="Место" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Converter={StaticResource IndexConverter}, ConverterParameter=1}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Команда" Width="Auto"
                                    DisplayMemberBinding="{Binding TeamName}"
                                    utils:GridViewSort.PropertyName="TeamName" />

                    <GridViewColumn Header="Город" Width="Auto"
                                    DisplayMemberBinding="{Binding TeamCity}"
                                    utils:GridViewSort.PropertyName="TeamCity" />

                    <GridViewColumn Width="60" utils:GridViewSort.PropertyName="GoldMedals">
                        <GridViewColumn.Header>
                            <materialDesign:PackIcon Kind="Medal" Width="22" Height="22"
                                                     Foreground="#FFB300" ToolTip="Золото" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GoldMedals}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="60" utils:GridViewSort.PropertyName="SilverMedals">
                        <GridViewColumn.Header>
                            <materialDesign:PackIcon Kind="Medal" Width="22" Height="22"
                                                     Foreground="#9E9E9E" ToolTip="Серебро" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SilverMedals}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="60" utils:GridViewSort.PropertyName="BronzeMedals">
                        <GridViewColumn.Header>
                            <materialDesign:PackIcon Kind="Medal" Width="22" Height="22"
                                                     Foreground="#8D6E63" ToolTip="Бронза" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BronzeMedals}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="60" utils:GridViewSort.PropertyName="TotalMedals">
                        <GridViewColumn.Header>
                            <materialDesign:PackIcon Kind="MedalOutline" Width="22" Height="22"
                                                     ToolTip="Всего медалей" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalMedals}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="60" utils:GridViewSort.PropertyName="TotalPoints">
                        <GridViewColumn.Header>
                            <materialDesign:PackIcon Kind="Star" Width="22" Height="22"
                                                     ToolTip="Очки" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalPoints}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="60" utils:GridViewSort.PropertyName="GroupCount">
                        <GridViewColumn.Header>
                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="22" Height="22"
                                                     ToolTip="Категорий" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GroupCount}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="60">
                        <GridViewColumn.Header>
                            <materialDesign:PackIcon Kind="AccountMultiple" Width="22" Height="22"
                                                     ToolTip="Борцов" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Wrestlers.Count}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        </materialDesign:Card>
    </Grid>
</UserControl>
