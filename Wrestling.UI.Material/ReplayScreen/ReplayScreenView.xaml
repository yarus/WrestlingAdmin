<UserControl x:Class="Wrestling.UI.Material.ReplayScreen.ReplayScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="White" Foreground="Black"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="480" d:DesignWidth="640">

    <UserControl.Resources>
        <converters:IndexConverter x:Key="IndexConverter" />
        <converters:FullPathToFileNameConverter x:Key="PathToNameConverter" />
        <converters:SecondsToTimeSpanConverter x:Key="SecondsToTimeSpanConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock TextWrapping="NoWrap" FontSize="18" FontWeight="Normal" Margin="10,20,10,10"> 
                <Run Text="{Binding WrestlingMatch.RoundName, Mode=OneWay}"></Run>
                <Run Text="- Поединок №"></Run>
                <Run Text="{Binding WrestlingMatch.MatchNumber, Mode=OneWay}"></Run>
            </TextBlock>

            <Grid Margin="10,10,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" BorderThickness="0,1,0,0" BorderBrush="Black" />
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="Black" />
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="Black" />
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" BorderThickness="0,0,0,1" BorderBrush="Black" />

                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" BorderThickness="1,0,0,0" BorderBrush="Black" />
                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" BorderThickness="1,0,1,0" BorderBrush="Black" />
                <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" BorderThickness="0,0,1,0" BorderBrush="Black" />
                <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="3" BorderThickness="0,0,1,0" BorderBrush="Black" />

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Борцы" Margin="5" HorizontalAlignment="Center" FontSize="16" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Команды" Margin="5" HorizontalAlignment="Center" FontSize="16" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Баллы" Margin="5" HorizontalAlignment="Center" FontSize="16" />

                <Rectangle Grid.Row="1" Grid.Column="0" Width="20" Height="20" Fill="Red" Margin="5" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Path=WrestlingMatch.WrestlerInRed.FullName, Mode=OneWay}" VerticalAlignment="Center" Margin="5" FontSize="16"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Path=WrestlingMatch.WrestlerInRed.TeamName, Mode=OneWay}" VerticalAlignment="Center" Margin="5" FontSize="16"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Path=WrestlingMatch.PointsRed}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" Margin="5" />

                <Rectangle Grid.Row="2" Grid.Column="0" Width="20" Height="20" Fill="Blue" Margin="5" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Path=WrestlingMatch.WrestlerInBlue.FullName, Mode=OneWay}" VerticalAlignment="Center" Margin="5" FontSize="16"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Path=WrestlingMatch.WrestlerInBlue.TeamName, Mode=OneWay}" VerticalAlignment="Center" Margin="5" FontSize="16"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Path=WrestlingMatch.PointsBlue}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" Margin="5" />
            </Grid>
        </StackPanel>
        
        <StackPanel Grid.Row="1">
            <TextBlock TextWrapping="NoWrap" FontSize="18" FontWeight="Normal" Margin="10,20,10,10" Text="Протокол" />

            <Grid MaxHeight="200">
                <ListView ItemsSource="{Binding Path=WrestlingMatch.MatchActions}">
                    <ListView.View>
                        <GridView AllowsColumnReorder="true">
                            <GridViewColumn DisplayMemberBinding="{Binding DateTime}" Header="#" Width="Auto"/>
                            <GridViewColumn DisplayMemberBinding="{Binding RoundNumber}" Header="Раунд" Width="Auto"/>
                            <GridViewColumn DisplayMemberBinding="{Binding SecondInRound, StringFormat={}{0:mm':'ss}, Converter={StaticResource SecondsToTimeSpanConverter}}" Header="Время" Width="Auto"/>
                            <GridViewColumn DisplayMemberBinding="{Binding Text}" Header="Детали" Width="Auto"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock TextWrapping="NoWrap" FontSize="18" FontWeight="Normal" Margin="10,20,10,20" Text="{Binding RecordingsLabel}" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ListView SelectedItem="{Binding SelectedVideo}" ItemsSource="{Binding Videos}" x:Name="VideosList"
                      Foreground="Black">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#"
                                        DisplayMemberBinding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Converter={StaticResource IndexConverter}, ConverterParameter=1}" />
                        <GridViewColumn Header="Файл">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="NoWrap"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Text="{Binding Converter={StaticResource PathToNameConverter}}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="Auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"
                                                Orientation="Horizontal">
                                        <Button ToolTip="Открыть файл в проигрывателе"
                                                Margin="0" Padding="0" Width="22"
                                                Height="22"
                                                Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                Command="{Binding ElementName=RootControl, Path=DataContext.OpenFileCommand}"
                                                CommandParameter="{Binding }"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Play" Width="22"
                                                                     Height="22" Margin="0"
                                                                     Padding="0" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </ListView>
            </ScrollViewer>
        </Grid>

    </Grid>

</UserControl>