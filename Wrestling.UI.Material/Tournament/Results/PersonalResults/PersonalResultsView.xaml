<UserControl x:Class="Wrestling.UI.Material.Tournament.Results.PersonalResults.PersonalResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:utils="clr-namespace:Wrestling.UI.Utils;assembly=Wrestling.UI.Utils"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:IndexConverter x:Key="IndexConverter" />
        <converters:IndexItemsConverter x:Key="ItemsIndexConverter" />
    </UserControl.Resources>

    <Grid Margin="0" x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        materialDesign:RippleAssist.IsCentered="True">
                <Grid Margin="20,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border BorderThickness="1" Grid.Column="1" BorderBrush="DarkGray" />

                    <Button Grid.Column="0" Style="{DynamicResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="Magnify" Opacity=".56" />
                    </Button>

                    <TextBox Grid.Column="1" Margin="8 0 0 0"
                             materialDesign:HintAssist.Hint="Поиск по фамилии"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden" BorderThickness="0"
                             MinWidth="240" VerticalAlignment="Center"
                             Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                </Grid>
            </StackPanel>

            <CheckBox Grid.Column="2" Margin="20,10,20,10" VerticalAlignment="Center"
                      IsChecked="{Binding IsOnlyMedalsVisible}">
                Только призёры
            </CheckBox>
        </Grid>

        <Border Grid.Row="0" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource MaterialDesignDivider}" />

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer CanContentScroll="False"
                                      Padding="{TemplateBinding Padding}"
                                      Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Expander Background="LightGray" Margin="0" Padding="0" x:Name="Expander"
                              IsExpanded="{Binding Path=DataContext.ShouldAutoExpand, ElementName=RootControl, Mode=OneWay}">
                        <Expander.Header>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" MinWidth="280" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" TextWrapping="NoWrap" FontSize="16"
                                           VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ItemsIndexConverter}"
                                                      ConverterParameter="1">
                                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}" />
                                            <Binding Path="." />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Column="1" TextWrapping="NoWrap" FontSize="16"
                                           Margin="20,0,20,0" VerticalAlignment="Center">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text=" — " />
                                    <Run Text="{Binding BracketLabel, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Grid.Column="3" Margin="20,0,20,0" FontSize="14" VerticalAlignment="Center">
                                    <Run Text="Участников:" />
                                    <Run Text="{Binding WrestlersCount, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Grid.Column="4" Margin="20,0,20,0" FontSize="14" VerticalAlignment="Center">
                                    <Run Text="Призёров:" />
                                    <Run Text="{Binding MedalsCount, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <StackPanel Background="White" Margin="0"
                                        Visibility="{Binding ElementName=Expander, Path=IsExpanded, Converter={StaticResource BoolToVis}}">
                                <ListView ItemsSource="{Binding Wrestlers}"
                                          Margin="40,10,40,10"
                                          utils:GridViewSort.AutoSort="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="True">
                                            <GridViewColumn Header="Место" Width="90"
                                                            utils:GridViewSort.PropertyName="Wrestler.FinalPlace">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Wrestler.FinalPlace}"
                                                                   HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="ФИО" Width="280"
                                                            DisplayMemberBinding="{Binding Wrestler.FullName}"
                                                            utils:GridViewSort.PropertyName="Wrestler.FullName" />

                                            <GridViewColumn Header="Команда" Width="220"
                                                            DisplayMemberBinding="{Binding Wrestler.TeamName}"
                                                            utils:GridViewSort.PropertyName="Wrestler.TeamName" />

                                            <GridViewColumn Header="Регион" Width="240"
                                                            DisplayMemberBinding="{Binding Wrestler.TeamCity}"
                                                            utils:GridViewSort.PropertyName="Wrestler.TeamCity" />

                                            <GridViewColumn Header="Разряд" Width="110"
                                                            DisplayMemberBinding="{Binding Wrestler.Level}"
                                                            utils:GridViewSort.PropertyName="Wrestler.Level" />

                                            <GridViewColumn Header="Квал. балл" Width="130"
                                                            utils:GridViewSort.PropertyName="OverallTournamentClassificationPoints">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding OverallTournamentClassificationPoints}"
                                                                   HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Expander.Content>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
