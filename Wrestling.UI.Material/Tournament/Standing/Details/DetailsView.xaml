<UserControl x:Class="Wrestling.UI.Material.Tournament.Standing.Details.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Material.Utils.Converters"
             xmlns:converters1="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="880" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:PathToImageConverter x:Key="ClubToIconConverter" />
        <converters1:IndexConverter x:Key="IndexConverter"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="RootControl" Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <materialDesign:Card Margin="10 5 10 5">
                        <StackPanel>
                            <StackPanel Margin="10">
                                <TextBlock Style="{DynamicResource MaterialDesignHeadlineTextBlock}">Соревнования</TextBlock>

                                <TextBox Text="{Binding Tournament.HashTag, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Хэш Тэг"
                                         TextWrapping="NoWrap" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18" />

                                <TextBox Text="{Binding Tournament.Name, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18"
                                         materialDesign:HintAssist.Hint="Название" MaxHeight="80" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <DatePicker SelectedDate="{Binding Path=Tournament.StartDate, UpdateSourceTrigger=PropertyChanged}" 
                                                materialDesign:HintAssist.Hint="Дата проведения"
                                                Style="{DynamicResource MaterialDesignFloatingHintDatePicker}"
                                                HorizontalAlignment="Left" FontSize="18" MinWidth="160" Margin="0,10,0,0" />

                                    <TextBox Grid.Column="1" 
                                             Text="{Binding Tournament.EntryFee, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Вступительный взнос" Margin="5,0,0,0"
                                             TextWrapping="NoWrap" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18" />
                                </Grid>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" 
                                             Text="{Binding Tournament.Country, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Страна" Margin="0,0,10,0"
                                             TextWrapping="NoWrap" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18" />

                                    <TextBox Grid.Column="1" 
                                             Text="{Binding Tournament.City, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Город" Margin="5,0,0,0"
                                             TextWrapping="NoWrap" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18" />

                                </Grid>

                                <TextBox Text="{Binding Tournament.Address, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18"
                                         materialDesign:HintAssist.Hint="Адрес" MaxHeight="80" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="10">
                                    <TextBlock Style="{DynamicResource MaterialDesignHeadlineTextBlock}">Главный судья</TextBlock>

                                    <TextBox Text="{Binding Tournament.MainJudge, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="ФИО"
                                             TextWrapping="NoWrap" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18" />

                                    <TextBox Text="{Binding Tournament.MainJudgeEmail, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Email"
                                             TextWrapping="NoWrap" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18" />

                                    <TextBox Text="{Binding Tournament.MainJudgePhone, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Телефон" 
                                             TextWrapping="NoWrap" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10">
                                    <TextBlock Style="{DynamicResource MaterialDesignHeadlineTextBlock}">Главный секретарь</TextBlock>

                                    <TextBox Text="{Binding Tournament.MainSecretary, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="ФИО" 
                                             TextWrapping="NoWrap" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18" />

                                    <TextBox Text="{Binding Tournament.MainSecretaryEmail, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Email" 
                                             TextWrapping="NoWrap" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18" />

                                    <TextBox Text="{Binding Tournament.MainSecretaryPhone, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Телефон"
                                             TextWrapping="NoWrap" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="10">
                                <TextBlock Style="{DynamicResource MaterialDesignHeadlineTextBlock}">Принимающая организация</TextBlock>

                                <TextBox Text="{Binding Tournament.ContactTitle, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18"
                                         materialDesign:HintAssist.Hint="Наименование" MaxHeight="80" />

                                <TextBox Text="{Binding Tournament.ContactAddress, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18"
                                         materialDesign:HintAssist.Hint="Адрес" MaxHeight="80" />

                                <TextBox Text="{Binding Tournament.ContactPerson, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18"
                                         materialDesign:HintAssist.Hint="ФИО контактного лица" />
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{Binding Tournament.ContactPhone, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Телефон" Margin="0,0,10,0"
                                             TextWrapping="NoWrap" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18" />

                                    <TextBox Grid.Column="1" Text="{Binding Tournament.ContactEmail, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Email" Margin="10,0,0,0"
                                             TextWrapping="NoWrap" Style="{DynamicResource MaterialDesignFloatingHintTextBox}" FontSize="18" />

                                </Grid>
                            </StackPanel>

                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border BorderThickness="1" BorderBrush="{DynamicResource PrimaryHueMidBrush}" MinHeight="256" ClipToBounds="True" Margin="10 5 10 5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <materialDesign:ColorZone Mode="PrimaryMid" Grid.Row="0" Effect="{DynamicResource MaterialDesignShadowDepth5}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Margin="16">Весовые категории</TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Path=Groups.Count, Mode=OneWay}" Margin="16" />
                                
                                </Grid>
                            </materialDesign:ColorZone>

                            <Button Style="{DynamicResource MaterialDesignFloatingActionMiniAccentButton}"                                
                                    Command="{Binding AddGroupCommand}"
                                    VerticalAlignment="Top" HorizontalAlignment="Right" 
                                    Grid.Row="0" Margin="0 20 28 0">
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <ListView Grid.Row="1" ItemsSource="{Binding Groups}" x:Name="GroupsSource">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="#" DisplayMemberBinding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Converter={StaticResource IndexConverter}, ConverterParameter=1}" />
                                        <GridViewColumn DisplayMemberBinding="{Binding Name}" Header="Название" />
                                        <GridViewColumn Width="Auto">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" Orientation="Horizontal">
                                                        <Button ToolTip="Редактировать данные группы" Margin="0" Padding="0" Width="22" Height="22"
                                                                Style="{DynamicResource MaterialDesignFloatingActionMiniButton}"
                                                                Command="{Binding ElementName=RootControl, Path=DataContext.EditGroupCommand}"
                                                                CommandParameter="{Binding }" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <materialDesign:PackIcon Kind="BorderColor" Width="22" Height="22" Margin="0" Padding="0" />
                                                        </Button>

                                                        <Button ToolTip="Удалить группу" Margin="20,0,0,0" Padding="0" Width="22" Height="22"
                                                                Style="{DynamicResource MaterialDesignFloatingActionMiniButton}"
                                                                Command="{Binding ElementName=RootControl, Path=DataContext.DeleteGroupCommand}"
                                                                CommandParameter="{Binding }" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <materialDesign:PackIcon Kind="Close" Width="22" Height="22" Margin="0" Padding="0" />
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        </GridView>
                                </ListView.View>

                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction
                                            Command="{Binding ElementName=RootControl, Path=DataContext.EditGroupCommand}"
                                            CommandParameter="{Binding Path=SelectedItem, ElementName=GroupsSource}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </ListView>
                            
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <Button Content="Сгенерировать"
                                        ToolTip="Сгенерировать список групп"
                                        Width="140"
                                        HorizontalAlignment="Center" 
                                        Margin="0,20,0,10"
                                        Command="{Binding GenerateGroupsCommand}" />
                            </StackPanel>
                        </Grid>
                        
                    </Border>
                
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>