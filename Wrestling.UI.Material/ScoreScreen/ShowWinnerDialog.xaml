<UserControl x:Class="Wrestling.UI.Material.ScoreScreen.ShowWinnerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
             md:DialogServiceViews.IsRegistered="True" MinWidth="800" MinHeight="600"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="600">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0" Stretch="Uniform">
            <TextBlock Text="{loc:Loc ScoreScreen_Winner}" />
        </Viewbox>

        <Border Grid.Row="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="10,0,10,0"></Border>

        <Viewbox Grid.Row="1" Stretch="Uniform">
            <TextBlock Text="{Binding Wrestler.FullName}"/>
        </Viewbox>

        <Viewbox Grid.Row="2" Stretch="Uniform">
            <Image Source="{Binding Path=EmblemPath}" Stretch="UniformToFill" />
        </Viewbox>

        <Viewbox Grid.Row="3" Stretch="Uniform">
            <TextBlock Text="{Binding Wrestler.TeamName}"/>
        </Viewbox>

    </Grid>

</UserControl>
