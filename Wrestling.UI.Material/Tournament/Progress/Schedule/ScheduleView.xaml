<UserControl x:Class="Wrestling.UI.Material.Tournament.Progress.Schedule.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
             xmlns:utils="clr-namespace:Wrestling.UI.Utils;assembly=Wrestling.UI.Utils"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="400" d:DesignWidth="600">

    <UserControl.Resources>
        <converters:IndexItemsConverter x:Key="ItemsIndexConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" Width="220"
                      Style="{DynamicResource MaterialDesignFloatingHintComboBox}"
                      materialDesign:HintAssist.Hint="{loc:Loc Slide_Mat}"
                      ItemsSource="{Binding Stats}"
                      SelectedItem="{Binding SelectedMat}"
                      DisplayMemberPath="MatLabel"
                      VerticalAlignment="Bottom" />

            <materialDesign:PackIcon Grid.Column="1" Kind="Magnify" Opacity=".56"
                                     Width="20" Height="20"
                                     VerticalAlignment="Bottom" Margin="24,0,8,6" />

            <TextBox Grid.Column="2"
                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="{loc:Loc Search_NameTeamCity_Hint}"
                     MinWidth="200" MaxWidth="320" HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged, Delay=1000}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal"
                        Margin="20,0,0,0" VerticalAlignment="Bottom"
                        ToolTip="{loc:Loc Brackets_RemainingOnMat_Tooltip}">
                <materialDesign:PackIcon Kind="Wrestling" Width="20" Height="20"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Text="{Binding SelectedMat.MatchesLeft, Mode=OneWay}"
                           FontSize="16" VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <materialDesign:Card Grid.Row="1" Margin="20,0,20,0"
                             UniformCornerRadius="4"
                             materialDesign:ElevationAssist.Elevation="Dp4">
        <ListView ItemsSource="{Binding SelectedMat.MatchesReady}" x:Name="MatchesSource"
                  utils:GridViewSort.AutoSort="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  TextElement.FontSize="15"
                  VirtualizingPanel.IsVirtualizing="False">
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                            <Setter Property="Padding" Value="4,8,4,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="14" />
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>

                    <GridViewColumn Header="#" Width="Auto"
                                    DisplayMemberBinding="{Binding MatchNumber}"
                                    utils:GridViewSort.PropertyName="MatchNumber" />

                    <GridViewColumn Header="{loc:Loc Completed_Column_GroupStage}" Width="Auto">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GroupName}" TextWrapping="NoWrap" HorizontalAlignment="Left" />
                                    <TextBlock Text="{loc:LocRound RoundName}" Margin="0,4,0,0" TextWrapping="NoWrap"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="{loc:Loc Completed_Column_Wrestlers}" Width="Auto">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Foreground="DarkRed" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{loc:Loc Match_RedWrestler_Tooltip}" Kind="CheckboxBlank" />
                                        <TextBlock Text="{Binding WrestlerInRed.LastFirstName}" TextWrapping="NoWrap" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <materialDesign:PackIcon Foreground="Blue" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{loc:Loc Match_BlueWrestler_Tooltip}" Kind="CheckboxBlank" />
                                        <TextBlock Text="{Binding WrestlerInBlue.LastFirstName}" TextWrapping="NoWrap" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="{loc:Loc Completed_Column_Teams}" Width="Auto">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WrestlerInRed.TeamName}" TextWrapping="NoWrap" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding WrestlerInBlue.TeamName}" Margin="0,4,0,0" TextWrapping="NoWrap" HorizontalAlignment="Left" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="{loc:Loc Schedule_Column_Cities}" Width="Auto">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WrestlerInRed.TeamCity}" TextWrapping="NoWrap" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding WrestlerInBlue.TeamCity}" Margin="0,4,0,0" TextWrapping="NoWrap" HorizontalAlignment="Left" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="Auto">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button CommandParameter="{Binding }"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                        Width="36" Height="36" Padding="0" Margin="4,2,4,2"
                                        Command="{Binding ElementName=RootControl, Path=DataContext.OpenMatchCommand}"
                                        ToolTip="{loc:Loc Brackets_LoadMatch_Tooltip}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Play" Width="22" Height="22" />
                                </Button>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction
                        Command="{Binding ElementName=RootControl, Path=DataContext.OpenMatchCommand}"
                        CommandParameter="{Binding Path=SelectedItem, ElementName=MatchesSource}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ListView>
        </materialDesign:Card>

    </Grid>
        
</UserControl>