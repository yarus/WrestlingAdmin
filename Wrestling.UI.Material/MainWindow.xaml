<Window x:Class="Wrestling.UI.Material.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:home="clr-namespace:Wrestling.UI.Material.Home"
        xmlns:settings="clr-namespace:Wrestling.UI.Material.Settings"
        xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
        xmlns:personalResults="clr-namespace:Wrestling.UI.Material.Tournament.Results.PersonalResults"
        xmlns:teamResults="clr-namespace:Wrestling.UI.Material.Tournament.Results.TeamResults"
        xmlns:achievements="clr-namespace:Wrestling.UI.Material.Tournament.Results.Achievements"
        xmlns:match="clr-namespace:Wrestling.UI.Material.Match"
        xmlns:brackets1="clr-namespace:Wrestling.UI.Material.Tournament.Progress.Brackets"
        xmlns:schedule1="clr-namespace:Wrestling.UI.Material.Tournament.Progress.Schedule"
        xmlns:details="clr-namespace:Wrestling.UI.Material.Tournament.Standing.Details"
        xmlns:applications="clr-namespace:Wrestling.UI.Material.Tournament.Standing.Applications"
        xmlns:draw1="clr-namespace:Wrestling.UI.Material.Tournament.Standing.Draw"
        xmlns:mats1="clr-namespace:Wrestling.UI.Material.Tournament.Standing.Mats"
        xmlns:printBracket="clr-namespace:Wrestling.UI.Material.Tournament.Print.PrintBracket"
        xmlns:slider="clr-namespace:Wrestling.UI.Material.Slider"
        xmlns:conducting="clr-namespace:Wrestling.UI.Material.Tournament.Conducting"
        xmlns:resultsRoot="clr-namespace:Wrestling.UI.Material.Tournament.Results"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Icon="Resources/scoreboard.ico"
        Title="{Binding CurrentViewModel.WindowTitle}"
        md:DialogServiceViews.IsRegistered="True"
        Height="800"
        Width="1100"
        Style="{StaticResource MaterialDesignWindow}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <!-- BoolToVis / BoolInverter / InvBoolToVis live in App.xaml — they're
                 needed by UserControls hosted via DataTemplate too, and StaticResource
                 only walks parse-time scope. -->

            <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
                <settings:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type home:HomeViewModel}">
                <home:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type match:MatchControlViewModel}">
                <match:MatchControlView2 />
            </DataTemplate>
            <DataTemplate DataType="{x:Type match:MatchResultsViewModel}">
                <match:MatchResultsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type printBracket:PrintBracketViewModel}">
                <printBracket:PrintBracketView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type personalResults:PersonalResultsViewModel}">
                <personalResults:PersonalResultsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type teamResults:TeamResultsViewModel}">
                <teamResults:TeamResultsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type achievements:AchievementsViewModel}">
                <achievements:AchievementsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type brackets1:BracketsViewModel}">
                <brackets1:BracketsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type schedule1:ScheduleViewModel}">
                <schedule1:ScheduleView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type details:DetailsViewModel}">
                <details:DetailsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type applications:ApplicationsViewModel}">
                <applications:ApplicationsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type draw1:DrawViewModel}">
                <draw1:DrawView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type mats1:MatsViewModel}">
                <mats1:MatsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type slider:SliderControlViewModel}">
                <slider:SliderControlView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type conducting:MatBoardViewModel}">
                <conducting:MatBoardView />
            </DataTemplate>

            <!-- Section wrappers -->
            <DataTemplate DataType="{x:Type conducting:ConductingViewModel}">
                <conducting:ConductingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type resultsRoot:ResultsViewModel}">
                <resultsRoot:ResultsView />
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog" SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Persistent left navigation rail. Hidden on the pre-tournament
                 Home screen and on full-screen overlays (MatchControl/MatchResults
                 set IsBackButtonAvailable=true, which gates IsRailVisible).
                 Top group = tournament phases. Footer (Settings) is pinned to
                 the bottom via DockPanel.Dock="Bottom"; the empty space between
                 provides the visual separation. -->
            <Border Grid.Column="0"
                    Width="96"
                    Background="{DynamicResource MaterialDesignBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsRailVisible, Converter={StaticResource BoolToVis}}">
                <Border.Resources>
                    <DataTemplate x:Key="NavigationItemTemplate">
                        <Grid>
                            <!-- Separator for the gap between phases and utility items.
                                 Currently unused (footer slot replaced it); kept so an
                                 in-section divider can be added without re-templating. -->
                            <Separator Margin="12,8,12,8"
                                       Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}" />

                            <!-- Highlight Border (visible fill on active) wraps a transparent
                                 Button that hosts the click + ripple. The Border paints the
                                 active-state color; the Button's tool-button template doesn't
                                 reliably paint Background, so it's delegated outward. -->
                            <Border Margin="6,2"
                                    CornerRadius="12"
                                    Visibility="{Binding IsSeparator, Converter={StaticResource InvBoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#D1C4E9" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Padding="0,10"
                                        Height="64"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        Command="{Binding ActivateCommand}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                 Width="24" Height="24"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </Border.Resources>
                <DockPanel LastChildFill="True">
                    <ItemsControl DockPanel.Dock="Bottom"
                                  ItemsSource="{Binding FooterNavigationItems}"
                                  ItemTemplate="{StaticResource NavigationItemTemplate}"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding NavigationItems}"
                                  ItemTemplate="{StaticResource NavigationItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1">
                <materialDesign:ColorZone Padding="16" Mode="PrimaryMid" DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Page title spans all columns so it stays anchored to the
                             window center regardless of how many QuickButtons / Save
                             buttons render on the right. Declared before the buttons
                             so it sits beneath them in Z-order; IsHitTestVisible=False
                             lets clicks pass through to whichever button is overlaid
                             on top of the title's bounding box. -->
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   Foreground="White"
                                   IsHitTestVisible="False"
                                   Text="{Binding CurrentViewModel.PageTitle}" />

                        <!-- Back arrow only — drawer hamburger is gone (rail is permanent) -->
                        <Button Grid.Column="0"
                                Command="{Binding CurrentViewModel.BackCommand}"
                                Padding="0"
                                Margin="0,0,12,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Visibility="{Binding Path=CurrentViewModel.IsBackButtonAvailable, Converter={StaticResource BoolToVis}}">
                            <Viewbox Stretch="Uniform">
                                <materialDesign:PackIcon Kind="ArrowLeft" />
                            </Viewbox>
                        </Button>

                        <ItemsControl Grid.Column="2" ItemsSource="{Binding CurrentViewModel.QuickButtons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding TooltipText}" Background="Transparent" Margin="0">
                                        <Button Margin="0,0,20,0"
                                                Command="{Binding Open}"
                                                CommandParameter="{Binding ElementName=ContentControl}"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="White">
                                            <Grid Width="32" Height="32">
                                                <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                         VerticalAlignment="Center"
                                                                         HorizontalAlignment="Center"
                                                                         Width="32" Height="32">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.3" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             IsIndeterminate="True"
                                                             Width="28" Height="28"
                                                             Foreground="White"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Center"
                                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- "Сохранить" — manual escape hatch always at hand when a
                             tournament is open. Plain icon, white on the PrimaryMid header. -->
                        <Button Grid.Column="3"
                                Width="40" Height="40"
                                Padding="0"
                                Margin="0,0,8,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Command="{Binding SaveCommand}"
                                Visibility="{Binding IsSaveCommandVisible, Converter={StaticResource BoolToVis}}"
                                ToolTip="{loc:Loc MainWindow_SaveTooltip}"
                                Style="{StaticResource MaterialDesignToolButton}">
                            <materialDesign:PackIcon Kind="ContentSave" Width="28" Height="28" />
                        </Button>
                    </Grid>
                </materialDesign:ColorZone>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ContentControl Grid.Row="0"
                                    Content="{Binding CurrentViewModel}"
                                    x:Name="ContentControl"
                                    Margin="0"
                                    Padding="0" />

                    <materialDesign:Snackbar MessageQueue="{materialDesign:MessageQueue}"
                                             x:Name="MainSnackbar"
                                             Grid.Row="0"
                                             VerticalAlignment="Bottom"
                                             HorizontalAlignment="Center" />
                </Grid>
            </DockPanel>
        </Grid>
    </materialDesign:DialogHost>

</Window>
