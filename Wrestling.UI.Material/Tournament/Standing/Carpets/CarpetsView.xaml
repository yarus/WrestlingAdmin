<UserControl x:Class="Wrestling.UI.Material.Tournament.Standing.Carpets.CarpetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="400" d:DesignWidth="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:IndexConverter x:Key="IndexConverter"/>
        <converters:IndexItemsConverter x:Key="ItemsIndexConverter" />

        <converters:ValueConverterGroup x:Key="InvBoolToVis">
            <converters:BoolInverterConverter />
            <converters:GroupedBoolToVisConverter />
        </converters:ValueConverterGroup>
    </UserControl.Resources>

    <Grid Margin="0" x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <Button Content="{loc:Loc Carpets_Add}"
                        ToolTip="{loc:Loc Carpets_Add_Tooltip}"
                        Width="160"
                        HorizontalAlignment="Left" Margin="20,10,0,10"
                        Command="{Binding AddCarpetCommand}" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                        Margin="20,0,20,0" VerticalAlignment="Center"
                        ToolTip="{loc:Loc Carpets_UnboundGroups_Tooltip}">
                <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Text="{Binding UnbindedGroups, Mode=OneWay}"
                           FontSize="16" VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Margin="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Background="{DynamicResource MaterialDesignToolBarBackground}" Margin="0" Padding="0"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="StatParticipants" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="StatMatches" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="StatDuration" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ActionEdit" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ActionDelete" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" TextWrapping="NoWrap" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource ItemsIndexConverter}" ConverterParameter="1">
                                                <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}" />
                                                <Binding Path="."/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1" TextWrapping="NoWrap" FontSize="16" Margin="20,0,20,0" VerticalAlignment="Center">
                                        <Run Text="{Binding Name}"></Run>
                                    </TextBlock>

                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                                Margin="12,0,12,0" VerticalAlignment="Center"
                                                ToolTip="{loc:Loc Carpets_WrestlersCount_Tooltip}">
                                        <materialDesign:PackIcon Kind="AccountMultiple" Width="20" Height="20"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="{Binding WrestlersCount, Mode=OneWay}"
                                                   FontSize="16" VerticalAlignment="Center"
                                                   Margin="6,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal"
                                                Margin="12,0,12,0" VerticalAlignment="Center"
                                                ToolTip="{loc:Loc Carpets_MatchesCount_Tooltip}">
                                        <materialDesign:PackIcon Kind="Wrestling" Width="20" Height="20"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="{Binding MatchesCount, Mode=OneWay}"
                                                   FontSize="16" VerticalAlignment="Center"
                                                   Margin="6,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal"
                                                Margin="12,0,12,0" VerticalAlignment="Center"
                                                ToolTip="{loc:Loc Carpets_ExpectedDuration_Tooltip}">
                                        <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <TextBlock Text="{Binding ExpectedDurationLabel, Mode=OneWay}"
                                                   FontSize="16" VerticalAlignment="Center"
                                                   Margin="6,0,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="5" ToolTip="{loc:Loc Carpets_Edit_Tooltip}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Command="{Binding Path=DataContext.EditCarpetCommand, ElementName=RootControl}" CommandParameter="{Binding }">
                                        <materialDesign:PackIcon Kind="BorderColor" Width="22" Height="22" Padding="0" />
                                    </Button>

                                    <Button Grid.Column="6" ToolTip="{loc:Loc Carpets_Delete_Tooltip}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Command="{Binding Path=DataContext.DeleteCarpetCommand, ElementName=RootControl}" CommandParameter="{Binding }" Margin="20,0,0,0">
                                        <materialDesign:PackIcon Kind="Close" Width="22" Height="22" Margin="0" Padding="0" />
                                    </Button>
                                </Grid>
                            </Expander.Header>
                            <Expander.Content>
                                <StackPanel Background="{DynamicResource MaterialDesignPaper}" Margin="0">
                                    <Button  Content="{loc:Loc Carpets_AddGroup}" Width="160" HorizontalAlignment="Left" Margin="20,10,0,10"
                                             ToolTip="{loc:Loc Carpets_AddGroup_Tooltip}"
                                             Command="{Binding Path=DataContext.BindGroupCommand, ElementName=RootControl}" CommandParameter="{Binding }" />
                                    <ListView ItemsSource="{Binding Groups}" x:Name="GroupsSource"
                                              Margin="10,0,10,0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              HorizontalContentAlignment="Stretch"
                                              TextElement.FontSize="15">
                                        <ListView.View>
                                            <GridView AllowsColumnReorder="false">
                                                <GridView.ColumnHeaderContainerStyle>
                                                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                                        <Setter Property="Padding" Value="4,8,4,8" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                        <Setter Property="FontSize" Value="14" />
                                                    </Style>
                                                </GridView.ColumnHeaderContainerStyle>

                                                <GridViewColumn Header="#" Width="44">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Converter={StaticResource IndexConverter}, ConverterParameter=1}"
                                                                       TextWrapping="NoWrap" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="{loc:Loc Details_Groups_Column_Name}" Width="220">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                       FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="{loc:Loc Carpets_Column_Wrestlers}" Width="110">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Path=Wrestlers.Count, Mode=OneWay}"
                                                                       TextWrapping="NoWrap" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="{loc:Loc Carpets_Column_Matches}" Width="90">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Path=PendingMatchesCount, Mode=OneWay}"
                                                                       TextWrapping="NoWrap" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Header="{loc:Loc Carpets_Column_RoundTime}" Width="120">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Path=MaxRoundSecond, StringFormat='{}{0}с', Mode=OneWay}"
                                                                       TextWrapping="NoWrap" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>

                                                <GridViewColumn Width="120">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" Orientation="Horizontal">
                                                                <Button ToolTip="{loc:Loc Carpets_MoveUp_Tooltip}"
                                                                        Margin="0" Padding="0" Width="28" Height="28"
                                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                                        Command="{Binding ElementName=RootControl, Path=DataContext.UpGroupCommand}"
                                                                        CommandParameter="{Binding }" VerticalAlignment="Center">
                                                                    <materialDesign:PackIcon Kind="ArrowUp" Width="16" Height="16" Margin="0" Padding="0" />
                                                                </Button>

                                                                <Button ToolTip="{loc:Loc Carpets_MoveDown_Tooltip}"
                                                                        Margin="6,0,0,0" Padding="0" Width="28" Height="28"
                                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                                        Command="{Binding ElementName=RootControl, Path=DataContext.DownGroupCommand}"
                                                                        CommandParameter="{Binding }" VerticalAlignment="Center">
                                                                    <materialDesign:PackIcon Kind="ArrowDown" Width="16" Height="16" Margin="0" Padding="0" />
                                                                </Button>

                                                                <Button ToolTip="{loc:Loc Carpets_UnbindGroup_Tooltip}"
                                                                        Margin="6,0,0,0" Padding="0" Width="28" Height="28"
                                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                                        Command="{Binding ElementName=RootControl, Path=DataContext.UnbindGroupCommand}"
                                                                        CommandParameter="{Binding }" VerticalAlignment="Center">
                                                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0" Padding="0" />
                                                                </Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>

                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <i:InvokeCommandAction
                                                    Command="{Binding ElementName=RootControl, Path=DataContext.UnbindGroupCommand}"
                                                    CommandParameter="{Binding Path=SelectedItem, ElementName=GroupsSource}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </ListView>
                                </StackPanel>
                            </Expander.Content>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</UserControl>