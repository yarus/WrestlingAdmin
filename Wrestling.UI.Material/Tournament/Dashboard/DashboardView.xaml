<UserControl x:Class="Wrestling.UI.Material.Tournament.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             mc:Ignorable="d" 
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="800" d:DesignWidth="960">

    <UserControl.Resources>
        <converters:SecondsToTimeStringConverter x:Key="SecondsToTimeStringConverter" />
        <converters:SecondsToFutureTimeConverter x:Key="SecondsToFutureTimeConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />        
        <converters:ValueConverterGroup x:Key="InvBoolToVis">
            <converters:BoolInverterConverter />
            <converters:GroupedBoolToVisConverter />            
        </converters:ValueConverterGroup>
    </UserControl.Resources>
    
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,10">
                    <materialDesign:Card Width="852" Height="300" Margin="8 2 4 16">
                        <Grid VerticalAlignment="Stretch" Margin="16" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <materialDesign:PackIcon Grid.Row="1" Grid.Column="0" Kind="ClipboardText" Width="140" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0" VerticalAlignment="Top" HorizontalAlignment="Center">
                            <TextBlock TextWrapping="Wrap" Style="{DynamicResource MaterialDesignHeadlineTextBlock}">Информация о турнире</TextBlock>
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="18" Text="{Binding Path=Tournament.Name}" Margin="10,10,10,0" />

                            <StackPanel Grid.Row="1" Grid.Column="0" >
                                <TextBlock TextWrapping="Wrap" FontSize="18" Margin="10,10,10,0">
                                    <Run Text="Весовых категорий:"></Run>
                                    <Run Text="{Binding Tournament.GroupsCount, Mode=OneWay}"></Run>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" FontSize="18" Margin="10,10,10,0">
                                    <Run Text="Заявлено команд:"></Run>
                                    <Run Text="{Binding Tournament.ApplicationsCount, Mode=OneWay}"></Run>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" FontSize="18" Margin="10,10,10,0">
                                    <Run Text="Заявлено участников:"></Run>
                                    <Run Text="{Binding Tournament.AppliedWrestlersCount, Mode=OneWay}"></Run>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" FontSize="18" Margin="10,10,10,0">
                                    <Run Text="Допущено участников:"></Run>
                                    <Run Text="{Binding Tournament.ApprovedWrestlersCount, Mode=OneWay}"></Run>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" FontSize="18" Margin="10,10,10,0">
                                    <Run Text="Взносов собрано:"></Run>
                                    <Run Text="{Binding Tournament.FeesCollectedAmount, Mode=OneWay}"></Run>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" FontSize="18" Margin="10,10,10,0">
                                    <Run Text="Ожидаемая длительность:"></Run>
                                    <Run Text="{Binding Tournament.ExpectedDurationInSeconds, Mode=OneWay, StringFormat={}{0:mm':'ss}, Converter={StaticResource SecondsToTimeStringConverter}}"></Run>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock TextWrapping="Wrap" FontSize="18" Margin="10,10,10,0">
                                    <Run Text="Ковров:"></Run>
                                    <Run Text="{Binding Tournament.CarpetsCount, Mode=OneWay}"></Run>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" FontSize="18" Margin="10,10,10,0">
                                    <Run Text="Всего схваток:"></Run>
                                    <Run Text="{Binding Tournament.MatchesCount, Mode=OneWay}"></Run>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" FontSize="18" Margin="10,10,10,0">
                                    <Run Text="Завершено:"></Run>
                                    <Run Text="{Binding Tournament.CompletedMatchesCount, Mode=OneWay}"></Run>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" FontSize="18" Margin="10,10,10,0">
                                    <Run Text="Осталось:"></Run>
                                    <Run Text="{Binding Tournament.PendingMatchesCount, Mode=OneWay}"></Run>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" FontSize="18" Margin="10,10,10,0">
                                    <Run Text="Прогресс:"></Run>
                                    <Run Text="{Binding Tournament.ProgressPercent, Mode=OneWay}"></Run>
                                    <Run Text="%"></Run>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" FontSize="18" Margin="10,10,10,0">
                                    <Run Text="Время окончания:"></Run>                                    
                                    <Run Text="{Binding Tournament.ExpectedDurationInSeconds, Mode=OneWay, StringFormat={}{0:mm':'ss}, Converter={StaticResource SecondsToFutureTimeConverter}}"></Run>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    </materialDesign:Card>
                </StackPanel>

                <WrapPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:Card Width="420" Margin="8 2 4 16" Height="240">
                        <Grid VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="BookVariant" Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Style="{StaticResource MaterialDesignHeadlineTextBlock}" Margin="16 16 16 8">Положение</TextBlock>

                                <TextBlock TextWrapping="Wrap" Margin="16 0 16 8" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Top">
                                    Данный модуль отвечает за подготовку всей необходимой информации для начала соревнований.
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource MaterialDesignDivider}" Padding="8">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" HorizontalAlignment="Left" Margin="8 4 8 8"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding Path=OpenStandingCommand}">ОТКРЫТЬ</Button>
                                </DockPanel>
                            </Border>

                        </Grid>
                    </materialDesign:Card>
                    
                    <materialDesign:Card Width="420" Margin="8 2 4 16" Height="240">
                        <Grid VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="CalendarCheck" Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Style="{StaticResource MaterialDesignHeadlineTextBlock}" Margin="16 16 16 8">Проведение</TextBlock>

                                <TextBlock TextWrapping="Wrap" Margin="16 0 16 8" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Top">
                                    С помощью данного модуля можно просмотреть турнирные сетки для каждой весовой категории.
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource MaterialDesignDivider}" Padding="8">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" HorizontalAlignment="Left" Margin="8 4 8 8"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding Path=OpenBracketCommand}">ОТКРЫТЬ</Button>
                                </DockPanel>
                            </Border>

                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Width="420" Margin="8 2 4 16" Height="240">
                        <Grid VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="TrophyOutline" Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Style="{StaticResource MaterialDesignHeadlineTextBlock}" Margin="16 16 16 8">Результаты</TextBlock>

                                <TextBlock TextWrapping="Wrap" Margin="16 0 16 8" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Top">
                                    С помощью данного модуля можно просмотреть итоги соревнований: командный зачет и личные результаты по группам.
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource MaterialDesignDivider}" Padding="8">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" HorizontalAlignment="Left" Margin="8 4 8 8"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding Path=OpenResultsCommand}">ОТКРЫТЬ</Button>
                                </DockPanel>
                            </Border>

                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Width="420" Margin="8 2 4 16" Height="240">
                        <Grid VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="ImageFilter" Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Style="{StaticResource MaterialDesignHeadlineTextBlock}" Margin="16 16 16 8">Слайдер</TextBlock>

                                <TextBlock TextWrapping="Wrap" Margin="16 0 16 8" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Top">
                                    С помощью данного модуля можно отображать различные слайды на информационном табло.
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource MaterialDesignDivider}" Padding="8">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" HorizontalAlignment="Left" Margin="8 4 8 8"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding Path=OpenSliderControlCommand}">ОТКРЫТЬ</Button>
                                </DockPanel>
                            </Border>

                        </Grid>
                    </materialDesign:Card>
                </WrapPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>