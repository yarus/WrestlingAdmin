<UserControl x:Class="Wrestling.UI.Material.Tournament.Results.PersonalResults.PersonalResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
             xmlns:utils="clr-namespace:Wrestling.UI.Utils;assembly=Wrestling.UI.Utils"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:IndexConverter x:Key="IndexConverter" />
        <converters:IndexItemsConverter x:Key="ItemsIndexConverter" />
    </UserControl.Resources>

    <Grid Margin="0" x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        materialDesign:RippleAssist.IsCentered="True">
                <Grid Margin="20,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border BorderThickness="1" Grid.Column="1" BorderBrush="DarkGray" />

                    <Button Grid.Column="0" Style="{DynamicResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="Magnify" Opacity=".56" />
                    </Button>

                    <TextBox Grid.Column="1" Margin="8 0 0 0"
                             materialDesign:HintAssist.Hint="{loc:Loc Completed_SearchHint}"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden" BorderThickness="0"
                             MinWidth="240" VerticalAlignment="Center"
                             Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                </Grid>
            </StackPanel>

            <CheckBox Grid.Column="2" Margin="20,10,20,10" VerticalAlignment="Center"
                      IsChecked="{Binding IsOnlyMedalsVisible}"
                      Content="{loc:Loc Personal_OnlyMedals}" />
        </Grid>

        <Border Grid.Row="0" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource MaterialDesignDivider}" />

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer CanContentScroll="False"
                                      Padding="{TemplateBinding Padding}"
                                      Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Expander Background="{DynamicResource MaterialDesignToolBarBackground}" Margin="0" Padding="0" x:Name="Expander"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              IsExpanded="{Binding Path=DataContext.ShouldAutoExpand, ElementName=RootControl, Mode=OneWay}">
                        <Expander.Header>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" MinWidth="280" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" TextWrapping="NoWrap" FontSize="16"
                                           VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ItemsIndexConverter}"
                                                      ConverterParameter="1">
                                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}" />
                                            <Binding Path="." />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Column="1" TextWrapping="NoWrap" FontSize="16"
                                           Margin="20,0,20,0" VerticalAlignment="Center">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text=" — " />
                                    <Run Text="{Binding BracketLabel, Mode=OneWay}" />
                                </TextBlock>

                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            Margin="12,0,12,0" VerticalAlignment="Center"
                                            ToolTip="{loc:Loc Personal_WrestlersCount_Tooltip}">
                                    <materialDesign:PackIcon Kind="AccountMultiple" Width="20" Height="20"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    <TextBlock Text="{Binding WrestlersCount, Mode=OneWay}"
                                               FontSize="14" VerticalAlignment="Center"
                                               Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                            Margin="12,0,12,0" VerticalAlignment="Center"
                                            ToolTip="{loc:Loc Personal_MedalsCount_Tooltip}">
                                    <materialDesign:PackIcon Kind="Medal" Width="20" Height="20"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    <TextBlock Text="{Binding MedalsCount, Mode=OneWay}"
                                               FontSize="14" VerticalAlignment="Center"
                                               Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <StackPanel Margin="0"
                                        Visibility="{Binding ElementName=Expander, Path=IsExpanded, Converter={StaticResource BoolToVis}}">
                                <materialDesign:Card Margin="10,10,10,10"
                                                     UniformCornerRadius="4"
                                                     materialDesign:ElevationAssist.Elevation="Dp4">
                                <ListView ItemsSource="{Binding Wrestlers}"
                                          utils:GridViewSort.AutoSort="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          HorizontalContentAlignment="Stretch"
                                          TextElement.FontSize="15">
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="True">
                                            <GridView.ColumnHeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                                    <Setter Property="Padding" Value="4,8,4,8" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="FontSize" Value="14" />
                                                </Style>
                                            </GridView.ColumnHeaderContainerStyle>

                                            <GridViewColumn Header="{loc:Loc Personal_Column_Place}" Width="80"
                                                            utils:GridViewSort.PropertyName="Wrestler.FinalPlace">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Wrestler.FinalPlace}"
                                                                       HorizontalAlignment="Center"
                                                                       Visibility="{Binding Wrestler.IsPlaceless, Converter={StaticResource InvBoolToVis}}" />
                                                            <TextBlock Text="DSQ"
                                                                       Foreground="Red" FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       ToolTip="{loc:Loc Personal_Dsq_Tooltip}"
                                                                       Visibility="{Binding Wrestler.IsDisqualified, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{loc:Loc Personal_NoShow}"
                                                                       Foreground="DarkOrange" FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       ToolTip="{loc:Loc Personal_NoShow}"
                                                                       Visibility="{Binding Wrestler.IsNoShow, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="{loc:Loc Personal_Column_LastFirstName}" Width="290"
                                                            DisplayMemberBinding="{Binding Wrestler.LastFirstName}"
                                                            utils:GridViewSort.PropertyName="Wrestler.LastFirstName" />

                                            <GridViewColumn Header="{loc:Loc Draw_Column_Team}" Width="170"
                                                            DisplayMemberBinding="{Binding Wrestler.TeamName}"
                                                            utils:GridViewSort.PropertyName="Wrestler.TeamName" />

                                            <GridViewColumn Header="{loc:Loc Personal_Column_Region}" Width="190"
                                                            DisplayMemberBinding="{Binding Wrestler.TeamCity}"
                                                            utils:GridViewSort.PropertyName="Wrestler.TeamCity" />

                                            <GridViewColumn Header="{loc:Loc Applications_Column_Level}" Width="100"
                                                            utils:GridViewSort.PropertyName="Wrestler.Level">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Wrestler.LevelDisplay}"
                                                                   HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="{loc:Loc Personal_Column_QualPoints}" Width="120"
                                                            utils:GridViewSort.PropertyName="TotalPoints">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding TotalPoints}"
                                                                   HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                </materialDesign:Card>
                            </StackPanel>
                        </Expander.Content>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
