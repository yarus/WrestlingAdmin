<UserControl x:Class="Wrestling.UI.Material.Match.MatchResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:converters1="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:converters2="clr-namespace:Wrestling.UI.Material.Utils.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" d:DesignHeight="1200" d:DesignWidth="1200">
    
    <UserControl.Resources>
        <converters2:WinTypeRadioButtonConverter x:Key="WinTypeRadioConverter" />
        <converters1:SecondsToTimeSpanConverter x:Key="SecondsToTimeSpanConverter" />
        <converters2:WinTypeToStringConverter x:Key="WinTypeToStringConverter" />
        <converters2:PathToImageConverter x:Key="ClubToIconConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters1:BoolToBrushConverter x:Key="BoolHighlight" />
        <converters1:UpperCaseConverter x:Key="UpperCaseConverter" />
        <converters1:BoolInverterConverter x:Key="BoolInverterConverter" />

        <converters1:ValueConverterGroup x:Key="UpperWinType">
            <converters2:WinTypeToStringConverter />
            <converters1:UpperCaseConverter />
        </converters1:ValueConverterGroup>

        <converters1:ValueConverterGroup x:Key="InvBoolToVis">
            <converters1:BoolInverterConverter />
            <converters1:GroupedBoolToVisConverter />
        </converters1:ValueConverterGroup>

        <converters1:SubtractDoubleConverter x:Key="Subtract" />
        <converters1:MultiplyDoubleConverter x:Key="Multiply" />
        <converters2:MatchActionDescriptionConverter x:Key="MatchActionDescriber" />
    </UserControl.Resources>

    <Grid IsEnabled="{Binding IsFormEnabled}" Margin="0,20,0,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" MinWidth="360" MaxWidth="540" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="LeftPanel" Grid.Column="0" Margin="20,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="2" BorderThickness="1,1,1,1" BorderBrush="Black" />
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="Black" />

        <Grid Grid.Row="0">
            <Viewbox Stretch="Uniform">
                <TextBlock Text="{Binding WrestlingMatch.GroupName, Mode=OneWay, Converter={StaticResource UpperCaseConverter}}"
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           HorizontalAlignment="Center" />
            </Viewbox>
        </Grid>

        <Grid Grid.Row="1"
              Height="{Binding ActualWidth, ElementName=LeftPanel, Converter={StaticResource Multiply}, ConverterParameter=0.4}"
              MaxHeight="350" MinHeight="220">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="4*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="Black" />
            <Border Grid.Row="0" Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="Black" />
            <Border Grid.Row="1" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="Black" />
            <Border Grid.Row="1" Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="Black" />
            <Border Grid.Row="2" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="Black" />
            <Border Grid.Row="2" Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="Black" />
            <Border Grid.Row="3" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="Black" />
            <Border Grid.Row="3" Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="Black" />

            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Background="Yellow" BorderThickness="1" Visibility="{Binding IsWinnerRed, Converter={StaticResource BoolToVis}}"></Border>
            <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="3" Background="Yellow" BorderThickness="1" Visibility="{Binding IsWinnerBlue, Converter={StaticResource BoolToVis}}"></Border>

            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource SecondaryAccentBrush}" BorderThickness="1" Visibility="{Binding IsRedSelected, Converter={StaticResource BoolToVis}}"></Border>
            <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource SecondaryAccentBrush}" BorderThickness="1" Visibility="{Binding IsBlueSelected, Converter={StaticResource BoolToVis}}"></Border>

            <!-- Red City -->
            <Viewbox Grid.Row="0" Grid.Column="0" Stretch="Uniform" Margin="10,6,10,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Path=WrestlingMatch.WrestlerInRed.TeamCity, Mode=OneWay}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" HorizontalAlignment="Center" />
            </Viewbox>

            <!-- Red Team Name -->
            <Viewbox Grid.Row="1" Grid.Column="0" Stretch="Uniform" Margin="10,2,10,6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Path=WrestlingMatch.WrestlerInRed.TeamName, Mode=OneWay}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" HorizontalAlignment="Center" />
            </Viewbox>

            <!-- Red Team Emblem-->
            <Grid Grid.Column="0" Grid.Row="2">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseEnter">
                        <i:InvokeCommandAction Command="{Binding RedSelectedCommand}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeave">
                        <i:InvokeCommandAction Command="{Binding RedDeselectedCommand}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding SetWinnerCommand}" CommandParameter="Red"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>

                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="60px" />
                </Grid.RowDefinitions>                

                <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Stretch="UniformToFill" Margin="10" Source="{Binding Wrestler1TeamEmblem, Converter={StaticResource ClubToIconConverter}, ConverterParameter=DefaultLogo.png}" />
                </Viewbox>

                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Path=WrestlingMatch.WrestlerInRed.LastFirstName, Mode=OneWay}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                </Viewbox>

            </Grid>

            <!-- Red Winner -->
            <Grid Grid.Column="0" Grid.Row="3" HorizontalAlignment="Center">
                <Viewbox Stretch="Uniform" Visibility="{Binding IsWinnerRed, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="8">
                        <Grid Background="Yellow">
                            <Border BorderBrush="Black" BorderThickness="1">
                                <TextBlock Text="ПОБЕДИТЕЛЬ" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="10,4,10,4" />
                            </Border>                            
                        </Grid>
                    </StackPanel>
                </Viewbox>
            </Grid>

            <!-- Stage -->
            <Viewbox Grid.Row="0" Grid.Column="1" Stretch="Uniform" Margin="10,6,10,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding WrestlingMatch.RoundName, Mode=OneWay, Converter={StaticResource UpperCaseConverter}}"
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}" HorizontalAlignment="Center" />
            </Viewbox>

            <!-- Match Number -->
            <Viewbox Grid.Row="1" Grid.Column="1" Stretch="Uniform" Margin="10,2,10,6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MaterialDesignHeadline5TextBlock}" HorizontalAlignment="Center">
                        <Run Text="СХВАТКА"></Run>
                        <Run Text="#"></Run>
                        <Run Text="{Binding Path=WrestlingMatch.MatchNumber}"></Run>
                </TextBlock>
            </Viewbox>

            <!-- Points -->
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Red Points -->
                <Grid Grid.Column="0" Background="Red">
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                        <Grid Width="100" Height="100">
                            <TextBlock Text="{Binding WrestlingMatch.PointsRed}" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="80" />
                            <Border BorderBrush="{Binding IsPlayer1WithAdvantage, Converter={StaticResource BoolHighlight}, ConverterParameter=Yellow}" BorderThickness="0,0,0,5" Margin="1" />
                        </Grid>
                    </Viewbox>
                </Grid>

                <!-- Blue Points -->
                <Grid Grid.Column="1" Background="#005BEC">
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                        <Grid Width="100" Height="100">
                            <TextBlock Text="{Binding WrestlingMatch.PointsBlue}" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="80" />
                            <Border BorderBrush="{Binding IsPlayer2WithAdvantage, Converter={StaticResource BoolHighlight}, ConverterParameter=Yellow}" BorderThickness="0,0,0,5" Margin="1" />
                        </Grid>
                    </Viewbox>
                </Grid>

            </Grid>

            <!-- WinType -->
            <Grid Grid.Row="3" Grid.Column="1">
                <!-- Pending: clickable button filling the cell -->
                <Button Visibility="{Binding Path=WrestlingMatch.IsMatchCompleted, Converter={StaticResource InvBoolToVis}}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Padding="0" Margin="4"
                        Command="{Binding Path=SetWinTypeCommand}">
                    <Viewbox Stretch="Uniform" Margin="8,2">
                        <TextBlock Text="{Binding WinType, Converter={StaticResource UpperWinType}}"
                                   TextWrapping="NoWrap"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                    </Viewbox>
                </Button>

                <!-- Completed: same visual as the pending button (same
                     MaterialDesignRaisedButton style + dimensions) but
                     non-interactive — IsHitTestVisible=False keeps it from
                     looking «disabled» (greyed out) while still blocking
                     clicks. -->
                <Button Visibility="{Binding Path=WrestlingMatch.IsMatchCompleted, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        IsHitTestVisible="False" Focusable="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Padding="0" Margin="4">
                    <Viewbox Stretch="Uniform" Margin="8,2">
                        <TextBlock Text="{Binding WinType, Converter={StaticResource UpperWinType}}"
                                   TextWrapping="NoWrap"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                    </Viewbox>
                </Button>
            </Grid>

            <!-- Blue City -->
            <Viewbox Grid.Row="0" Grid.Column="2" Stretch="Uniform" Margin="10,6,10,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Path=WrestlingMatch.WrestlerInBlue.TeamCity, Mode=OneWay}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" HorizontalAlignment="Center" />
            </Viewbox>

            <!-- Blue Team Name -->
            <Viewbox Grid.Row="1" Grid.Column="2" Stretch="Uniform" Margin="10,2,10,6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Path=WrestlingMatch.WrestlerInBlue.TeamName, Mode=OneWay}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" HorizontalAlignment="Center" />
            </Viewbox>

            <!-- Blue Column -->
            <Grid Grid.Column="2" Grid.Row="2">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseEnter">
                        <i:InvokeCommandAction Command="{Binding BlueSelectedCommand}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeave">
                        <i:InvokeCommandAction Command="{Binding BlueDeselectedCommand}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding SetWinnerCommand}" CommandParameter="Blue"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>

                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="60px" />
                </Grid.RowDefinitions>                
                
                <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Stretch="UniformToFill" Margin="10" Source="{Binding Wrestler2TeamEmblem, Converter={StaticResource ClubToIconConverter}, ConverterParameter=DefaultLogo.png}" />
                </Viewbox>

                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Path=WrestlingMatch.WrestlerInBlue.LastFirstName, Mode=OneWay}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                </Viewbox>
            </Grid>

            <Grid Grid.Row="3" Grid.Column="2" HorizontalAlignment="Center">
                <Viewbox Stretch="Uniform" Visibility="{Binding IsWinnerBlue, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="8">
                        <Grid Background="Yellow">
                            <Border BorderBrush="Black" BorderThickness="1">
                                <TextBlock Text="ПОБЕДИТЕЛЬ" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="10,4,10,4" />
                            </Border>                            
                        </Grid>
                    </StackPanel>
                </Viewbox>
            </Grid>
        </Grid>
        
        <TextBlock Grid.Row="2"
                   Text="Не выбран победитель схватки"
                   Foreground="Red" FontWeight="SemiBold" FontSize="14"
                   HorizontalAlignment="Center" Margin="0,8,0,0"
                   Visibility="{Binding IsWinnerNotSelected, Converter={StaticResource BoolToVis}}" />

        <GroupBox Grid.Row="3" Header="Заметки" Padding="5" Margin="0,10,0,0" VerticalAlignment="Top">
            <TextBox Padding="0"
                     Height="120"
                     TextWrapping="Wrap" VerticalAlignment="Stretch"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     SpellCheck.IsEnabled="True"
                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
        </GroupBox>

        <StackPanel Grid.Row="5">
            <Button Content="ЗАВЕРШИТЬ" Style="{StaticResource MaterialDesignRaisedButton}" TabIndex="1"
                    FontStretch="Medium" Width="200" Height="60" Margin="10" FontSize="20"
                    Command="{Binding CompleteMatchCommand}" ToolTip="Завершить схватку" />
        </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="10,0,20,0">
            <Border BorderBrush="Black" BorderThickness="1">
                <ListView x:Name="ProtocolList"
                          ItemsSource="{Binding WrestlingMatch.MatchActions}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="6,4,6,4" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>

                            <GridViewColumn Header="Время" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DateTime, StringFormat={}{0:HH:mm:ss}}" FontSize="15" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Матч" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="15">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Раунд {0}: {1:mm\:ss}">
                                                    <Binding Path="RoundNumber" />
                                                    <Binding Path="SecondInRound" Converter="{StaticResource SecondsToTimeSpanConverter}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Действие"
                                            Width="{Binding ActualWidth, ElementName=ProtocolList, Converter={StaticResource Subtract}, ConverterParameter=222}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="15" TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource MatchActionDescriber}">
                                                    <Binding Path="Type" />
                                                    <Binding Path="IsForRed" />
                                                    <Binding Path="Points" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</UserControl>