<UserControl x:Class="Wrestling.UI.Material.Tournament.Standing.Applications.AddAppDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:model="clr-namespace:Wrestling.UI.Material.Model"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:toolkit="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
             xmlns:validation="clr-namespace:Wrestling.UI.Material.Model.Validation"
             xmlns:converters="clr-namespace:Wrestling.UI.Material.Utils.Converters"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" Width="600"
             d:DesignHeight="600" d:DesignWidth="600">

    <UserControl.Resources>
        <converters:PathToImageConverter x:Key="PathToImageConverter" />
    </UserControl.Resources>

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="18" Margin="10 5 10 15">Заявка</TextBlock>

        <Border Grid.Row="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="10,0,10,0"></Border>

        <Grid Grid.Row="1" Margin="10 5 10 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{DynamicResource MaterialDesignToolButton}" IsTabStop="False">
                <materialDesign:PackIcon Kind="Magnify" Opacity=".56" />
            </Button>

            <toolkit:AutoCompleteBox Grid.Column="1" x:Name="FullName"
                                     FontSize="18" TabIndex="1"
                                     ItemsSource="{Binding CachedTeams}"
                                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                     ValueMemberPath="FullName"
                                     IsTabStop="True"
                                     ItemFilter="{Binding TeamFilter}">
                <toolkit:AutoCompleteBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Label
                                Content="{Binding HashTag}"
                                Width="100" />
                            <Label
                                Content="{Binding FullName}"
                                FontStyle="Italic"
                                Foreground="DarkGray" />
                        </StackPanel>
                    </DataTemplate>
                </toolkit:AutoCompleteBox.ItemTemplate>
            </toolkit:AutoCompleteBox>

            <Button Grid.Column="2" Style="{DynamicResource MaterialDesignToolForegroundButton}" Margin="8 0 0 0" Panel.ZIndex="0" IsTabStop="False">
                <materialDesign:PackIcon Kind="Send" />
            </Button>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Margin="10,0,10,0"></Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" materialDesign:HintAssist.Hint="Полное название организации" TabIndex="2"
                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="10 5 10 5" FontSize="18">
                <TextBox.Text>
                    <Binding Path="Item.FullName" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validation:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBox Grid.Row="1" Grid.Column="0" materialDesign:HintAssist.Hint="Название команды" TabIndex="3"
                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="10 5 10 5" FontSize="18">
                <TextBox.Text>
                    <Binding Path="Item.ShortName" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validation:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBox Grid.Row="1" Grid.Column="1" materialDesign:HintAssist.Hint="Хэштег" TabIndex="4"
                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="10 5 10 5" FontSize="18">
                <TextBox.Text>
                    <Binding Path="Item.HashTag" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validation:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBox Grid.Row="2" Grid.Column="0" materialDesign:HintAssist.Hint="Главный тренер" TabIndex="5"
                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="10 5 10 5" FontSize="18">
                <TextBox.Text>
                    <Binding Path="Item.MainCoach" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validation:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBox Grid.Row="2" Grid.Column="1" materialDesign:HintAssist.Hint="Представитель команды" TabIndex="6"
                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="10 5 10 5" FontSize="18">
                <TextBox.Text>
                    <Binding Path="Item.Representative" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validation:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBox Grid.Row="3" Grid.Column="0" materialDesign:HintAssist.Hint="Контактный телефон" TabIndex="7"
                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="10 5 10 5" FontSize="18">
                <TextBox.Text>
                    <Binding Path="Item.PhoneNumber" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validation:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>

            <TextBox Grid.Row="3" Grid.Column="1" materialDesign:HintAssist.Hint="E-mail" TabIndex="8"
                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="10 5 10 5" FontSize="18">
                <TextBox.Text>
                    <Binding Path="Item.Email" UpdateSourceTrigger="PropertyChanged" />
                </TextBox.Text>
            </TextBox>

            <TextBox Grid.Row="4" Grid.Column="0" materialDesign:HintAssist.Hint="Страна" TabIndex="9"
                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="10 5 10 5" FontSize="18">
                <TextBox.Text>
                    <Binding Path="Item.Country" UpdateSourceTrigger="PropertyChanged" />
                </TextBox.Text>
            </TextBox>

            <TextBox Grid.Row="4" Grid.Column="1" materialDesign:HintAssist.Hint="Город" TabIndex="10"
                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="10 5 10 5" FontSize="18">
                <TextBox.Text>
                    <Binding Path="Item.City" UpdateSourceTrigger="PropertyChanged" />
                </TextBox.Text>
            </TextBox>

            <TextBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" materialDesign:HintAssist.Hint="Полный адрес" TabIndex="11"
                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}" Margin="10 5 10 5" FontSize="18">
                <TextBox.Text>
                    <Binding Path="Item.FullAddress" UpdateSourceTrigger="PropertyChanged" />
                </TextBox.Text>
            </TextBox>
        </Grid>

        <Grid Grid.Row="3" Height="160">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" FontSize="18">Эмблема команды</TextBlock>
            <Button Grid.Row="0" Grid.Column="1" ToolTip="Указать путь к файлу" Margin="0" Padding="0" Width="22" Height="22" TabIndex="12"
                    Command="{Binding SetEmblemCommand}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="DotsHorizontal" Width="22" Height="22" Margin="0" Padding="0" />
            </Button>

            <Viewbox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Stretch="Uniform" VerticalAlignment="Center">
                <Image Source="{Binding Path=Item.EmblemPath, Converter={StaticResource PathToImageConverter}}" Stretch="UniformToFill" />
            </Viewbox>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0 16 0 0">
            <Button IsDefault="True" Style="{DynamicResource MaterialDesignFlatButton}" TabIndex="13"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                <Button.CommandParameter>
                    <system:Boolean>True</system:Boolean>
                </Button.CommandParameter>
                СОХРАНИТЬ
            </Button>
            <Button IsCancel="True" Margin="8 0 0 0" Style="{DynamicResource MaterialDesignFlatButton}" TabIndex="14"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                <Button.CommandParameter>
                    <system:Boolean>False</system:Boolean>
                </Button.CommandParameter>
                ОТМЕНИТЬ
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
