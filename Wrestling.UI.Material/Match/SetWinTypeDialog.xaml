<UserControl x:Class="Wrestling.UI.Material.Match.SetWinTypeDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:converters2="clr-namespace:Wrestling.UI.Material.Utils.Converters"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" Width="500"
             d:DesignHeight="600" d:DesignWidth="600">

    <UserControl.Resources>
        <converters2:WinTypeToStringConverter x:Key="WinTypeToStringConverter" />
        <converters:UpperCaseConverter x:Key="UpperCaseConverter" />

        <converters:ValueConverterGroup x:Key="UpperWinTypeConverter">
            <converters2:WinTypeToStringConverter />
            <converters:UpperCaseConverter />
        </converters:ValueConverterGroup>
    </UserControl.Resources>
    
    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Margin="10 5 10 0" FontSize="18" TabIndex="12" ItemsSource="{Binding WinTypes}" SelectedItem="{Binding SelectedItem}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource UpperWinTypeConverter}}"
                                TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Style="{StaticResource MaterialDesignHeadlineTextBlock}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 16 0 0">
            <Button IsDefault="True" Style="{DynamicResource MaterialDesignFlatButton}" TabIndex="13"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                <Button.CommandParameter>
                    <system:Boolean>True</system:Boolean>
                </Button.CommandParameter>
                Подтвердить
            </Button>
            <Button IsCancel="True" Margin="8 0 0 0" Style="{DynamicResource MaterialDesignFlatButton}" TabIndex="14"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                <Button.CommandParameter>
                    <system:Boolean>False</system:Boolean>
                </Button.CommandParameter>
                ОТМЕНИТЬ
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
