<UserControl x:Class="Wrestling.UI.Material.Tournament.Results.TeamResults.TeamResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:utils="clr-namespace:Wrestling.UI.Utils;assembly=Wrestling.UI.Utils"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:HighlightSelectedItemConverter x:Key="HighlightSelected" />
        <converters:IndexConverter x:Key="IndexConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,10,20,10">
            <ItemsControl ItemsSource="{Binding Systems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button ToolTip="Выбрать систему расчёта"
                                Content="{Binding Name}"
                                MinWidth="180"
                                Margin="0,0,20,0"
                                Command="{Binding Path=DataContext.ChangeSystemCommand, ElementName=RootControl}"
                                CommandParameter="{Binding}">
                            <Button.Background>
                                <MultiBinding Converter="{StaticResource HighlightSelected}">
                                    <Binding Path="DataContext.SelectedSystem" ElementName="RootControl" />
                                    <Binding Path="." />
                                </MultiBinding>
                            </Button.Background>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Row="0" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource MaterialDesignDivider}" />

        <ListView Grid.Row="1" Margin="20,10,20,20"
                  ItemsSource="{Binding Items}"
                  utils:GridViewSort.AutoSort="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridViewColumn Header="Место" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Converter={StaticResource IndexConverter}, ConverterParameter=1}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Команда" Width="240"
                                    DisplayMemberBinding="{Binding TeamName}"
                                    utils:GridViewSort.PropertyName="TeamName" />

                    <GridViewColumn Header="Город" Width="200"
                                    DisplayMemberBinding="{Binding TeamCity}"
                                    utils:GridViewSort.PropertyName="TeamCity" />

                    <GridViewColumn Header="Золото" Width="100"
                                    utils:GridViewSort.PropertyName="GoldMedals">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GoldMedals}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Серебро" Width="100"
                                    utils:GridViewSort.PropertyName="SilverMedals">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SilverMedals}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Бронза" Width="100"
                                    utils:GridViewSort.PropertyName="BronzeMedals">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BronzeMedals}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Всего медалей" Width="150"
                                    utils:GridViewSort.PropertyName="TotalMedals">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalMedals}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Очки" Width="90"
                                    utils:GridViewSort.PropertyName="TotalPoints">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalPoints}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Категорий" Width="120"
                                    utils:GridViewSort.PropertyName="GroupCount">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GroupCount}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Борцов" Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Wrestlers.Count}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
