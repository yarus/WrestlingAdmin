<model:PanelViewBase x:Class="Wrestling.UI.Material.ScoreScreen.InternationalScoreScreenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters1="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
        xmlns:converters2="clr-namespace:Wrestling.UI.Material.Utils.Converters"
        xmlns:model="clr-namespace:Wrestling.UI.Material.Model"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Icon="../Resources/scoreboard.ico"
        Title="Электронное табло" Height="600" Width="800" Foreground="White" Background="Black" WindowStartupLocation="Manual">

    <model:PanelViewBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters1:UpperCaseConverter x:Key="UpperCaseConverter" />
        <converters2:WarningNumberToRectVisibilityConverter x:Key="WarningVisConverter" />
        <converters2:PathToImageConverter x:Key="ClubToIconConverter" />
        <converters1:BoolToBrushConverter x:Key="BoolHighlight" />

        <converters1:ValueConverterGroup x:Key="InvBoolToVis">
            <converters1:BoolInverterConverter />
            <converters1:GroupedBoolToVisConverter />
        </converters1:ValueConverterGroup>

        <converters1:ValueConverterGroup x:Key="LastNameConverter">
            <converters2:FullNameToLastNameConverter />
            <converters1:UpperCaseConverter />
        </converters1:ValueConverterGroup>

    </model:PanelViewBase.Resources>

    <Border BorderThickness="1" BorderBrush="White">
        <Grid>
            <Grid Visibility="{Binding IsWinnerDialogVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="1" Grid.Column="1" BorderBrush="White" BorderThickness="5" Background="{Binding WinnerColorBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                            
                        <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0">
                            <TextBlock>ПОБЕДИТЕЛЬ!</TextBlock>
                        </Viewbox>
                            
                        <Viewbox Stretch="Uniform" Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="{Binding Winner.LastFirstName, Converter={StaticResource UpperCaseConverter}}"/>
                        </Viewbox>
                            
                        <Viewbox Grid.Row="2" Grid.Column="0" Stretch="Uniform">
                            <Image Source="{Binding Path=WinnerTeamEmblem, Converter={StaticResource ClubToIconConverter}, ConverterParameter=DefaultLogo.png}" Stretch="UniformToFill" />
                        </Viewbox>

                        <Viewbox Grid.Row="3" Grid.Column="0" Stretch="Uniform">
                            <TextBlock Text="{Binding Winner.TeamName, Converter={StaticResource UpperCaseConverter}}"/>
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsUpcomingMatchesVisible, Converter={StaticResource BoolToVis}}">
                <Grid.Background>
                    <ImageBrush ImageSource="{Binding BackgroundPath}" Stretch="UniformToFill" Opacity="{Binding BackgroundOpacity}"/>
                </Grid.Background>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"></RowDefinition>
                    <RowDefinition Height="8*"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Margin="10,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="БЛИЖАЙШИЕ ПОЕДИНКИ"/>
                    </Viewbox>

                    <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="1" Margin="10,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastMatchCarpet.Name, Converter={StaticResource UpperCaseConverter}}"/>
                    </Viewbox>
                </Grid>

                <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="White"></Border>

                <Viewbox Stretch="Uniform" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Margin="10">
                        <ItemsControl ItemsSource="{Binding UpcomingMatches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="2" BorderBrush="White" BorderThickness="1" />

                                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BorderBrush="White" BorderThickness="0,0,1,0" />
                                        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BorderBrush="White" BorderThickness="0,0,1,0" />
                                        <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" BorderBrush="White" BorderThickness="0,0,1,0" />
                                        <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" BorderBrush="White" BorderThickness="0,0,1,0" />
                                        <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" BorderBrush="White" BorderThickness="0,0,0,1" />

                                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Text="{Binding Path=MatchNumber}" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Text="{Binding Path=GroupName}" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                                            <materialDesign:PackIcon Foreground="DarkRed" Margin="0" Padding="0" ToolTip="Спортсмен в красном трико" Kind="CheckboxBlank" />
                                            <TextBlock Text="{Binding Path=WrestlerInRed.LastFirstName}" Foreground="White" TextWrapping="Wrap" HorizontalAlignment="Left" TextAlignment="Left" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                                            <materialDesign:PackIcon Foreground="Blue" Margin="0" Padding="0" ToolTip="Спортсмен в синем трико." Kind="CheckboxBlank" />
                                            <TextBlock Text="{Binding Path=WrestlerInBlue.LastFirstName}" Foreground="White" TextWrapping="Wrap" TextAlignment="Left" HorizontalAlignment="Left" />
                                        </StackPanel>

                                        <TextBlock  Grid.Row="0" Grid.Column="3" Text="{Binding Path=WrestlerInRed.TeamName}" Foreground="White" TextWrapping="NoWrap" TextAlignment="Left" />

                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Path=WrestlerInBlue.TeamName}" Foreground="White" TextWrapping="NoWrap" TextAlignment="Left" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox>

            </Grid>

            <Grid Visibility="{Binding IsMainScreenVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"></RowDefinition>
                    <RowDefinition Height="2*"></RowDefinition>
                    <RowDefinition Height="4*"></RowDefinition>
                    <RowDefinition Height="2*"></RowDefinition>
                    <RowDefinition Height="6*"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Margin="10,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TournamentTitle, Converter={StaticResource UpperCaseConverter}}"/>
                    </Viewbox>

                    <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="1" Margin="10,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CarpetLabel, Converter={StaticResource UpperCaseConverter}}"/>
                    </Viewbox>
                </Grid>

                <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="White"></Border>

                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Margin="10,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GroupLabel, Converter={StaticResource UpperCaseConverter}}"/>
                    </Viewbox>

                    <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="White"></Border>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MatchFullNumber}" Foreground="Black" FontWeight="Bold" />
                    </Viewbox>

                    <Border Grid.Row="0" Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="2" Margin="10,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RoundName, Converter={StaticResource UpperCaseConverter}}"/>
                    </Viewbox>
                </Grid>

                <Border Grid.Row="1" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="White"></Border>

                <Grid Grid.Row="2" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Stretch="UniformToFill" Margin="10" Source="{Binding Wrestler1TeamEmblem, Converter={StaticResource ClubToIconConverter}, ConverterParameter=DefaultLogo.png}" />
                    </Viewbox>

                    <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="1" Margin="10,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>

                            <Viewbox Stretch="Uniform" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock ToolTip="Название команды борца в красном трико" FontSize="18"
                                           Text="{Binding Wrestler1TeamName, Converter={StaticResource UpperCaseConverter}}"/>
                            </Viewbox>
                        </Grid>
                    </Viewbox>

                    <Border Grid.Row="0" Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="White"></Border>
                    
                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="2" Margin="10,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>

                            <Viewbox Stretch="Uniform" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock ToolTip="Название команды борца в синем трико" FontSize="18"
                                           Text="{Binding Wrestler2TeamName, Converter={StaticResource UpperCaseConverter}}"/>
                            </Viewbox>

                        </Grid>
                    </Viewbox>

                    <Border Grid.Row="0" Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Stretch="UniformToFill" Margin="10" Source="{Binding Wrestler2TeamEmblem, Converter={StaticResource ClubToIconConverter}, ConverterParameter=DefaultLogo.png}" />
                    </Viewbox>
                </Grid>

                <Border Grid.Row="2" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="White"></Border>

                <Grid Grid.Row="3" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <Rectangle Grid.Row="0" Grid.Column="0" Fill="Yellow" Visibility="{Binding Wrestler1WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=1}" />

                        <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="Black"></Border>

                        <Rectangle Grid.Row="1" Grid.Column="0" Fill="Yellow" Visibility="{Binding Wrestler1WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=2}" />

                        <Border Grid.Row="1" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="Black"></Border>

                        <Rectangle Grid.Row="2" Grid.Column="0" Fill="Yellow" Visibility="{Binding Wrestler1WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=3}" />

                    </Grid>

                    <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="1" Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Wrestler1, Converter={StaticResource LastNameConverter}}"/>
                    </Viewbox>

                    <Border Grid.Row="0" Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="2" Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Wrestler2, Converter={StaticResource LastNameConverter}}"/>
                    </Viewbox>

                    <Border Grid.Row="0" Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="White"></Border>

                    <Grid Grid.Row="0" Grid.Column="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <Rectangle Grid.Row="0" Grid.Column="0" Fill="Yellow" Visibility="{Binding Wrestler2WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=1}" />

                        <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="Black"></Border>

                        <Rectangle Grid.Row="1" Grid.Column="0" Fill="Yellow" Visibility="{Binding Wrestler2WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=2}" />

                        <Border Grid.Row="1" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="Black"></Border>

                        <Rectangle Grid.Row="2" Grid.Column="0" Fill="Yellow" Visibility="{Binding Wrestler2WarningsNumber, Converter={StaticResource WarningVisConverter}, ConverterParameter=3}" />

                    </Grid>
                </Grid>

                <Border Grid.Row="3" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="White"></Border>

                <Grid Grid.Row="4" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="Red" BorderBrush="White" BorderThickness="0,0,1,0"></Border>

                    <Viewbox Grid.Row="0" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding Points1}"/>
                            <Border BorderBrush="{Binding IsPlayer1WithAdvantage, Converter={StaticResource BoolHighlight}, ConverterParameter=Yellow}" BorderThickness="0,0,0,1" Margin="1" />
                        </Grid>
                    </Viewbox>

                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Column="0" Grid.Row="0" Background="Black" Visibility="{Binding IsTimeout, Converter={StaticResource InvBoolToVis}}" />

                        <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsTimeout, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Foreground="White">
                                <Run Text="РАУНД "/>
                                <Run Text="{Binding Round}"/>
                            </TextBlock>
                        </Viewbox>

                        <Border Grid.Column="0" Grid.Row="0" Background="White" Visibility="{Binding IsTimeout, Converter={StaticResource BoolToVis}}" />

                        <Viewbox Stretch="Uniform" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsTimeout, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ПЕРЕРЫВ" Foreground="Black" FontWeight="Bold" />
                        </Viewbox>

                        <Border Grid.Row="0" Grid.Column="0" BorderBrush="White" BorderThickness="0,0,0,1"></Border>

                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="White"
                                    Visibility="{Binding IsAction1TimerEnabled, Converter={StaticResource BoolToVis}}" />

                            <Viewbox Grid.Row="0" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsAction1TimerEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding TickCounterAction1, StringFormat={}{0:ss}}" Foreground="Black" FontWeight="Bold" />
                            </Viewbox>

                            <Viewbox Grid.Row="0" Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TickCounter, StringFormat={}{0:mm':'ss}}" Foreground="White" />
                            </Viewbox>

                            <Border Grid.Row="0" Grid.Column="2" Background="White"
                                    Visibility="{Binding IsAction2TimerEnabled, Converter={StaticResource BoolToVis}}" />

                            <Viewbox Grid.Row="0" Grid.Column="2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsAction2TimerEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding TickCounterAction2, StringFormat={}{0:ss}}" Foreground="Black" FontWeight="Bold" />
                            </Viewbox>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="0" Grid.Column="2" Background="Blue" BorderBrush="White" BorderThickness="1,0,0,0"></Border>

                    <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{Binding Points2}"/>
                            <Border BorderBrush="{Binding IsPlayer2WithAdvantage, Converter={StaticResource BoolHighlight}, ConverterParameter=Yellow}" BorderThickness="0,0,0,1" Margin="1" />
                        </Grid>
                    </Viewbox>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</model:PanelViewBase>