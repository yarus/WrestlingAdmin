<UserControl x:Class="Wrestling.UI.Material.Tournament.Standing.Applications.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters1="clr-namespace:Wrestling.UI.Material.Utils.Converters"
             xmlns:utils="clr-namespace:Wrestling.UI.Utils;assembly=Wrestling.UI.Utils"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:IndexConverter x:Key="IndexConverter" />
        <converters:IndexItemsConverter x:Key="ItemsIndexConverter" />
        <converters1:PathToImageConverter x:Key="PathToImageConverter" />

        <converters:ValueConverterGroup x:Key="InvBoolToVis">
            <converters:BoolInverterConverter />
            <converters:GroupedBoolToVisConverter />
        </converters:ValueConverterGroup>
    </UserControl.Resources>

    <Grid Margin="0" x:Name="RootControl">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <Button Content="{loc:Loc Applications_NewApp}"
                        ToolTip="{loc:Loc Applications_NewApp_Tooltip}"
                        Width="160"
                        HorizontalAlignment="Left" Margin="20,10,0,10"
                        Command="{Binding AddAppCommand}" />
                <Button Content="{loc:Loc Applications_AutoApprove}"
                        ToolTip="{loc:Loc Applications_AutoApprove_Tooltip}"
                        Width="120"
                        HorizontalAlignment="Left" Margin="10,10,0,10"
                        Command="{Binding ApproveAllCommand}" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                        materialDesign:RippleAssist.IsCentered="True">
                <Grid Margin="20,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border BorderThickness="1" Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="DarkGray" />

                    <Button Grid.Column="0" Style="{DynamicResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="Magnify" Opacity=".56" />
                    </Button>

                    <TextBox Grid.Column="1" Margin="8 0 0 0" materialDesign:HintAssist.Hint="{loc:Loc Applications_SearchHint}"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden" BorderThickness="0"
                             MinWidth="260" VerticalAlignment="Center"
                             Text="{Binding FilterString, UpdateSourceTrigger=PropertyChanged, Delay=1000}" />
                </Grid>
            </StackPanel>

            <CheckBox Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MinWidth="110"
                      Margin="8,0,0,0"
                      IsChecked="{Binding IsOnlyUnapprovedVisible}"
                      Content="{loc:Loc Applications_OnlyUnapproved}" />

            <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal"
                        Margin="20,0,8,0" VerticalAlignment="Center"
                        ToolTip="{loc:Loc Applications_TeamsCount_Tooltip}">
                <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Text="{Binding AppsCount, Mode=OneWay}"
                           FontSize="16" VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal"
                        Margin="8,0,20,0" VerticalAlignment="Center"
                        ToolTip="{loc:Loc Applications_WrestlersCount_Tooltip}">
                <materialDesign:PackIcon Kind="AccountMultiple" Width="20" Height="20"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Text="{Binding WrestlersCount, Mode=OneWay}"
                           FontSize="16" VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </StackPanel>

        </Grid>

        <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Items}">            
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <Border BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer CanContentScroll="False" 
                                      Padding="{TemplateBinding Padding}"
                                      Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Expander Background="{DynamicResource MaterialDesignToolBarBackground}" Margin="0" Padding="0" x:Name="Expander"
                              IsExpanded="{Binding Path=DataContext.ShouldAutoExpand, ElementName=RootControl, Mode=OneWay}">
                        <Expander.Header>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" TextWrapping="NoWrap" FontSize="16"
                                           VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ItemsIndexConverter}"
                                                      ConverterParameter="1">
                                            <Binding
                                                RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ItemsControl}}" />
                                            <Binding Path="." />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <Viewbox Grid.Column="1" Stretch="Uniform" VerticalAlignment="Center">
                                    <Image
                                        Source="{Binding Path=Team.EmblemPath, Converter={StaticResource PathToImageConverter}}"
                                        Stretch="UniformToFill" />
                                </Viewbox>

                                <TextBlock Grid.Column="2" TextWrapping="NoWrap" FontSize="16"
                                           VerticalAlignment="Center" Margin="20,0,0,0">
                                    <Run Text="{Binding Team.ShortName}" />
                                    <Run Text="-" />
                                    <Run Text="{Binding Team.City}" />
                                </TextBlock>

                                <Grid Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="20,0,20,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="1" Foreground="Green" Width="32"
                                                             Height="32" Margin="0" Padding="0"
                                                             ToolTip="{loc:Loc Applications_AppValid_Tooltip}"
                                                             Kind="CheckboxMarkedOutline"
                                                             Visibility="{Binding IsApplicationValid, Converter={StaticResource BoolToVis}}" />
                                    <materialDesign:PackIcon Grid.Column="1" Foreground="DarkRed" Width="32"
                                                             Height="32" Margin="0" Padding="0"
                                                             ToolTip="{loc:Loc Applications_AppInvalid_Tooltip}"
                                                             Kind="CloseBoxOutline"
                                                             Visibility="{Binding IsApplicationValid, Converter={StaticResource InvBoolToVis}}" />
                                </Grid>

                                <Button Grid.Column="4" ToolTip="{loc:Loc Applications_EditApp_Tooltip}" VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Command="{Binding Path=DataContext.EditAppCommand, ElementName=RootControl}"
                                        CommandParameter="{Binding }">
                                    <materialDesign:PackIcon Kind="BorderColor" Width="22" Height="22" Padding="0" />
                                </Button>
                                
                                <Button Grid.Column="5" ToolTip="{loc:Loc Applications_DeleteApp_Tooltip}" VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Command="{Binding Path=DataContext.DeleteAppCommand, ElementName=RootControl}"
                                        CommandParameter="{Binding }" Margin="20,0,0,0">
                                    <materialDesign:PackIcon Kind="Close" Width="22" Height="22" Margin="0"
                                                             Padding="0" />
                                </Button>
                            </Grid>
                        </Expander.Header>
                        <Expander.Content>
                            <StackPanel Margin="0" Visibility="{Binding ElementName=Expander, Path=IsExpanded, Converter={StaticResource BoolToVis}}">
                                <Button Content="{loc:Loc Applications_NewWrestler}" Width="160" HorizontalAlignment="Left"
                                        Margin="20,10,0,10"
                                        ToolTip="{loc:Loc Applications_NewWrestler_Tooltip}"
                                        Command="{Binding Path=DataContext.AddWrestlerCommand, ElementName=RootControl}"
                                        CommandParameter="{Binding }" />
                                <materialDesign:Card Margin="10,0,10,10"
                                                     UniformCornerRadius="4"
                                                     materialDesign:ElevationAssist.Elevation="Dp4">
                                <ListView ItemsSource="{Binding Wrestlers}" x:Name="WrestlersSource"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          HorizontalContentAlignment="Stretch"
                                          TextElement.FontSize="15"
                                          utils:GridViewSort.AutoSort="True">
                                    <ListView.View>
                                        <GridView AllowsColumnReorder="true">
                                            <GridView.ColumnHeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                                    <Setter Property="Padding" Value="4,8,4,8" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="FontSize" Value="14" />
                                                </Style>
                                            </GridView.ColumnHeaderContainerStyle>
                                            <GridViewColumn Header="#" Width="44">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,5,0,0"
                                                                   Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Converter={StaticResource IndexConverter}, ConverterParameter=1}"
                                                                   TextWrapping="NoWrap" FontSize="15"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="{loc:Loc Applications_Column_FullName}" Width="240"
                                                            utils:GridViewSort.PropertyName="FullName">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding FullName}" Margin="0,5,0,0"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   FontSize="15"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Left" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="{loc:Loc Applications_Column_BirthYear}" Width="90" utils:GridViewSort.PropertyName="BirthDate">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding BirthDate, StringFormat={}{0:d}}"
                                                                   Margin="0,5,0,0" TextWrapping="NoWrap"
                                                                   FontSize="15" VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="{loc:Loc Applications_Column_Weight}" Width="60"
                                                            utils:GridViewSort.PropertyName="Weight">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Weight}" Margin="0,5,0,0"
                                                                   TextWrapping="NoWrap" FontSize="15"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="{loc:Loc Applications_Column_Level}" Width="70"
                                                            utils:GridViewSort.PropertyName="Level">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding LevelDisplay}" Margin="0,5,0,0"
                                                                   TextWrapping="NoWrap" FontSize="15"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="{loc:Loc Applications_Column_Group}" Width="180"
                                                            utils:GridViewSort.PropertyName="GroupName">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding GroupName}" Margin="0,5,0,0"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   FontSize="15"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Left" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Header="{loc:Loc Applications_Column_Approval}" Width="110"
                                                            utils:GridViewSort.PropertyName="IsApplicationValid">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top"
                                                              Margin="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                            </Grid.ColumnDefinitions>

                                                            <materialDesign:PackIcon Grid.Column="0"
                                                                                     Foreground="Green" Width="20"
                                                                                     Height="20" Margin="0"
                                                                                     Padding="0"
                                                                                     ToolTip="{loc:Loc Applications_WrestlerValid_Tooltip}"
                                                                                     Kind="AccountCheck"
                                                                                     Visibility="{Binding IsApplicationValid, Converter={StaticResource BoolToVis}}" />
                                                            <materialDesign:PackIcon Grid.Column="0"
                                                                                     Foreground="DarkRed"
                                                                                     Width="20" Height="20"
                                                                                     Margin="0" Padding="0"
                                                                                     ToolTip="{loc:Loc Applications_WrestlerInvalid_Tooltip}"
                                                                                     Kind="AccountAlert"
                                                                                     Visibility="{Binding IsApplicationValid, Converter={StaticResource InvBoolToVis}}" />

                                                            <materialDesign:PackIcon Grid.Column="1" Foreground="Green" Width="20" Height="20" Margin="0" Padding="0" ToolTip="{loc:Loc Applications_WeightApproved_Tooltip}"
                                                                                 Kind="WeightKilogram" Visibility="{Binding IsWeightApproved, Converter={StaticResource BoolToVis}}" />
                                                            <materialDesign:PackIcon Grid.Column="1" Foreground="DarkRed" Width="20" Height="20" Margin="0" Padding="0" ToolTip="{loc:Loc Applications_WeightPending_Tooltip}"
                                                                                 Kind="WeightKilogram" Visibility="{Binding IsWeightApproved, Converter={StaticResource InvBoolToVis}}" />

                                                            <materialDesign:PackIcon Grid.Column="2" Foreground="Green" Width="20" Height="20" Margin="5,0,0,0" Padding="0" ToolTip="{loc:Loc Applications_FeePaid_Tooltip}"
                                                                                 Kind="Cash100" Visibility="{Binding IsEntryFeePaid, Converter={StaticResource BoolToVis}}" />
                                                            <materialDesign:PackIcon Grid.Column="2" Foreground="DarkRed" Width="20" Height="20" Margin="5,0,0,0" Padding="0" ToolTip="{loc:Loc Applications_FeePending_Tooltip}"
                                                                                 Kind="Cash100" Visibility="{Binding IsEntryFeePaid, Converter={StaticResource InvBoolToVis}}" />

                                                            <materialDesign:PackIcon Grid.Column="3" Foreground="Green" Width="20" Height="20" Margin="5,0,0,0" Padding="0" ToolTip="{loc:Loc Applications_RegApproved_Tooltip}"
                                                                                 Kind="CheckboxMarkedOutline" Visibility="{Binding IsRegistrationApproved, Converter={StaticResource BoolToVis}}" />
                                                            <materialDesign:PackIcon Grid.Column="4" Foreground="DarkRed" Width="20" Height="20" Margin="5,0,0,0" Padding="0" ToolTip="{loc:Loc Applications_RegPending_Tooltip}"
                                                                                 Kind="CloseBoxOutline" Visibility="{Binding IsRegistrationApproved, Converter={StaticResource InvBoolToVis}}" />

                                                        </Grid>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="100">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right" Margin="0,0,8,0"
                                                                    Orientation="Horizontal">
                                                            <Button ToolTip="{loc:Loc Applications_EditWrestler_Tooltip}"
                                                                    Margin="0" Padding="0" Width="28" Height="28"
                                                                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                                    Command="{Binding ElementName=RootControl, Path=DataContext.EditWrestlerCommand}"
                                                                    CommandParameter="{Binding }"
                                                                    VerticalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="Pencil"
                                                                                         Width="16" Height="16"
                                                                                         Margin="0" Padding="0" />
                                                            </Button>

                                                            <Button ToolTip="{loc:Loc Applications_DeleteWrestler_Tooltip}"
                                                                    Margin="8,0,0,0" Padding="0" Width="28" Height="28"
                                                                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                                    Command="{Binding ElementName=RootControl, Path=DataContext.DeleteWrestlerCommand}"
                                                                    CommandParameter="{Binding }"
                                                                    VerticalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="Close"
                                                                                         Width="16" Height="16"
                                                                                         Margin="0" Padding="0" />
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>

                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction
                                                Command="{Binding ElementName=RootControl, Path=DataContext.EditWrestlerCommand}"
                                                CommandParameter="{Binding Path=SelectedItem, ElementName=WrestlersSource}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ListView>
                                </materialDesign:Card>
                            </StackPanel>
                        </Expander.Content>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>

</UserControl>