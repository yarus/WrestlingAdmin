<UserControl x:Class="Wrestling.UI.Material.Slider.Slides.VideoSlide.VideoSlideSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:loc="clr-namespace:Wrestling.UI.Utils.Localization;assembly=Wrestling.UI.Utils"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" d:DesignHeight="200" d:DesignWidth="300">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <Grid Row="0" Margin="0 5 0 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" VerticalAlignment="Center" materialDesign:HintAssist.Hint="{loc:Loc Slide_Video_Path}" FontSize="18"
                     Text="{Binding Path=VideoPath, UpdateSourceTrigger=PropertyChanged}" MaxWidth="400" Style="{DynamicResource MaterialDesignFloatingHintTextBox}"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,0,0">
                <Button ToolTip="{loc:Loc Settings_Sound_PickFileTooltip}" Margin="0" Padding="0" Width="22" Height="22"
                        Command="{Binding SetVideoPathCommand}"
                        CommandParameter="{Binding }" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="DotsHorizontal" Width="22" Height="22" Margin="0" Padding="0" />
                </Button>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="1" Grid.Column="0">
            <MediaElement Source="{Binding VideoPath}" Stretch="UniformToFill" LoadedBehavior="Play" MaxWidth="400" />
        </Grid>
    </Grid>
</UserControl>
