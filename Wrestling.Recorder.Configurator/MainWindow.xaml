<Window x:Class="Wrestling.Recorder.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Accord.Controls;assembly=Accord.Controls.Imaging"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:converters="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
        mc:Ignorable="d"
        md:DialogServiceViews.IsRegistered="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="Кофигуратор Видеорегистратора" Height="580" Width="1024" Closing="MainWindow_OnClosing" Loaded="MainWindow_OnLoaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <converters:ValueConverterGroup x:Key="InvBoolToVis">
            <converters:BoolInverterConverter />
            <converters:GroupedBoolToVisConverter />
        </converters:ValueConverterGroup>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock TextWrapping="Wrap" Margin="16 8 16 8" VerticalAlignment="Center">
                    Устройство записи видео
                </TextBlock>

                <ComboBox x:Name="VideoDevicesControl" IsEditable="False" Margin="10 5 10 15"
                          SelectedItem="{Binding SelectedVideoDevice, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding VideoDevices}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock TextWrapping="Wrap" Margin="16 8 16 8" VerticalAlignment="Center">
                    Разрешение устройства записи
                </TextBlock>

                <ComboBox IsEditable="False" Margin="10 5 10 15" SelectedItem="{Binding SelectedResolution, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding VideoResolutions}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Path=Width}"></Run>
                                <Run Text="x"></Run>
                                <Run Text="{Binding Path=Height}"></Run>
                                <Run Text="("></Run>
                                <Run Text="{Binding Path=AverageFrameRate}"></Run>
                                <Run Text="fps )"></Run>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="16 8 16 8" VerticalAlignment="Center">
                        Preset
                    </TextBlock>

                    <ComboBox IsEditable="False" Margin="10 5 10 15" SelectedItem="{Binding SelectedPreset, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding VideoPresets}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="16 8 16 8" VerticalAlignment="Center">
                        VBitrate (4000K..8000K)
                    </TextBlock>

                    <TextBox Margin="10 5 10 15" Text="{Binding SelectedVBitrate}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="16 8 16 8" VerticalAlignment="Center">
                        VQuality (1..30)
                    </TextBlock>

                    <TextBox Margin="10 5 10 15" Text="{Binding SelectedVQuality}" />
                </StackPanel>

                <TextBlock TextWrapping="Wrap" Margin="16 8 16 8" VerticalAlignment="Center">
                    Устройство записи звука
                </TextBlock>

                <ComboBox IsEditable="False" Margin="10 5 10 15" SelectedItem="{Binding SelectedAudioDevice, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding AudioDevices}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="16 8 16 8" VerticalAlignment="Center">
                        ABitrate (40K..96K)
                    </TextBlock>

                    <TextBox Margin="10 5 10 15" Text="{Binding SelectedABitrate}" />
                </StackPanel>
            </StackPanel>
            
            <StackPanel Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="10" Width="80" Height="30" Content="Обновить" Command="{Binding ReloadConfigCommand}"/>

                    <Button Margin="10" Width="80" Height="30" Content="Сохранить" Command="{Binding SaveConfigCommand}"/>

                    <Button Margin="10" Width="80" Height="30" Content="Открыть" Command="{Binding OpenConfigCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Gray">
                <TextBlock TextWrapping="Wrap" Margin="16 8 16 8" VerticalAlignment="Center" 
                           Text="RECORDING..." FontSize="32" Foreground="White" FontWeight="Bold"
                           Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center"/>

                <WindowsFormsHost Margin="10" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                    <controls:VideoSourcePlayer x:Name="VideoSourcePlayer" />
                </WindowsFormsHost>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Left">
                    <Button Margin="10" Width="80" Height="30" Content="Запустить"
                            Visibility="{Binding IsPlaying, Converter={StaticResource InvBoolToVis}}"
                            Command="{Binding StartPlayingCommand}"/>

                    <Button Margin="10" Width="80" Height="30" Content="Остановить"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"
                            Command="{Binding StopCommand}">
                    </Button>
                </Grid>

                <Grid Grid.Column="1" HorizontalAlignment="Right">
                    <Button Margin="10" Width="80" Height="30" Content="Записать"
                            Visibility="{Binding IsRecording, Converter={StaticResource InvBoolToVis}}"
                            Command="{Binding StartRecordingCommand}">
                    </Button>

                    <Button Margin="10" Width="80" Height="30" Content="Проверить"
                            Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}"
                            Command="{Binding StopRecordingCommand}">
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
