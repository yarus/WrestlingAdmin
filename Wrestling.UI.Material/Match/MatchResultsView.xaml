<UserControl x:Class="Wrestling.UI.Material.Match.MatchResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:converters1="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:converters2="clr-namespace:Wrestling.UI.Material.Utils.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Resources>
        <converters2:WinTypeRadioButtonConverter x:Key="WinTypeRadioConverter" />
        <converters1:SecondsToTimeSpanConverter x:Key="SecondsToTimeSpanConverter" />
        <converters2:WinTypeToStringConverter x:Key="WinTypeToStringConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <converters1:ValueConverterGroup x:Key="InvBoolToVis">
            <converters1:BoolInverterConverter />
            <converters1:GroupedBoolToVisConverter />
        </converters1:ValueConverterGroup>
    </UserControl.Resources>

    <Grid x:Name="MainForm" IsEnabled="{Binding IsFormEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="NoWrap" FontSize="18" FontWeight="Normal" Margin="10,20,10,10"> 
            <Run Text="{Binding WrestlingMatch.RoundName, Mode=OneWay}"></Run>
            <Run Text="- Матч №"></Run>
            <Run Text="{Binding WrestlingMatch.MatchNumber, Mode=OneWay}"></Run>
        </TextBlock>
        
        <Grid Grid.Column="0" Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" BorderThickness="0,1,0,0" BorderBrush="Black" />
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" BorderThickness="0,0,0,1" BorderBrush="Black" />
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" BorderThickness="0,0,0,1" BorderBrush="Black" />
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" BorderThickness="0,0,0,1" BorderBrush="Black" />
            
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" BorderThickness="1,0,0,0" BorderBrush="Black" />
            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" BorderThickness="1,0,1,0" BorderBrush="Black" />
            <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" BorderThickness="0,0,1,0" BorderBrush="Black" />
            <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="3" BorderThickness="0,0,1,0" BorderBrush="Black" />
            <Border Grid.Row="0" Grid.Column="4" Grid.RowSpan="3" BorderThickness="0,0,1,0" BorderBrush="Black" />
            <Border Grid.Row="0" Grid.Column="5" Grid.RowSpan="3" BorderThickness="0,0,1,0" BorderBrush="Black" />

            <TextBlock Grid.Row="0" Grid.Column="1" Text="Борцы" Margin="5" HorizontalAlignment="Center" FontSize="16" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Команды" Margin="5" HorizontalAlignment="Center" FontSize="16" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="Баллы" Margin="5" HorizontalAlignment="Center" FontSize="16" />
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Победил" Margin="5" HorizontalAlignment="Center" FontSize="16" />
            <TextBlock Grid.Row="0" Grid.Column="5" Text="Тип победы" Margin="5" HorizontalAlignment="Center" FontSize="16" />

            <Rectangle Grid.Row="1" Grid.Column="0" Width="20" Height="20" Fill="Red" Margin="5" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Path=WrestlingMatch.WrestlerInRed.FullName, Mode=OneWay}" VerticalAlignment="Center" Margin="5" FontSize="16"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Path=WrestlingMatch.WrestlerInRed.TeamName, Mode=OneWay}" VerticalAlignment="Center" Margin="5" FontSize="16"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Path=WrestlingMatch.PointsRed}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" Margin="5" />

            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon Foreground="Red" Width="32" Height="32" Margin="5" Padding="0" 
                                         Kind="CheckboxMarkedOutline" Visibility="{Binding IsWinnerRed, Converter={StaticResource BoolToVis}}" 
                                         ToolTip="Победу одержал борец в красном трико"/>
                <Button Visibility="{Binding Path=IsSetWinnerRedVisible, Converter={StaticResource BoolToVis}}"
                        CommandParameter="Red" Margin="5"
                        Command="{Binding Path=SetWinnerCommand}"
                        ToolTip="Выбрать победителем борца в красном трико">
                    <materialDesign:PackIcon Kind="TrophyOutline" Width="22" Height="22" Padding="0"/>
                </Button>
            </StackPanel>

            <Rectangle Grid.Row="2" Grid.Column="0" Width="20" Height="20" Fill="Blue" Margin="5" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Path=WrestlingMatch.WrestlerInBlue.FullName, Mode=OneWay}" VerticalAlignment="Center" Margin="5" FontSize="16"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Path=WrestlingMatch.WrestlerInBlue.TeamName, Mode=OneWay}" VerticalAlignment="Center" Margin="5" FontSize="16"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Path=WrestlingMatch.PointsBlue}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" Margin="5" />
            <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon Foreground="Blue" Width="32" Height="32" Margin="5" Padding="0" Kind="CheckboxMarkedOutline" 
                                         Visibility="{Binding IsWinnerBlue, Converter={StaticResource BoolToVis}}" 
                                         ToolTip="Победу одержал борец в синем трико"/>
                <Button Visibility="{Binding Path=IsSetWinnerBlueVisible, Converter={StaticResource BoolToVis}}"
                        CommandParameter="Blue" Margin="5"
                        Command="{Binding Path=SetWinnerCommand}"
                        ToolTip="Выбрать победителем борца в синем трико">
                    <materialDesign:PackIcon Kind="TrophyOutline"  Width="22" Height="22" Padding="0" />
                </Button>                
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding WinType, Converter={StaticResource WinTypeToStringConverter}}" Margin="5" FontSize="16" TextWrapping="NoWrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{Binding Path=WrestlingMatch.IsMatchCompleted, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Orientation="Horizontal" Visibility="{Binding Path=WrestlingMatch.IsMatchCompleted, Converter={StaticResource InvBoolToVis}}">
                    <RadioButton Content="Очкам" 
                                 Visibility="{Binding IsPointsWinEnabled, Converter={StaticResource BoolToVis}}"
                                 Margin="5" GroupName="WinType" IsChecked="{Binding Path=WinType, Converter={StaticResource WinTypeRadioConverter}, ConverterParameter=PointsWin}"></RadioButton>
                    <RadioButton Content="Превосходство" 
                                 Visibility="{Binding IsDominationWinEnabled, Converter={StaticResource BoolToVis}}"
                                 Margin="5" GroupName="WinType" IsChecked="{Binding Path=WinType, Converter={StaticResource WinTypeRadioConverter}, ConverterParameter=DominationWin}"></RadioButton>
                    <RadioButton Content="Действие" 
                                 Visibility="{Binding IsActionWinEnabled, Converter={StaticResource BoolToVis}}"
                                 Margin="5" GroupName="WinType" IsChecked="{Binding Path=WinType, Converter={StaticResource WinTypeRadioConverter}, ConverterParameter=ActionWin}"></RadioButton>
                    <RadioButton Content="Туше" 
                                 Visibility="{Binding IsTusheWinEnabled, Converter={StaticResource BoolToVis}}"
                                 Margin="5" GroupName="WinType" IsChecked="{Binding Path=WinType, Converter={StaticResource WinTypeRadioConverter}, ConverterParameter=Tushe}"></RadioButton>
                    <RadioButton Content="Дисквалификация" 
                                 Visibility="{Binding IsTechWinEnabled, Converter={StaticResource BoolToVis}}"
                                 Margin="5" GroupName="WinType" IsChecked="{Binding Path=WinType, Converter={StaticResource WinTypeRadioConverter}, ConverterParameter=DisqualifyWin}"></RadioButton>
                    <RadioButton Content="Автопобеда" 
                                 Visibility="{Binding IsFreeWinEnabled, Converter={StaticResource BoolToVis}}"
                                 Margin="5" GroupName="WinType" IsChecked="{Binding Path=WinType, Converter={StaticResource WinTypeRadioConverter}, ConverterParameter=FreeWin}"></RadioButton>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Grid.Column="0" Margin="10,20,10,10">
            <TextBlock TextWrapping="NoWrap" Text="Заметки" FontWeight="Normal" FontSize="18" Margin="0" />

            <TextBox Padding="0" Margin="0,20,0,0"
                     TextWrapping="Wrap" VerticalAlignment="Top"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     SpellCheck.IsEnabled="True"
                     materialDesign:HintAssist.Hint="Заметки"
                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

        </StackPanel>

        <TextBlock Grid.Row="3" TextWrapping="NoWrap" Text="Протокол" FontSize="18" TextAlignment="Center" FontWeight="Normal" Margin="10,20,10,10" />

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ListView ItemsSource="{Binding Path=WrestlingMatch.MatchActions}" Margin="10">
            <ListView.View>
                <GridView AllowsColumnReorder="true">
                    <GridViewColumn DisplayMemberBinding="{Binding DateTime}" Header="#" Width="Auto"/>
                    <GridViewColumn DisplayMemberBinding="{Binding RoundNumber}" Header="Раунд" Width="Auto"/>
                    <GridViewColumn DisplayMemberBinding="{Binding SecondInRound, StringFormat={}{0:mm':'ss}, Converter={StaticResource SecondsToTimeSpanConverter}}" Header="Время" Width="Auto"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Text}" Header="Детали" Width="Auto"/>
                </GridView>
            </ListView.View>
        </ListView>
        </ScrollViewer>
    </Grid>
</UserControl>