<UserControl x:Class="Wrestling.UI.Material.Slider.Slides.UpcomingMatchesSlide.UpcomingMatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters1="clr-namespace:Wrestling.UI.Utils.Converters;assembly=Wrestling.UI.Utils"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Wrestling.UI.Material.Utils.Converters" Foreground="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters1:UpperCaseConverter x:Key="converter" />
        <converters:BracketCellLineHeightConverter x:Key="BracketCellHeight" />
        <converters:BracketCellLeftLineVisConverter x:Key="LeftLineVis" />
        <converters:BracketColumnTopMarginConverter x:Key="BracketColTopMargin" />
        <converters:BracketRoundVertLineVisibilityConverter x:Key="VertVis" />
        <converters:PathToImageConverter x:Key="PathToImage" />
        <converters:MatchToCarpetConverter x:Key="MatchToCarpet" />
    </UserControl.Resources>

    <UserControl.Background>
        <ImageBrush
            ImageSource="{Binding SliderBackgroundImagePath, Converter={StaticResource PathToImage}, ConverterParameter=SliderLogo.jpg}"
            Stretch="Uniform" Opacity="{Binding SliderOpacity}" />
    </UserControl.Background>

    <Grid x:Name="RootControl">
        <Grid.Background>
            <ImageBrush ImageSource="{Binding BackgroundPath}" Stretch="UniformToFill"
                        Opacity="{Binding BackgroundOpacity}" />
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="8*" />
        </Grid.RowDefinitions>

        <Viewbox Stretch="Uniform" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Margin="10,0,10,0"
                 VerticalAlignment="Center">
            <TextBlock Text="БЛИЖАЙШИЕ ПОЕДИНКИ" />
        </Viewbox>

        <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,0,1" BorderBrush="White" />

        <Viewbox Stretch="Uniform" Grid.Row="1" Grid.Column="0">
            <Grid Margin="10">
                <ItemsControl ItemsSource="{Binding UpcomingMatches}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="1*" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="2"
                                        BorderBrush="White" BorderThickness="1" />

                                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BorderBrush="White"
                                        BorderThickness="0,0,1,0" />
                                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BorderBrush="White"
                                        BorderThickness="0,0,1,0" />
                                <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" BorderBrush="White"
                                        BorderThickness="0,0,1,0" />
                                <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" BorderBrush="White"
                                        BorderThickness="0,0,1,0" />
                                <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" BorderBrush="White"
                                        BorderThickness="0,0,0,1" />

                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                           Text="{Binding Path=MatchNumber}" Foreground="White"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Path=GroupName, Converter={StaticResource converter}}" Foreground="White"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Path=RoundName, Converter={StaticResource converter}}" Foreground="White"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" />

                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,5,0">
                                    <materialDesign:PackIcon Foreground="Red" Margin="0" Padding="0"
                                                             ToolTip="Спортсмен в красном трико" Kind="CheckboxBlank" />
                                    <TextBlock Text="{Binding Path=WrestlerInRed.LastFirstNameShort, Converter={StaticResource converter}}" Foreground="White"
                                               TextWrapping="Wrap" HorizontalAlignment="Left" TextAlignment="Left" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <materialDesign:PackIcon Foreground="#005BEC" Margin="0" Padding="0"
                                                             ToolTip="Спортсмен в синем трико." Kind="CheckboxBlank" />
                                    <TextBlock Text="{Binding Path=WrestlerInBlue.LastFirstNameShort, Converter={StaticResource converter}}" Foreground="White"
                                               TextWrapping="Wrap" TextAlignment="Left" HorizontalAlignment="Left" />
                                </StackPanel>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Path=WrestlerInRed.TeamName, Converter={StaticResource converter}}"
                                           Foreground="White" TextWrapping="NoWrap" TextAlignment="Left" />

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Path=WrestlerInBlue.TeamName, Converter={StaticResource converter}}"
                                           Foreground="White" TextWrapping="NoWrap" TextAlignment="Left" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Viewbox>

    </Grid>
</UserControl>